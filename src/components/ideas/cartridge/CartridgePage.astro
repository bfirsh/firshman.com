---
// One NES cartridge on a CRT: the shared page for every ROM under /ideas. See nes/README.md.
// Props: title, description, rom (a URL, from `import rom from '.../x.nes?url'`).
interface Props { title: string; description: string; rom: string }
const { title, description, rom } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <style is:global>
      :root { color-scheme: dark; }
      html, body { margin: 0; height: 100%; background: #000; overflow: hidden; overscroll-behavior: none; }
      body {
        font: 11px/1.4 ui-monospace, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace;
        color: #c9d2cc;
        -webkit-font-smoothing: antialiased;
        -webkit-tap-highlight-color: transparent;
        user-select: none; -webkit-user-select: none;
      }
      .cart { position: fixed; inset: 0; }
      .cart canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; outline: none; }
      .cart canvas.flat {
        image-rendering: pixelated; image-rendering: crisp-edges;
        inset: auto; transform-origin: 50% 50%;
        border-radius: 2.2% / 2.8%;
        transition: opacity 0.2s;
      }
      .flat .cart::after {
        content: ''; position: absolute; inset: 0; pointer-events: none;
        background: radial-gradient(ellipse at center, transparent 55%, rgba(0, 0, 0, 0.55));
      }

      /* the only words before the set is on */
      .prompt {
        position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
        margin: 0; white-space: nowrap; pointer-events: none;
        font-size: 10.5px; letter-spacing: 0.34em; text-indent: 0.34em; text-transform: lowercase;
        color: rgba(196, 212, 204, 0.42);
        text-shadow: 0 0 10px rgba(170, 210, 195, 0.25);
        opacity: 0; transition: opacity 1.2s ease 0.2s;
      }
      .ready .prompt { opacity: 1; animation: breathe 3.6s ease-in-out 1.4s infinite; }
      .on .prompt { opacity: 0; animation: none; transition: opacity 0.12s; }
      .broken .prompt { animation: none; color: rgba(220, 160, 140, 0.5); }
      .prompt .touch { display: none; }
      @media (hover: none) and (pointer: coarse) {
        .prompt .key { display: none; }
        .prompt .touch { display: inline; }
      }
      @keyframes breathe { 50% { opacity: 0.45; } }
      @media (max-aspect-ratio: 1/1) { .prompt { top: calc(50% + 3.5vh * (1 - 0)); top: 53.5%; } }

      /* near-invisible chrome */
      .chrome { position: fixed; inset: auto 0 0 0; display: flex; justify-content: space-between; align-items: center;
        padding: 0 max(12px, env(safe-area-inset-right)) max(8px, env(safe-area-inset-bottom)) max(12px, env(safe-area-inset-left));
        pointer-events: none; }
      .chrome a, .chrome button {
        pointer-events: auto; color: #d6e0da; opacity: 0.16; transition: opacity 0.5s ease;
        font: inherit; letter-spacing: 0.08em; text-decoration: none; background: none; border: 0; cursor: pointer;
        padding: 8px 6px; line-height: 0;
      }
      .chrome a { line-height: 1; padding: 8px 4px; }
      .chrome a:hover, .chrome button:hover, .chrome a:focus-visible, .chrome button:focus-visible { opacity: 0.85; transition-duration: 0.15s; }
      .chrome :focus-visible { outline: 1px solid rgba(214, 224, 218, 0.5); outline-offset: 1px; border-radius: 2px; }
      .chrome .r { display: none; gap: 2px; }
      .js .chrome .r { display: flex; }
      .chrome svg { width: 14px; height: 14px; display: block; }
      .mute .off, .mute[aria-pressed='true'] .on { display: none; }
      .mute[aria-pressed='true'] .off { display: block; }
      .idle .chrome a:not(:focus-visible), .idle .chrome button:not(:focus-visible) { opacity: 0; transition-duration: 1.4s; }
      .idle, .idle canvas { cursor: none; }
      @media (hover: none) { .chrome a, .chrome button { opacity: 0.22; } }

      .nojs { position: fixed; inset: 0; display: grid; place-items: center; margin: 0; padding: 24px; text-align: center;
        color: rgba(196, 212, 204, 0.5); letter-spacing: 0.06em; }
    </style>
  </head>
  <body>
    <main class="cart" id="cart" data-rom={rom}>
      <canvas aria-label="An NES demo on a television" role="img"></canvas>
      <p class="prompt" aria-live="polite"><span class="key">press any key</span><span class="touch">tap to switch on</span></p>
    </main>
    <nav class="chrome" aria-label="Controls">
      <a href="/ideas">ideas</a>
      <span class="r">
        <button class="mute" type="button" aria-pressed="false" aria-label="Mute">
          <svg class="on" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M2.5 6h2.2L8 3.2v9.6L4.7 10H2.5z" fill="currentColor" stroke="none"/><path d="M10.4 5.6a3.2 3.2 0 0 1 0 4.8M12.2 3.8a5.8 5.8 0 0 1 0 8.4" stroke-linecap="round"/></svg>
          <svg class="off" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M2.5 6h2.2L8 3.2v9.6L4.7 10H2.5z" fill="currentColor" stroke="none"/><path d="M10.5 6l3.5 4M14 6l-3.5 4" stroke-linecap="round"/></svg>
        </button>
        <button class="fs" type="button" aria-label="Full screen">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" aria-hidden="true"><path d="M2.5 6V2.5H6M10 2.5h3.5V6M13.5 10v3.5H10M6 13.5H2.5V10"/></svg>
        </button>
      </span>
    </nav>
    <noscript><p class="nojs">This is an NES demo that runs in your browser. It needs JavaScript.</p></noscript>
    <script>
      import { start } from './player.js';
      start(document.getElementById('cart'));
    </script>
  </body>
</html>
