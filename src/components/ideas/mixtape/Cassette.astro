---
// A C90 drawn in SVG. One face per side; the page flips between them.
interface Props { side: 'A' | 'B' }
const { side } = Astro.props;
const id = (s: string) => `${s}-${side}`;

// rounded-rect path, drawn clockwise or anticlockwise (for holes)
function rr(x: number, y: number, w: number, h: number, r: number, ccw = false) {
  if (!ccw) {
    return `M${x + r},${y} H${x + w - r} A${r},${r} 0 0 1 ${x + w},${y + r} V${y + h - r} A${r},${r} 0 0 1 ${x + w - r},${y + h} H${x + r} A${r},${r} 0 0 1 ${x},${y + h - r} V${y + r} A${r},${r} 0 0 1 ${x + r},${y} Z`;
  }
  return `M${x + r},${y} A${r},${r} 0 0 0 ${x},${y + r} V${y + h - r} A${r},${r} 0 0 0 ${x + r},${y + h} H${x + w - r} A${r},${r} 0 0 0 ${x + w},${y + h - r} V${y + r} A${r},${r} 0 0 0 ${x + w - r},${y} Z`;
}
const label = rr(40, 34, 560, 236, 12);
const win = rr(180, 130, 280, 92, 46, true);
const bands = side === 'A'
  ? ['#f05a28', '#f9a03f', '#f6d365']
  : ['#2a9d8f', '#8ecae6', '#f6d365'];
const teeth = [0, 60, 120, 180, 240, 300];
---
<svg class="tape-svg" viewBox="0 0 640 404" role="img" aria-label={`Cassette tape, side ${side}: Ben's career mix volume 1`}>
  <defs>
    <linearGradient id={id('body')} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#3a3a40" />
      <stop offset="1" stop-color="#1d1d21" />
    </linearGradient>
    <linearGradient id={id('glass')} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity=".16" />
      <stop offset=".45" stop-color="#fff" stop-opacity=".03" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
    <radialGradient id={id('pack')} cx=".5" cy=".5" r=".5">
      <stop offset=".3" stop-color="#7a5236" />
      <stop offset=".96" stop-color="#53331f" />
      <stop offset="1" stop-color="#2a180e" />
    </radialGradient>
    <clipPath id={id('labelClip')}>
      <path d={`${label} ${win}`} clip-rule="evenodd" />
    </clipPath>
    <clipPath id={id('winClip')}>
      <path d={rr(180, 130, 280, 92, 46)} />
    </clipPath>
  </defs>

  <!-- shell -->
  <rect x="4" y="4" width="632" height="396" rx="24" fill={`url(#${id('body')})`} stroke="#0d0d0f" stroke-width="2" />
  <rect x="16" y="16" width="608" height="372" rx="16" fill="none" stroke="#fff" stroke-opacity=".06" />

  <!-- what you see through the window -->
  <g clip-path={`url(#${id('winClip')})`}>
    <rect x="180" y="130" width="280" height="92" fill="#121214" />
    <circle class="pack pack-l" cx="250" cy="176" r="62" fill={`url(#${id('pack')})`} />
    <circle class="pack pack-r" cx="390" cy="176" r="22" fill={`url(#${id('pack')})`} />
  </g>
  {[250, 390].map((cx, n) => (
    <g class={`hub hub-${n ? 'r' : 'l'}`} data-cx={cx} data-cy="176" transform={`rotate(0 ${cx} 176)`}>
      <circle cx={cx} cy="176" r="21" fill="#ecebe6" />
      <circle cx={cx} cy="176" r="13.5" fill="#121214" />
      {teeth.map((a) => (
        <rect x={cx - 2.6} y={176 - 14.5} width="5.2" height="6" rx="1" fill="#ecebe6" transform={`rotate(${a} ${cx} 176)`} />
      ))}
    </g>
  ))}
  <path d={rr(180, 130, 280, 92, 46)} fill={`url(#${id('glass')})`} />
  <!-- window ticks -->
  <g stroke="#fff" stroke-opacity=".35" stroke-width="1.2">
    {[0, 1, 2, 3, 4, 5, 6].map((k) => <line x1={290 + k * 10} y1="210" x2={290 + k * 10} y2={k % 3 === 0 ? 202 : 206} />)}
  </g>

  <!-- the label, with a hole cut for the window -->
  <g clip-path={`url(#${id('labelClip')})`}>
    <rect x="40" y="34" width="560" height="236" fill="#f4eedf" />
    <rect x="40" y="148" width="560" height="22" fill={bands[0]} />
    <rect x="40" y="170" width="560" height="22" fill={bands[1]} />
    <rect x="40" y="192" width="560" height="22" fill={bands[2]} />
    <g stroke="#2b2b2e" stroke-opacity=".22" stroke-width="1">
      <line x1="72" y1="88" x2="572" y2="88" />
      <line x1="72" y1="120" x2="572" y2="120" />
    </g>
  </g>
  <path d={`${label} ${win}`} fill-rule="evenodd" fill="none" stroke="#000" stroke-opacity=".25" />
  <path d={rr(180, 130, 280, 92, 46)} fill="none" stroke="#000" stroke-opacity=".5" stroke-width="3" />

  <text class="marker" x="74" y="80" font-size="34" fill="#1f2a6b" transform="rotate(-1.5 74 80)">BEN'S CAREER MIX</text>
  <text class="marker" x="470" y="80" font-size="22" fill="#c8312b" transform="rotate(-4 470 80)">vol. 1</text>
  <text class="pen" x="78" y="114" font-size="22" fill="#1f2a6b">{side === 'A' ? 'the new stuff (and the middle bit)' : 'from the vaults + bonus sessions'}</text>

  <circle cx="98" cy="181" r="25" fill="#f4eedf" stroke="#2b2b2e" stroke-width="2" />
  <text class="print" x="98" y="192" font-size="32" font-weight="800" text-anchor="middle" fill="#2b2b2e">{side}</text>
  <text class="print" x="542" y="186" font-size="20" font-weight="800" text-anchor="middle" fill="#2b2b2e">C90</text>
  <text class="print" x="62" y="256" font-size="11" letter-spacing="2.5" fill="#2b2b2e" fill-opacity=".7">FIRSHMAN RECORDS · NORMAL BIAS · TYPE I</text>
  <text class="print" x="578" y="256" font-size="11" letter-spacing="2.5" text-anchor="end" fill="#2b2b2e" fill-opacity=".7">STEREO</text>

  <!-- bottom: the bit that goes into the deck -->
  <path d="M146 400 L176 316 H464 L494 400" fill="#2a2a2f" stroke="#0d0d0f" stroke-width="2" />
  <circle cx="226" cy="366" r="9" fill="#0d0d0f" />
  <circle cx="414" cy="366" r="9" fill="#0d0d0f" />
  <rect x="268" y="354" width="14" height="14" rx="2" fill="#0d0d0f" />
  <rect x="358" y="354" width="14" height="14" rx="2" fill="#0d0d0f" />
  <rect x="306" y="380" width="28" height="20" fill="#121214" />
  <path d="M296 400 V392 H344 V400" fill="#5a3a26" />

  {[[34, 34], [606, 34], [34, 370], [606, 370], [320, 336]].map(([x, y]) => (
    <g>
      <circle cx={x} cy={y} r="7.5" fill="#9a9aa0" stroke="#0d0d0f" />
      <path d={`M${x - 4.5} ${y - 1.5} L${x + 4.5} ${y + 1.5}`} stroke="#3a3a40" stroke-width="2" />
    </g>
  ))}
</svg>
