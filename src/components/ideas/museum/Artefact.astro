---
// Little SVG objects for the plinths. 200x200 box, the object rests on y=200.
const { kind } = Astro.props as { kind: string };
const id = `a-${kind}`;

function gearPath(cx: number, cy: number, ro: number, ri: number, teeth: number) {
  const pts: string[] = [];
  const step = (Math.PI * 2) / teeth;
  for (let i = 0; i < teeth; i++) {
    const a = i * step;
    const seq = [
      [ri, a - step * 0.5],
      [ri, a - step * 0.28],
      [ro, a - step * 0.18],
      [ro, a + step * 0.18],
      [ri, a + step * 0.28],
    ];
    for (const [r, ang] of seq) pts.push(`${(cx + r * Math.cos(ang)).toFixed(1)},${(cy + r * Math.sin(ang)).toFixed(1)}`);
  }
  return 'M' + pts.join('L') + 'Z';
}
const vase = 'M-14 0 C-30 -8 -30 -40 -16 -58 C-10 -66 -9 -72 -12 -80 L12 -80 C9 -72 10 -66 16 -58 C30 -40 30 -8 14 0 Z';
---
<svg class={`artefact artefact-${kind}`} viewBox="0 0 200 200" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`${id}-sheen`} x1="0" x2="1">
      <stop offset="0" stop-color="#fff" stop-opacity=".0" />
      <stop offset=".35" stop-color="#fff" stop-opacity=".35" />
      <stop offset=".6" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
    <pattern id={`${id}-ridge`} width="6" height="10" patternUnits="userSpaceOnUse">
      <rect width="6" height="10" fill="none" />
      <rect x="0" width="2" height="10" fill="#000" opacity=".18" />
    </pattern>
  </defs>

  {kind === 'compose' && (
    <g>
      {[
        { x: 10, y: 160, w: 88, c: '#2e6fa3' },
        { x: 102, y: 160, w: 88, c: '#c8442c' },
        { x: 52, y: 120, w: 96, c: '#e0a332' },
      ].map((b) => (
        <g>
          <rect x={b.x} y={b.y} width={b.w} height="38" rx="1.5" fill={b.c} />
          <rect x={b.x} y={b.y} width={b.w} height="38" fill={`url(#${id}-ridge)`} />
          <rect x={b.x} y={b.y} width={b.w} height="4" fill="#000" opacity=".25" />
          <rect x={b.x} y={b.y + 34} width={b.w} height="4" fill="#000" opacity=".3" />
          <rect x={b.x + b.w - 16} y={b.y + 6} width="1.5" height="26" fill="#000" opacity=".4" />
          <rect x={b.x + b.w - 10} y={b.y + 10} width="1.5" height="9" fill="#fff" opacity=".7" />
          <rect x={b.x} y={b.y} width={b.w} height="38" fill={`url(#${id}-sheen)`} />
        </g>
      ))}
      <g transform="translate(118 78) rotate(8)">
        <rect width="44" height="54" fill="#fbf8f0" stroke="#bdb6a6" />
        <text x="5" y="11" font-size="6.5" font-family="monospace" fill="#555">services:</text>
        <text x="9" y="20" font-size="6.5" font-family="monospace" fill="#555">web:</text>
        <text x="13" y="29" font-size="6.5" font-family="monospace" fill="#555">build: .</text>
        <text x="9" y="38" font-size="6.5" font-family="monospace" fill="#555">db:</text>
        <text x="13" y="47" font-size="6.5" font-family="monospace" fill="#555">image: …</text>
      </g>
    </g>
  )}

  {kind === 'machine' && (
    <g>
      <rect x="40" y="96" width="120" height="104" rx="4" fill="#3b3f46" />
      <rect x="40" y="96" width="120" height="104" rx="4" fill={`url(#${id}-sheen)`} />
      {[0, 1, 2].map((r) => (
        <g transform={`translate(48 ${106 + r * 31})`}>
          <rect width="104" height="24" rx="2" fill="#24272c" />
          {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => <rect x={30 + i * 8} y="6" width="4" height="12" rx="1" fill="#15171a" />)}
          <circle class="led" cx="10" cy="12" r="3" fill={r === 1 ? '#f0b429' : '#3ddc84'} style={`animation-delay:${r * 0.37}s`} />
          <circle cx="20" cy="12" r="2" fill="#555" />
        </g>
      ))}
      <path d="M100 96 V70" stroke="#3b3f46" stroke-width="3" />
      <circle cx="100" cy="66" r="5" fill="#c8442c" />
      <path d="M86 58 a20 20 0 0 1 28 0 M80 51 a28 28 0 0 1 40 0" stroke="#c9c2b2" stroke-width="2" fill="none" class="waves" />
    </g>
  )}

  {kind === 'whalebrew' && (
    <g>
      <path d="M88 34 h24 v30 c0 10 22 18 22 40 v86 a10 10 0 0 1 -10 10 h-48 a10 10 0 0 1 -10 -10 v-86 c0 -22 22 -30 22 -40 Z" fill="#4c7a3a" opacity=".92" />
      <path d="M88 34 h24 v30 c0 10 22 18 22 40 v86 a10 10 0 0 1 -10 10 h-48 a10 10 0 0 1 -10 -10 v-86 c0 -22 22 -30 22 -40 Z" fill={`url(#${id}-sheen)`} />
      <rect x="85" y="26" width="30" height="12" rx="2" fill="#c9a227" />
      <rect x="66" y="118" width="68" height="52" fill="#f4eedc" />
      <path d="M78 150 c4 -14 22 -16 36 -12 c6 -6 10 -10 12 -14 c0 6 -2 10 -6 14 c4 2 4 8 -2 12 c-12 6 -32 6 -40 0 Z" fill="#2e6fa3" />
      <circle cx="108" cy="142" r="1.4" fill="#fff" />
      <path d="M94 136 c-1 -6 -1 -8 1 -11 M94 136 c2 -5 4 -7 7 -8" stroke="#2e6fa3" stroke-width="1.4" fill="none" />
      <text x="100" y="166" text-anchor="middle" font-size="7.5" font-family="Georgia, serif" font-style="italic" fill="#333">Whalebrew</text>
    </g>
  )}

  {kind === 'jsnes' && (
    <g transform="rotate(-4 100 140)">
      <path d="M48 80 h104 a6 6 0 0 1 6 6 v108 h-116 v-108 a6 6 0 0 1 6 -6 Z" fill="#8c8a84" />
      <path d="M48 80 h104 a6 6 0 0 1 6 6 v108 h-116 v-108 a6 6 0 0 1 6 -6 Z" fill={`url(#${id}-sheen)`} />
      {[0, 1, 2, 3, 4].map((i) => <rect x="54" y={88 + i * 5} width="92" height="2" fill="#6f6d68" />)}
      <rect x="58" y="118" width="84" height="64" rx="2" fill="#111" />
      <rect x="62" y="122" width="76" height="34" fill="#c8442c" />
      <text x="100" y="146" text-anchor="middle" font-size="16" font-weight="700" font-family="monospace" fill="#fff">JSNES</text>
      <text x="100" y="172" text-anchor="middle" font-size="6" font-family="monospace" fill="#ddd" letter-spacing="1">RUNS IN BROWSER</text>
      <rect x="64" y="188" width="72" height="6" fill="#6f6d68" />
    </g>
  )}

  {kind === 'ukhas' && (
    <g>
      <g class="floaty">
        <ellipse cx="100" cy="58" rx="46" ry="50" fill="#f7f5ef" />
        <ellipse cx="100" cy="58" rx="46" ry="50" fill="none" stroke="#d8d2c4" stroke-width="1" />
        <ellipse cx="84" cy="38" rx="12" ry="16" fill="#fff" />
        <path d="M94 106 h12 l-6 6 z" fill="#e8e3d6" />
        <path d="M100 112 C96 130 104 146 100 162" stroke="#8c8577" stroke-width="1" fill="none" />
      </g>
      <rect x="82" y="162" width="36" height="38" rx="2" fill="#e85d2a" />
      <rect x="82" y="162" width="36" height="38" rx="2" fill={`url(#${id}-sheen)`} />
      <rect x="88" y="172" width="24" height="10" fill="#fff" opacity=".85" />
      <text x="100" y="180" text-anchor="middle" font-size="6" font-family="monospace" fill="#333">CALLSIGN</text>
      <path d="M118 168 l14 -22" stroke="#555" stroke-width="1.5" />
    </g>
  )}

  {kind === 'arxiv' && (
    <g>
      {[0, 1, 2, 3, 4, 5].map((i) => (
        <g transform={`translate(${30 + (i % 2) * 3} ${188 - i * 7}) rotate(${(i % 3) - 1} 50 0)`}>
          <rect width="96" height="7" fill={i % 2 ? '#f6f2e7' : '#fffdf6'} stroke="#cfc8b6" stroke-width=".6" />
        </g>
      ))}
      <g transform="translate(34 76) rotate(-6)">
        <rect width="88" height="76" fill="#fffdf6" stroke="#cfc8b6" stroke-width=".6" />
        <rect x="18" y="8" width="52" height="4" fill="#333" />
        <rect x="28" y="15" width="32" height="2" fill="#888" />
        {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => (
          <g>
            <rect x="8" y={26 + i * 6} width="34" height="1.6" fill="#aaa" />
            <rect x="46" y={26 + i * 6} width="34" height="1.6" fill="#aaa" />
          </g>
        ))}
      </g>
      <g transform="translate(150 96) rotate(14)">
        <rect x="-4" y="40" width="8" height="58" rx="3" fill="#b0892f" />
        <ellipse cx="0" cy="18" rx="24" ry="30" fill="#b0892f" />
        <ellipse cx="0" cy="18" rx="19" ry="25" fill="#cfe3ea" />
        <ellipse cx="0" cy="18" rx="19" ry="25" fill={`url(#${id}-sheen)`} />
        <rect x="-8" y="6" width="16" height="2" fill="#7c97a3" />
        <rect x="-8" y="12" width="12" height="1.5" fill="#7c97a3" />
        <rect x="-8" y="17" width="14" height="1.5" fill="#7c97a3" />
        <rect x="-8" y="22" width="10" height="1.5" fill="#7c97a3" />
      </g>
    </g>
  )}

  {kind === 'django' && (
    <g transform="rotate(-8 100 120)">
      <rect x="95" y="6" width="10" height="20" rx="2" fill="#3b2516" />
      {[0, 1, 2].map((i) => (<><circle cx="93" cy={10 + i * 6} r="1.6" fill="#c9a227" /><circle cx="107" cy={10 + i * 6} r="1.6" fill="#c9a227" /></>))}
      <rect x="96" y="24" width="8" height="78" fill="#4a2f1b" />
      {[0, 1, 2, 3, 4, 5, 6].map((i) => <rect x="96" y={30 + i * 10} width="8" height=".8" fill="#c9c2b2" />)}
      <path d="M100 96 c-26 0 -34 16 -26 30 c4 8 -2 10 -10 18 c-14 14 -6 52 36 52 c42 0 50 -38 36 -52 c-8 -8 -14 -10 -10 -18 c8 -14 0 -30 -26 -30 Z" fill="#a8652a" />
      <path d="M100 96 c-26 0 -34 16 -26 30 c4 8 -2 10 -10 18 c-14 14 -6 52 36 52 c42 0 50 -38 36 -52 c-8 -8 -14 -10 -10 -18 c8 -14 0 -30 -26 -30 Z" fill={`url(#${id}-sheen)`} />
      <ellipse cx="100" cy="140" rx="10" ry="7" fill="#1e140c" />
      <rect x="90" y="174" width="20" height="5" rx="1" fill="#3b2516" />
      {[-3, -1, 1, 3].map((o) => <line x1={100 + o} x2={100 + o} y1="26" y2="176" stroke="#e8e2d2" stroke-width=".5" />)}
    </g>
  )}

  {kind === 'cog' && (
    <g>
      <g class="spin" style="transform-origin: 100px 112px">
        <path d={gearPath(100, 112, 80, 64, 14)} fill="#9aa1a8" />
        <path d={gearPath(100, 112, 80, 64, 14)} fill={`url(#${id}-sheen)`} />
        <circle cx="100" cy="112" r="50" fill="#868d94" />
        <circle cx="100" cy="112" r="22" fill="none" stroke="#6c737a" stroke-width="10" />
        {[0, 1, 2, 3, 4].map((i) => {
          const a = (i / 5) * Math.PI * 2;
          return <circle cx={100 + Math.cos(a) * 38} cy={112 + Math.sin(a) * 38} r="6" fill="#737a81" />;
        })}
        <circle cx="100" cy="112" r="10" fill="#1d1f22" />
      </g>
      <rect x="84" y="190" width="32" height="10" fill="#555" />
    </g>
  )}

  {kind === 'clig' && (
    <g>
      <g transform="translate(60 54)">
        <rect x="-6" y="4" width="92" height="142" rx="3" fill="#0d0d0d" />
        <rect width="86" height="142" rx="3" fill="#1c1c1c" />
        <rect width="86" height="142" rx="3" fill={`url(#${id}-sheen)`} />
        <rect x="0" y="0" width="8" height="142" fill="#000" opacity=".35" />
        <text x="47" y="56" text-anchor="middle" font-size="22" font-family="monospace" fill="#f2f2f2">&gt;_</text>
        <text x="47" y="88" text-anchor="middle" font-size="7.5" font-family="Helvetica, Arial, sans-serif" font-weight="700" fill="#f2f2f2" letter-spacing=".5">COMMAND LINE</text>
        <text x="47" y="98" text-anchor="middle" font-size="7.5" font-family="Helvetica, Arial, sans-serif" font-weight="700" fill="#f2f2f2" letter-spacing=".5">INTERFACE</text>
        <text x="47" y="108" text-anchor="middle" font-size="7.5" font-family="Helvetica, Arial, sans-serif" font-weight="700" fill="#f2f2f2" letter-spacing=".5">GUIDELINES</text>
      </g>
      <rect x="54" y="196" width="98" height="4" fill="#0d0d0d" />
    </g>
  )}

  {kind === 'replicate' && (
    <g>
      {[46, 100, 154].map((x, i) => (
        <g transform={`translate(${x} 198)`}>
          <path d={vase} fill="#e9e4da" stroke="#b9b1a0" stroke-width=".8" />
          <path d={vase} fill={`url(#${id}-sheen)`} />
          <path d="M-22 -36 h44" stroke="#1d1d1d" stroke-width="3" />
          <path d="M-20 -30 h40" stroke="#1d1d1d" stroke-width="1" />
          <text x="0" y="-48" text-anchor="middle" font-size="7" font-family="Georgia, serif" fill="#777" font-style="italic">{['i', 'ii', 'iii'][i]}</text>
        </g>
      ))}
    </g>
  )}

  {kind === 'box' && (
    <g>
      <rect x="55" y="110" width="90" height="90" fill="#c9c2b2" />
      <rect x="55" y="110" width="90" height="90" fill={`url(#${id}-sheen)`} />
      <text x="100" y="164" text-anchor="middle" font-size="30" font-family="Georgia, serif" fill="#666">?</text>
    </g>
  )}
</svg>
