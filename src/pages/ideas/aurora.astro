---
// Aurora: raymarched auroral curtains over a dark, snowy landscape. A new night on every visit.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Ben Firshman</title>
    <meta name="description" content="Ben Firshman works on Replicate. Before that: Cog, Command Line Interface Guidelines, Docker Compose, JSNES and more." />
    <meta name="theme-color" content="#04060b" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <canvas id="sky" aria-hidden="true"></canvas>
    <div class="scrim" aria-hidden="true"></div>

    <main>
      <h1>Ben Firshman</h1>

      <p>I'm working on <a href="https://replicate.com">Replicate</a>. Some other stuff I've done:</p>

      <ul>
        <li><a href="https://github.com/replicate/cog">Cog</a>, containers for machine learning.</li>
        <li><a href="https://clig.dev">Command Line Interface Guidelines</a>, a guide to help you write better command-line programs.</li>
        <li><a href="https://github.com/docker/compose">Docker Compose</a> and <a href="https://github.com/docker/machine">Docker Machine</a>.</li>
        <li><a href="https://github.com/bfirsh/jsnes">JSNES</a>, one of the first JavaScript emulators.</li>
        <li><a href="https://github.com/whalebrew/whalebrew">Whalebrew</a>, a Docker package manager.</li>
        <li><a href="https://www.arxiv-vanity.com/">arXiv Vanity</a>, which rendered papers from arXiv as responsive web pages.</li>
        <li>I worked on <a href="https://gov.uk">GOV.UK</a>, <a href="https://www.youtube.com/watch?v=53ZJdJNsBto">The Guardian's iPad app</a>, <a href="https://www.thisismyjam.com">This Is My Jam</a>, <a href="https://en.wikipedia.org/wiki/Lanyrd">Lanyrd</a>, and <a href="https://spacelog.org">Spacelog</a>.</li>
        <li>I worked on many parts of <a href="https://www.djangoproject.com/">Django</a>, including class-based views, feeds, and search.</li>
        <li>I helped start the <a href="https://ukhas.org.uk/">UK High Altitude Society</a>, a group for amateur near-space exploration.</li>
      </ul>

      <p>Email me at <a href="mailto:ben@firshman.com">ben@firshman.com</a>.<br />
        I'm also on <a href="https://x.com/bfirsh">X</a>, <a href="https://github.com/bfirsh">GitHub</a>, and <a href="https://www.linkedin.com/in/bfirsh/">LinkedIn</a>.</p>
    </main>

    <footer class="mark">
      <button type="button" id="edition" class="edition" hidden></button>
      <a href="/ideas" class="ideas">ideas</a>
    </footer>

    <style>
      :root {
        --ink: #e4e8ea;
        --soft: rgba(228, 232, 234, 0.7);
        --line: rgba(228, 232, 234, 0.32);
        --bg: #04060b;
      }
      * { box-sizing: border-box; }
      html { background: var(--bg); }
      body {
        margin: 0;
        min-height: 100vh;
        min-height: 100svh;
        color: var(--ink);
        font-family: 'Spectral', Georgia, 'Times New Roman', serif;
        font-size: 17px;
        line-height: 1.62;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        overflow-x: hidden;
        /* the page without WebGL: a quiet polar night */
        background:
          radial-gradient(120% 60% at 70% 100%, rgba(40, 120, 92, 0.16), transparent 70%),
          linear-gradient(#03050a 0%, #060a12 62%, #0b1118 78%, #05070b 100%);
        background-attachment: fixed;
      }
      #sky {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
        opacity: 0;
        transition: opacity 2.8s ease;
      }
      #sky.on { opacity: 1; }
      .scrim {
        position: fixed;
        inset: 0;
        pointer-events: none;
        background: linear-gradient(90deg, rgba(3, 5, 9, 0.58) 0%, rgba(3, 5, 9, 0.4) 30%, rgba(3, 5, 9, 0) 56%);
      }
      main {
        position: relative;
        max-width: 31rem;
        padding: clamp(2.5rem, 9vh, 6.5rem) 1.5rem 5rem clamp(1.5rem, 7vw, 7.5rem);
        text-shadow: 0 0 14px rgba(2, 4, 8, 0.75), 0 0 3px rgba(2, 4, 8, 0.6);
      }
      h1 {
        font-weight: 500;
        font-size: 1.62rem;
        letter-spacing: 0.005em;
        line-height: 1.2;
        margin: 0 0 1.4rem;
      }
      p { margin: 0 0 1.1rem; }
      ul { list-style: none; margin: 0 0 1.3rem; padding: 0; }
      li {
        position: relative;
        padding-left: 1.05rem;
        margin: 0 0 0.42rem;
        color: var(--soft);
      }
      li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0.8em;
        width: 0.36rem;
        height: 1px;
        background: var(--line);
      }
      li a { color: var(--ink); }
      a {
        color: inherit;
        text-decoration: underline;
        text-decoration-color: var(--line);
        text-decoration-thickness: 1px;
        text-underline-offset: 0.2em;
        transition: text-decoration-color 0.2s;
      }
      a:hover, a:focus-visible { text-decoration-color: currentColor; }
      a:focus-visible, button:focus-visible { outline: 1px solid var(--soft); outline-offset: 3px; }
      .mark {
        position: fixed;
        right: max(1rem, env(safe-area-inset-right));
        bottom: max(0.8rem, env(safe-area-inset-bottom));
        display: flex;
        gap: 0.9rem;
        align-items: baseline;
        font-size: 11px;
        letter-spacing: 0.06em;
      }
      .edition {
        font: inherit;
        color: var(--ink);
        opacity: 0.38;
        background: none;
        border: 0;
        padding: 0;
        cursor: pointer;
        font-variant-numeric: tabular-nums;
        transition: opacity 0.3s;
      }
      .edition:hover, .edition:focus-visible { opacity: 0.8; }
      .ideas { opacity: 0.14; text-decoration: none; transition: opacity 0.3s; }
      .ideas:hover, .ideas:focus-visible { opacity: 0.8; }
      @media (max-width: 640px) {
        body { font-size: 16px; }
        main { padding: 2.2rem 1.25rem 4.5rem; max-width: none; }
        .scrim { background: linear-gradient(180deg, rgba(3, 5, 9, 0.5) 0%, rgba(3, 5, 9, 0.36) 60%, rgba(3, 5, 9, 0.12) 100%); }
      }
    </style>

    <script>
      import { getSeed, mountEdition } from '../../components/ideas/aurora/edition';
      import { startAurora } from '../../components/ideas/aurora/sky';

      const seed = getSeed();
      mountEdition(document.getElementById('edition') as HTMLButtonElement, seed);
      const canvas = document.getElementById('sky') as HTMLCanvasElement;
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      try {
        const r = startAurora(canvas, seed, { still, onReady: () => canvas.classList.add('on') });
        if (r) (window as any).__aurora = r.params;
        else canvas.remove();
      } catch (e) {
        console.warn(e);
        canvas.remove();
      }
    </script>
  </body>
</html>
