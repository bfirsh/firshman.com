---
import { name, email, now, projects, alsoWorkedOn, socials } from '../../data/bio';
import { LOOKS, ROOMS } from '../../components/ideas/chladni/plate';

const p = Object.fromEntries(projects.map((x) => [x.slug, x]));
const [gov, guardian, jam, lanyrd, spacelog] = alsoWorkedOn;
const x = socials.find((s) => s.name === 'X')!;
const gh = socials.find((s) => s.name === 'GitHub')!;
const li = socials.find((s) => s.name === 'LinkedIn')!;
// room colours per look, so the inline script can paint the page before first render
const rooms = LOOKS.map(([, , r]) => { const m = ROOMS[r]; return [m.a, m.b, m.ink, m.dim, m.light ? 1 : 0]; });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ben Firshman</title>
    <meta name="description" content="Ben Firshman is working on Replicate. Previously Docker Compose, Cog, JSNES, arXiv Vanity and more." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />
    <script is:inline define:vars={{ rooms }}>
      (function () {
        var q = new URLSearchParams(location.search);
        var seed = parseInt(q.get('seed') || '', 10);
        if (!(seed > 0)) seed = 1 + Math.floor(Math.random() * 99999);
        var a = seed;
        a |= 0; a = (a + 0x6d2b79f5) | 0;
        var t = Math.imul(a ^ (a >>> 15), 1 | a);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        var r = ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        var c = rooms[Math.floor(r * rooms.length)];
        var s = document.documentElement.style;
        s.setProperty('--bg-a', c[0]); s.setProperty('--bg-b', c[1]); s.setProperty('--ink', c[2]); s.setProperty('--dim', c[3]);
        document.documentElement.dataset.seed = String(seed);
        if (c[4]) document.documentElement.classList.add('light');
      })();
    </script>
  </head>
  <body>
    <canvas id="plate-canvas" aria-hidden="true"></canvas>
    <div class="page">
      <main>
        <h1>{name}</h1>

        <p>I'm working on <a href={now.url}>{now.name}</a>. Some other stuff I've done:</p>

        <ul>
          <li><a href={p.cog.url}>{p.cog.name}</a>, {p.cog.blurb}.</li>
          <li><a href={p.clig.url}>{p.clig.name}</a>, {p.clig.blurb}.</li>
          <li><a href={p.compose.url}>{p.compose.name}</a> and <a href={p.machine.url}>{p.machine.name}</a>.</li>
          <li><a href={p.jsnes.url}>{p.jsnes.name}</a>, {p.jsnes.blurb}.</li>
          <li><a href={p.whalebrew.url}>{p.whalebrew.name}</a>, {p.whalebrew.blurb}.</li>
          <li><a href={p['arxiv-vanity'].url}>{p['arxiv-vanity'].name}</a>, which {p['arxiv-vanity'].blurb}.</li>
          <li>I worked on <a href={gov.url}>{gov.name}</a>, <a href={guardian.url}>{guardian.name}</a>, <a href={jam.url}>{jam.name}</a>, <a href={lanyrd.url}>{lanyrd.name}</a>, and <a href={spacelog.url}>{spacelog.name}</a>.</li>
          <li>I worked on many parts of <a href={p.django.url}>{p.django.name}</a>, including class-based views, feeds, and search.</li>
          <li>I helped start the <a href={p.ukhas.url}>{p.ukhas.name}</a>, a group for amateur near-space exploration.</li>
        </ul>

        <p>Email me at <a href={`mailto:${email}`}>{email}</a>.<br />
          I'm also on <a href={x.url}>{x.name}</a>, <a href={gh.url}>{gh.name}</a>, and <a href={li.url}>{li.name}</a>.</p>
      </main>
      <div class="slot" id="slot" aria-hidden="true"></div>
    </div>
    <footer class="edition">
      <button type="button" id="sound" aria-pressed="false" hidden>sound off</button>
      <button type="button" id="edition" title="Copy a link to this edition" hidden></button>
      <a href="/ideas">ideas</a>
    </footer>

    <script>
      import { start } from '../../components/ideas/chladni/plate';

      const seed = +(document.documentElement.dataset.seed || 1);
      const btn = document.getElementById('edition') as HTMLButtonElement;
      const label = `No. ${seed}`;
      btn.textContent = label;
      btn.hidden = false;
      btn.addEventListener('click', async () => {
        const url = `${location.origin}${location.pathname}?seed=${seed}`;
        try { await navigator.clipboard.writeText(url); btn.textContent = 'copied'; }
        catch { history.replaceState(null, '', `?seed=${seed}`); btn.textContent = 'link in address bar'; }
        setTimeout(() => (btn.textContent = label), 1400);
      });

      // An opt-in pure sine at the plate's current resonance. Off until asked for.
      let ctx: AudioContext | null = null, osc: OscillatorNode | null = null, gain: GainNode | null = null;
      let hz = 220, on = false;
      const toHz = (k: number) => 38 * k; // k ∝ √(plate frequency)
      const sound = document.getElementById('sound') as HTMLButtonElement;
      function setTone() {
        if (!ctx || !osc) return;
        osc.frequency.setTargetAtTime(hz, ctx.currentTime, 0.9);
      }
      sound.addEventListener('click', () => {
        on = !on;
        sound.textContent = on ? 'sound on' : 'sound off';
        sound.setAttribute('aria-pressed', String(on));
        if (on && !ctx) {
          ctx = new AudioContext();
          osc = ctx.createOscillator(); osc.type = 'sine'; osc.frequency.value = hz;
          gain = ctx.createGain(); gain.gain.value = 0;
          osc.connect(gain).connect(ctx.destination); osc.start();
        }
        if (ctx && gain) {
          if (on) ctx.resume();
          gain.gain.setTargetAtTime(on ? 0.045 : 0, ctx.currentTime, 0.4);
        }
      });

      const canvas = document.getElementById('plate-canvas') as HTMLCanvasElement;
      try {
        const r = start(canvas, document.getElementById('slot')!, seed, (k) => { hz = toHz(k); setTone(); });
        if (r) {
          requestAnimationFrame(() => canvas.classList.add('on'));
          sound.hidden = false;
        }
      } catch (e) {
        console.warn('chladni: no WebGL2', e);
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg-a: #1a1918;
    --bg-b: #0c0c0c;
    --ink: #ece6da;
    --dim: #a39e94;
    color-scheme: dark;
  }
  :root.light { color-scheme: light; }
  * { box-sizing: border-box; }
  html { background: var(--bg-b); }
  body {
    margin: 0;
    position: relative;
    min-height: 100vh;
    background: radial-gradient(120% 90% at 65% 40%, var(--bg-a), var(--bg-b));
    color: var(--ink);
    font-family: 'EB Garamond', Garamond, 'Iowan Old Style', Georgia, serif;
    font-size: 19px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    font-variant-numeric: oldstyle-nums;
    overflow-x: hidden;
  }
  #plate-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 1.6s ease;
  }
  #plate-canvas.on { opacity: 1; }
  .page {
    position: relative;
    min-height: 100vh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(32px, 5vw, 96px);
    padding: 48px clamp(28px, 6vw, 110px);
    max-width: 1500px;
    margin: 0 auto;
  }
  main { max-width: 27rem; justify-self: end; }
  .slot {
    width: min(82vh, 50vw, 780px);
    aspect-ratio: 1;
  }
  h1 {
    font-size: 2.1rem;
    font-weight: 500;
    letter-spacing: 0.005em;
    line-height: 1.1;
    margin: 0 0 1.3rem;
  }
  p { margin: 0 0 1rem; }
  ul { list-style: none; margin: 0 0 1.2rem; padding: 0; }
  li { margin: 0 0 0.45rem; padding-left: 1.1em; text-indent: -1.1em; }
  li::before { content: '–'; display: inline-block; width: 1.1em; text-indent: 0; color: var(--dim); }
  a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--ink) 35%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    transition: text-decoration-color 0.2s;
  }
  a:hover, a:focus-visible { text-decoration-color: var(--ink); }
  li, main > p { color: color-mix(in srgb, var(--ink) 88%, var(--dim)); }
  .edition {
    position: fixed;
    right: 18px;
    bottom: 12px;
    display: flex;
    gap: 14px;
    align-items: baseline;
    font-size: 13px;
    letter-spacing: 0.03em;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .edition button, .edition a {
    font: inherit;
    color: var(--ink);
    background: none;
    border: 0;
    padding: 4px 0;
    cursor: pointer;
    text-decoration: none;
    opacity: 0.4;
    transition: opacity 0.3s;
  }
  .edition a, .edition #sound { opacity: 0.16; }
  .edition #sound[aria-pressed='true'] { opacity: 0.5; }
  .edition button:hover, .edition button:focus-visible, .edition a:hover, .edition a:focus-visible { opacity: 0.9; }
  @media (max-width: 760px) {
    body { font-size: 18px; }
    .page { display: flex; flex-direction: column-reverse; align-items: stretch; gap: 28px; padding: 22px 22px 72px; }
    .slot { width: 100%; }
    .edition { position: absolute; bottom: 14px; right: 22px; }
    main { max-width: none; justify-self: auto; }
    h1 { font-size: 1.9rem; }
  }
</style>
