---
import { projects, now, email, socials, alsoWorkedOn, name } from '../../data/bio';

const P = Object.fromEntries(projects.map((p) => [p.slug, p]));
const host = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

type Side = 'l' | 'r' | 't' | 'b';
type N = { id: string; x: number; y: number; star?: string; lab?: Side };
type Shape = { id: string; name: string; latin: string; abbr: string; nodes: N[]; edges: [string, string][]; label: [number, number] };

// Constellation shapes in their own local coordinates. `star` marks a project.
const shapes: Shape[] = [
  {
    id: 'container', name: 'The Container', latin: 'Continens', abbr: 'Cnt',
    nodes: [
      { id: 't1', x: 0, y: 0 }, { id: 't2', x: -15, y: 70 }, { id: 't3', x: 40, y: 42 },
      { id: 'compose', x: 120, y: 8, star: 'compose', lab: 't' },
      { id: 'machine', x: 220, y: 22, star: 'machine', lab: 'r' },
      { id: 'cog', x: 252, y: 92, star: 'cog', lab: 'r' },
      { id: 'whalebrew', x: 140, y: 122, star: 'whalebrew', lab: 'b' },
      { id: 'b1', x: 68, y: 100 }, { id: 's1', x: 196, y: -42 }, { id: 's2', x: 176, y: -58 }, { id: 's3', x: 222, y: -56 },
    ],
    edges: [['t1', 't3'], ['t2', 't3'], ['t3', 'compose'], ['compose', 'machine'], ['machine', 'cog'], ['cog', 'whalebrew'], ['whalebrew', 'b1'], ['b1', 't3'], ['machine', 's1'], ['s1', 's2'], ['s1', 's3']],
    label: [110, 172],
  },
  {
    id: 'python', name: 'The Python', latin: 'Serpens Pythonis', abbr: 'Pyt',
    nodes: [
      { id: 'p1', x: 0, y: 40 }, { id: 'p2', x: 42, y: 0 }, { id: 'p3', x: 92, y: 22 },
      { id: 'django', x: 128, y: 72, star: 'django', lab: 'b' },
      { id: 'p4', x: 182, y: 90 }, { id: 'p5', x: 228, y: 58 }, { id: 'p6', x: 262, y: 72 }, { id: 'p7', x: 246, y: 96 },
    ],
    edges: [['p1', 'p2'], ['p2', 'p3'], ['p3', 'django'], ['django', 'p4'], ['p4', 'p5'], ['p5', 'p6'], ['p6', 'p7'], ['p7', 'p5']],
    label: [40, 82],
  },
  {
    id: 'balloon', name: 'The Balloon', latin: 'Aerostatum', abbr: 'Bal',
    nodes: [
      { id: 'b1', x: 0, y: -52 }, { id: 'b2', x: 38, y: -30 }, { id: 'b3', x: 40, y: 12 },
      { id: 'ukhas', x: 0, y: 46, star: 'ukhas', lab: 'l' },
      { id: 'b5', x: -40, y: 12 }, { id: 'b6', x: -38, y: -30 }, { id: 'st', x: 8, y: 92 }, { id: 'pl', x: 0, y: 122 },
    ],
    edges: [['b1', 'b2'], ['b2', 'b3'], ['b3', 'ukhas'], ['ukhas', 'b5'], ['b5', 'b6'], ['b6', 'b1'], ['ukhas', 'st'], ['st', 'pl']],
    label: [0, 150],
  },
  {
    id: 'joypad', name: 'The Joypad', latin: 'Ludus', abbr: 'Lud',
    nodes: [
      { id: 'j1', x: 0, y: 0 }, { id: 'j2', x: 170, y: 0 }, { id: 'j3', x: 182, y: 70 }, { id: 'j4', x: -12, y: 70 },
      { id: 'dp', x: 36, y: 36 }, { id: 'jsnes', x: 128, y: 30, star: 'jsnes', lab: 't' }, { id: 'j5', x: 150, y: 46 },
    ],
    edges: [['j1', 'j2'], ['j2', 'j3'], ['j3', 'j4'], ['j4', 'j1'], ['jsnes', 'j5']],
    label: [85, 100],
  },
  {
    id: 'scroll', name: 'The Scroll', latin: 'Volumen', abbr: 'Vol',
    nodes: [
      { id: 'c1', x: 0, y: 12 }, { id: 'clig', x: 44, y: 0, star: 'clig', lab: 't' }, { id: 'c2', x: 132, y: 2 },
      { id: 'arxiv-vanity', x: 204, y: 14, star: 'arxiv-vanity', lab: 't' }, { id: 'c3', x: 214, y: 62 }, { id: 'c4', x: 172, y: 72 },
      { id: 'c5', x: 80, y: 70 }, { id: 'c6', x: -10, y: 60 },
    ],
    edges: [['c1', 'clig'], ['clig', 'c2'], ['c2', 'arxiv-vanity'], ['arxiv-vanity', 'c3'], ['c3', 'c4'], ['c4', 'c5'], ['c5', 'c6'], ['c6', 'c1']],
    label: [102, 100],
  },
];
const sisters = [[0, 0], [20, -12], [36, 6], [14, 20], [-14, 14]];

type Layout = { w: number; h: number; pole: [number, number]; at: Record<string, [number, number, number]>; sisters: [number, number, number]; rings: number[] };
const layouts: Record<'wide' | 'tall', Layout> = {
  wide: {
    w: 1000, h: 640, pole: [500, 70], rings: [130, 260, 390, 520, 650, 780],
    at: { container: [118, 262, 1], python: [612, 318, 1], balloon: [858, 168, .9], joypad: [430, 478, 1], scroll: [118, 500, 1] },
    sisters: [790, 540, 1.3],
  },
  tall: {
    w: 390, h: 990, pole: [195, 70], rings: [110, 220, 330, 440, 550, 660, 770, 880],
    at: { container: [46, 330, .95], python: [86, 552, .95], balloon: [300, 168, .8], joypad: [46, 718, .9], scroll: [108, 872, .82] },
    sisters: [282, 744, 1.15],
  },
};

const greek = ['α', 'β', 'γ', 'δ'];
// Catalogue: one designation per project, BF-1 is the pole star.
const catalogue: { slug: string; desig: string; bayer: string; c: string; mag: string }[] = [
  { slug: 'replicate', desig: 'BF-1', bayer: 'α UMi*', c: 'Pole star', mag: '−1.5' },
];
let n = 2;
const mags = ['1.2', '2.0', '2.4', '3.1', '1.8', '2.7', '3.3', '2.2', '1.6'];
for (const s of shapes) {
  s.nodes.filter((x) => x.star).forEach((x, i) => {
    catalogue.push({ slug: x.star!, desig: `BF-${n}`, bayer: `${greek[i]} ${s.abbr}`, c: s.name, mag: mags[(n - 2) % mags.length] });
    n++;
  });
}
const cat = Object.fromEntries(catalogue.map((c) => [c.slug, c]));

// Mock celestial coordinates derived from the wide layout's polar projection.
function coords(x: number, y: number) {
  const [px, py] = layouts.wide.pole;
  const dx = x - px, dy = y - py;
  const r = Math.hypot(dx, dy);
  const dec = Math.round(90 - r / 8);
  let ang = (Math.atan2(dx, dy) * 180) / Math.PI; if (ang < 0) ang += 360;
  const ra = ang / 15;
  const h = Math.floor(ra), m = Math.round((ra - h) * 60);
  return `RA ${String(h).padStart(2, '0')}h ${String(m).padStart(2, '0')}m · Dec +${dec}°`;
}

function build(L: Layout) {
  return shapes.map((s) => {
    const [ox, oy, k] = L.at[s.id];
    const nodes = s.nodes.map((nd) => ({ ...nd, X: ox + nd.x * k, Y: oy + nd.y * k }));
    const byId = Object.fromEntries(nodes.map((nd) => [nd.id, nd]));
    const lines = s.edges.map(([a, b]) => ({ x1: byId[a].X, y1: byId[a].Y, x2: byId[b].X, y2: byId[b].Y }));
    return { ...s, nodes, lines, LX: ox + s.label[0] * k, LY: oy + s.label[1] * k };
  });
}

const star = (slug: string) => {
  if (slug === 'replicate') return { name: now.name, url: now.url, blurb: now.blurb };
  return P[slug];
};

// Data for the callout, keyed by star slug (positions taken from the wide layout).
const wideBuilt = build(layouts.wide);
const info: Record<string, any> = {
  replicate: { ...cat.replicate, name: now.name, url: now.url, host: host(now.url), blurb: `Now: ${now.blurb}. The fixed point everything else turns around.`, coords: 'RA 00h 00m · Dec +90°', c: 'The pole star' },
};
for (const s of wideBuilt) for (const nd of s.nodes) if (nd.star) {
  const p = P[nd.star];
  info[nd.star] = { ...cat[nd.star], name: p.name, url: p.url, host: host(p.url), blurb: p.blurb, coords: coords(nd.X, nd.Y), c: s.name };
}
info.sisters = {
  desig: 'BF-C1', bayer: 'open cluster', c: 'The Five Sisters', name: 'The Five Sisters', mag: '4.5',
  coords: coords(layouts.wide.sisters[0], layouts.wide.sisters[1]), blurb: 'A loose cluster of things also worked on.',
  links: alsoWorkedOn.map((a) => ({ name: a.name, url: a.url })),
};

const labelPos = (side: Side | undefined, X: number, Y: number, big = false) => {
  const d = big ? 14 : 10;
  switch (side) {
    case 'l': return { x: X - d, y: Y + 4, a: 'end' };
    case 't': return { x: X, y: Y - d - 2, a: 'middle' };
    case 'b': return { x: X, y: Y + d + 10, a: 'middle' };
    default: return { x: X + d, y: Y + 4, a: 'start' };
  }
};

const charts = (Object.keys(layouts) as ('wide' | 'tall')[]).map((key) => {
  const L = layouts[key];
  return { key, L, built: build(L) };
});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ben Firshman — Night sky</title>
    <meta name="description" content="Ben Firshman's projects charted as a night sky: every project a star, grouped into constellations, with Replicate as the pole star." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Cormorant+SC:wght@400;500&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <canvas class="sky" id="sky" aria-hidden="true"></canvas>

    <header class="masthead">
      <a class="home" href="/ideas">← all ideas</a>
      <p class="plate">Uranographia Firshmaniana · Plate I</p>
      <h1>{name}</h1>
      <p class="lede">A chart of the known projects. Hover or tap a star to trace its constellation.</p>
      <a class="to-cat" href="#catalogue">Star catalogue ↓</a>
    </header>

    <main>
      <div class="chart-wrap" id="chartWrap">
        {charts.map(({ key, L, built }) => (
          <svg class={`chart chart-${key}`} viewBox={`0 0 ${L.w} ${L.h}`} role="group" aria-label="Star chart of Ben Firshman's projects">
            <defs>
              <clipPath id={`clip-${key}`}><rect x="6" y="6" width={L.w - 12} height={L.h - 12} /></clipPath>
              <radialGradient id={`halo-${key}`}>
                <stop offset="0" stop-color="#fff6dc" stop-opacity=".9" />
                <stop offset=".25" stop-color="#ffe7a8" stop-opacity=".35" />
                <stop offset="1" stop-color="#ffe7a8" stop-opacity="0" />
              </radialGradient>
            </defs>

            <g class="grid" clip-path={`url(#clip-${key})`} aria-hidden="true">
              {L.rings.map((r) => <circle cx={L.pole[0]} cy={L.pole[1]} r={r} />)}
              {Array.from({ length: 12 }, (_, i) => {
                const a = (i * 30 * Math.PI) / 180;
                return <line x1={L.pole[0] + Math.sin(a) * 26} y1={L.pole[1] + Math.cos(a) * 26} x2={L.pole[0] + Math.sin(a) * 2000} y2={L.pole[1] + Math.cos(a) * 2000} />;
              })}
              {L.rings.slice(0, 3).map((r, i) => (
                <text class="grid-t" x={L.pole[0] + 4} y={L.pole[1] + r - 4}>+{80 - i * 15}°</text>
              ))}
              {Array.from({ length: 12 }, (_, i) => {
                const a = (i * 30 * Math.PI) / 180;
                const rr = L.rings[3] - 14;
                const x = L.pole[0] + Math.sin(a) * rr, y = L.pole[1] + Math.cos(a) * rr;
                return i !== 0 && x > 20 && x < L.w - 20 && y > 20 && y < L.h - 20 ? <text class="grid-t" x={x} y={y} text-anchor="middle">{i * 2}h</text> : null;
              })}
            </g>
            <rect class="frame" x="6" y="6" width={L.w - 12} height={L.h - 12} aria-hidden="true" />
            <rect class="ticks" x="6" y="6" width={L.w - 12} height={L.h - 12} aria-hidden="true" />

            {built.map((s) => (
              <g class="const" data-c={s.id}>
                <g class="lines" aria-hidden="true">
                  {s.lines.map((l, i) => (
                    <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} pathLength="1" style={`--i:${i}`} />
                  ))}
                </g>
                <text class="cname" x={s.LX} y={s.LY} text-anchor="middle" aria-hidden="true">{s.name}<tspan class="latin" x={s.LX} dy="14">{s.latin}</tspan></text>
                {s.nodes.filter((nd) => !nd.star).map((nd, i) => (
                  <circle class="faint" cx={nd.X} cy={nd.Y} r={1.3 + ((i * 7) % 3) * 0.35} aria-hidden="true" />
                ))}
                {s.nodes.filter((nd) => nd.star).map((nd) => {
                  const p = star(nd.star!);
                  const lp = labelPos(nd.lab, nd.X, nd.Y);
                  return (
                    <a class="star" href={p.url} data-star={nd.star} data-c={s.id} aria-label={`${p.name}: ${p.blurb}`}>
                      <circle class="hit" cx={nd.X} cy={nd.Y} r="18" />
                      <circle class="halo" cx={nd.X} cy={nd.Y} r="14" fill={`url(#halo-${key})`} />
                      <circle class="core" cx={nd.X} cy={nd.Y} r="3.2" />
                      <text class="slabel" x={lp.x} y={lp.y} text-anchor={lp.a}>{p.name.length > 22 ? p.name.replace('Command Line Interface Guidelines', 'CLI Guidelines') : p.name}</text>
                    </a>
                  );
                })}
              </g>
            ))}

            <g class="const" data-c="sisters">
              <circle class="ring" cx={L.sisters[0] + 10 * L.sisters[2]} cy={L.sisters[1] + 3 * L.sisters[2]} r={34 * L.sisters[2]} pathLength="1" aria-hidden="true" />
              {alsoWorkedOn.map((a, i) => (
                <a class="star sister" href={a.url} data-star="sisters" data-c="sisters" aria-label={`Also worked on: ${a.name}`}>
                  <circle class="hit" cx={L.sisters[0] + sisters[i][0] * L.sisters[2]} cy={L.sisters[1] + sisters[i][1] * L.sisters[2]} r="10" />
                  <circle class="core" cx={L.sisters[0] + sisters[i][0] * L.sisters[2]} cy={L.sisters[1] + sisters[i][1] * L.sisters[2]} r="2" />
                </a>
              ))}
              <text class="cname" x={L.sisters[0] + 10 * L.sisters[2]} y={L.sisters[1] + 54 * L.sisters[2]} text-anchor="middle" aria-hidden="true">The Five Sisters<tspan class="latin" x={L.sisters[0] + 10 * L.sisters[2]} dy="14">also worked on</tspan></text>
            </g>

            <a class="star pole" href={now.url} data-star="replicate" data-c="pole" aria-label={`Now: ${now.name}, ${now.blurb}`}>
              <circle class="hit" cx={L.pole[0]} cy={L.pole[1]} r="26" />
              <circle class="halo" cx={L.pole[0]} cy={L.pole[1]} r="30" fill={`url(#halo-${key})`} />
              <path class="spikes" d={`M${L.pole[0]} ${L.pole[1] - 24}V${L.pole[1] + 24}M${L.pole[0] - 24} ${L.pole[1]}H${L.pole[0] + 24}`} />
              <circle class="core" cx={L.pole[0]} cy={L.pole[1]} r="5" />
              <text class="slabel big" x={L.pole[0] + 16} y={L.pole[1] - 10}>{now.name}</text>
              <text class="slabel tiny" x={L.pole[0] + 17} y={L.pole[1] + 10}>pole star · now</text>
            </a>
          </svg>
        ))}

        <aside class="callout" id="callout" hidden aria-live="polite">
          <button class="close" type="button" aria-label="Close">×</button>
          <p class="c-desig"></p>
          <h2 class="c-name"></h2>
          <p class="c-blurb"></p>
          <p class="c-coords"></p>
          <p class="c-link"></p>
        </aside>

        <button class="shooting" id="shooting" type="button" hidden aria-label="A shooting star. Catch it for Ben's email address.">
          <span class="tail"></span><span class="head"></span>
        </button>
      </div>

      <div class="wish" id="wish" hidden role="status">
        <button class="close" type="button" aria-label="Close">×</button>
        <span class="wish-k">You caught a shooting star.</span>
        Make a wish: <a href={`mailto:${email}`}>{email}</a>
      </div>

      <section class="catalogue" id="catalogue" aria-labelledby="cat-h">
        <h2 id="cat-h">Star catalogue</h2>
        <p class="cat-sub">Positions approximate. Magnitudes invented. Catch a shooting star for the email, or just read it below.</p>
        <table>
          <thead>
            <tr><th scope="col">Desig.</th><th scope="col">Name</th><th scope="col">Constellation</th><th scope="col" class="num">Mag.</th><th scope="col">Notes</th></tr>
          </thead>
          <tbody>
            {catalogue.map((c) => {
              const p = star(c.slug);
              return (
                <tr>
                  <td class="desig">{c.desig}<span>{c.bayer}</span></td>
                  <td class="nm"><a href={p.url}>{p.name}</a></td>
                  <td class="cn">{c.c}</td>
                  <td class="num">{c.mag}</td>
                  <td class="notes">{p.blurb}</td>
                </tr>
              );
            })}
            {alsoWorkedOn.map((a, i) => (
              <tr class="minor">
                <td class="desig">BF-C1<span>{String.fromCharCode(97 + i)}</span></td>
                <td class="nm"><a href={a.url}>{a.name}</a></td>
                <td class="cn">The Five Sisters</td>
                <td class="num">4.5</td>
                <td class="notes">also worked on</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="corr">
          <span class="sc">Correspondence</span>
          <a href={`mailto:${email}`}>{email}</a>
          {socials.map((s) => <a href={s.url}>{s.name}</a>)}
        </p>
        <p class="footnote">* Not actually Polaris.</p>
      </section>
    </main>

    <script type="application/json" id="starinfo" set:html={JSON.stringify(info)} />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --ink: #e9e1cb;
    --muted: #8f8b80;
    --gold: #f3d27a;
    --line: rgba(233, 225, 203, .85);
    --bg0: #0b1226;
    --bg1: #04060f;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; }
  body {
    background: radial-gradient(140% 90% at 50% 0%, #121c3a 0%, var(--bg0) 35%, var(--bg1) 100%) fixed, var(--bg1);
    color: var(--ink);
    font-family: "Cormorant Garamond", Garamond, "Times New Roman", serif;
    font-weight: 400;
    overflow-x: hidden;
    min-height: 100vh;
  }
  a { color: inherit; }
  .sky { position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; }
  main, .masthead { position: relative; z-index: 1; }

  .masthead { position: absolute; left: clamp(28px, 4.4vw, 72px); top: clamp(24px, 3.6vw, 52px); max-width: 360px; z-index: 3; }
  .home { font: 500 14px/1 "Cormorant SC", serif; letter-spacing: .12em; color: var(--muted); text-decoration: none; }
  .home:hover { color: var(--ink); }
  .plate { margin: 18px 0 0; font: 400 13px/1 "Cormorant SC", serif; letter-spacing: .22em; color: var(--muted); }
  h1 { margin: 6px 0 6px; font-weight: 300; font-size: clamp(40px, 4.4vw, 64px); line-height: .95; letter-spacing: .01em; }
  .lede { margin: 0; font-style: italic; font-size: 18px; line-height: 1.3; color: #c9c1ab; max-width: 30ch; }
  .to-cat { display: inline-block; margin-top: 12px; font: 500 14px/1 "Cormorant SC", serif; letter-spacing: .14em; color: var(--gold); text-decoration: none; border-bottom: 1px solid rgba(243,210,122,.4); padding-bottom: 3px; }

  .chart-wrap { position: relative; width: min(100%, 152vh); margin: 0 auto; }
  .chart { display: block; width: 100%; height: auto; overflow: visible; }
  .chart-tall { display: none; }

  .grid circle, .grid line { fill: none; stroke: rgba(190, 200, 240, .10); stroke-width: .7; }
  .grid-t { fill: rgba(190, 200, 240, .32); font: italic 400 11px "Cormorant Garamond", serif; }
  .frame { fill: none; stroke: rgba(233,225,203,.35); stroke-width: .8; }
  .ticks { fill: none; stroke: rgba(233,225,203,.25); stroke-width: 6; stroke-dasharray: .8 9.2; }

  .lines line {
    stroke: var(--line); stroke-width: 1; stroke-linecap: round;
    stroke-dasharray: 1; stroke-dashoffset: 0; opacity: .32;
  }
  .js .lines line { opacity: .1; stroke-dasharray: .015 .02; stroke: #c9d2ff; }
  .js .const.on .lines line {
    opacity: 1; stroke: var(--gold); stroke-dasharray: 1;
    animation: draw .7s cubic-bezier(.5,0,.3,1) both; animation-delay: calc(var(--i) * 70ms);
  }
  @keyframes draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }

  .cname { fill: rgba(233,225,203,.38); font: 500 13px "Cormorant SC", serif; letter-spacing: .28em; transition: fill .4s; }
  .cname .latin { font: italic 400 12px "Cormorant Garamond", serif; letter-spacing: .04em; }
  .const.on .cname { fill: var(--gold); }
  .faint { fill: #dfe5ff; opacity: .6; }
  .const.on .faint { opacity: 1; }

  .star { cursor: pointer; outline: none; }
  .star .hit { fill: transparent; }
  .star .core { fill: #fffaf0; }
  .star .halo { opacity: .8; transition: opacity .3s, r .3s; }
  .star .slabel { fill: var(--ink); font: 400 14.5px "Cormorant Garamond", serif; letter-spacing: .02em; paint-order: stroke; stroke: rgba(4,6,15,.85); stroke-width: 3px; }
  .star:hover .slabel, .star:focus-visible .slabel, .star.sel .slabel { fill: var(--gold); }
  .star:hover .halo, .star:focus-visible .halo, .star.sel .halo { opacity: 1; r: 22; }
  .star:focus-visible .core { stroke: var(--gold); stroke-width: 6; stroke-opacity: .4; }
  .sister .core { fill: #cfe0ff; }
  .ring { fill: none; stroke: var(--gold); stroke-width: .8; stroke-dasharray: 1; stroke-dashoffset: 1; opacity: 0; }
  .const.on .ring { opacity: .7; animation: draw .9s ease both; }

  .pole .core { fill: #fff; }
  .pole .spikes { stroke: #fff6dc; stroke-width: 1; opacity: .7; }
  .pole .slabel.big { font-size: 22px; font-style: italic; }
  .pole .slabel.tiny { font: 400 11px "Cormorant SC", serif; letter-spacing: .2em; fill: var(--muted); }
  @media (prefers-reduced-motion: no-preference) {
    .pole .halo { animation: pulse 4s ease-in-out infinite; transform-origin: center; transform-box: fill-box; }
  }
  @keyframes pulse { 50% { opacity: .55; transform: scale(.85); } }

  /* callout */
  .callout {
    position: absolute; z-index: 5; width: 290px; padding: 16px 18px 14px;
    background: rgba(8, 12, 28, .88); backdrop-filter: blur(6px);
    border: 1px solid rgba(233,225,203,.3); outline: 1px solid rgba(233,225,203,.12); outline-offset: 3px;
    color: var(--ink);
  }
  .callout[hidden] { display: none; }
  .callout p, .callout h2 { margin: 0; }
  .c-desig { font: 500 12px/1.2 "Cormorant SC", serif; letter-spacing: .2em; color: var(--gold); }
  .c-name { font: italic 400 28px/1.05 "Cormorant Garamond", serif; margin: 4px 0 6px !important; }
  .c-blurb { font-size: 17px; line-height: 1.25; }
  .c-coords { margin-top: 8px !important; font: 400 12px/1.3 "Cormorant SC", serif; letter-spacing: .12em; color: var(--muted); }
  .c-link { margin-top: 10px !important; font-size: 17px; display: flex; flex-wrap: wrap; gap: 4px 14px; }
  .c-link a { color: var(--gold); text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .close { position: absolute; right: 6px; top: 4px; background: none; border: 0; color: var(--muted); font: 300 22px/1 "Cormorant Garamond", serif; cursor: pointer; padding: 4px 8px; }
  .close:hover { color: var(--ink); }

  /* shooting star */
  .shooting {
    position: absolute; left: 0; top: 0; z-index: 4; width: 170px; height: 44px; padding: 0; border: 0; background: none; cursor: pointer;
    transform-origin: 100% 50%;
  }
  .shooting[hidden] { display: none; }
  .shooting .tail { position: absolute; right: 6px; top: 50%; width: 160px; height: 2px; margin-top: -1px; background: linear-gradient(90deg, transparent, rgba(255,246,220,.9)); border-radius: 2px; }
  .shooting .head { position: absolute; right: 2px; top: 50%; width: 7px; height: 7px; margin-top: -3.5px; border-radius: 50%; background: #fff; box-shadow: 0 0 10px 3px rgba(255,240,200,.8); }

  .wish {
    position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%); z-index: 20;
    padding: 14px 44px 14px 20px; max-width: calc(100vw - 32px);
    background: rgba(8,12,28,.94); border: 1px solid rgba(243,210,122,.5);
    font-size: 19px; text-align: center;
  }
  .wish[hidden] { display: none; }
  .wish-k { display: block; font: 500 12px/1.4 "Cormorant SC", serif; letter-spacing: .2em; color: var(--muted); }
  .wish a { color: var(--gold); font-style: italic; }

  /* catalogue */
  .catalogue { max-width: 980px; margin: 40px auto 0; padding: 0 20px 80px; }
  .catalogue h2 { font: 300 40px/1 "Cormorant Garamond", serif; margin: 0 0 6px; border-top: 1px solid rgba(233,225,203,.3); padding-top: 28px; }
  .cat-sub { margin: 0 0 18px; font-style: italic; color: var(--muted); font-size: 17px; }
  table { width: 100%; border-collapse: collapse; font-size: 17px; }
  th { font: 500 12px "Cormorant SC", serif; letter-spacing: .2em; color: var(--muted); text-align: left; padding: 8px 10px 8px 0; border-bottom: 1px solid rgba(233,225,203,.35); }
  td { padding: 8px 10px 8px 0; border-bottom: 1px solid rgba(233,225,203,.1); vertical-align: baseline; }
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  .desig { font: 500 14px "Cormorant SC", serif; letter-spacing: .1em; white-space: nowrap; color: var(--gold); }
  .desig span { display: block; font: italic 400 13px "Cormorant Garamond", serif; letter-spacing: 0; color: var(--muted); }
  .nm a { font-size: 19px; text-decoration-thickness: 1px; text-underline-offset: 3px; text-decoration-color: rgba(233,225,203,.35); }
  .nm a:hover { color: var(--gold); text-decoration-color: currentColor; }
  .cn { font-style: italic; color: #c9c1ab; }
  .notes { color: #c9c1ab; }
  tr.minor .nm a { font-size: 17px; }
  .corr { margin: 28px 0 0; display: flex; flex-wrap: wrap; gap: 6px 18px; align-items: baseline; font-size: 19px; }
  .corr .sc { font: 500 12px "Cormorant SC", serif; letter-spacing: .2em; color: var(--muted); }
  .corr a { text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .corr a:hover { color: var(--gold); }
  .footnote { margin: 18px 0 0; font-style: italic; font-size: 14px; color: var(--muted); }

  @media (max-width: 760px) {
    .masthead { position: relative; left: auto; top: auto; padding: 18px 16px 6px; max-width: none; }
    .chart-wide { display: none; }
    .chart-tall { display: block; }
    .chart-wrap { width: 100%; }
    .callout { position: fixed; left: 12px !important; right: 12px; bottom: 12px; top: auto !important; width: auto; }
    .catalogue { padding: 0 16px 64px; }
    thead { display: none; }
    table, tbody, tr, td { display: block; }
    tr { display: grid; grid-template-columns: 4.6em 1fr auto; column-gap: 10px; padding: 10px 0; border-bottom: 1px solid rgba(233,225,203,.12); }
    td { border: 0; padding: 0; }
    .desig { grid-row: 1 / 3; }
    .cn { grid-column: 2; grid-row: 2; font-size: 15px; }
    .num { grid-column: 3; grid-row: 1; color: var(--muted); }
    .notes { grid-column: 2 / 4; font-size: 15px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .js .const.on .lines line, .const.on .ring { animation: none; }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const info = JSON.parse(document.getElementById('starinfo')!.textContent || '{}');
  const wrap = document.getElementById('chartWrap') as HTMLElement;
  const callout = document.getElementById('callout') as HTMLElement;
  const small = matchMedia('(max-width: 760px)');

  /* ---------- background: twinkling stars turning slowly round the pole ---------- */
  const canvas = document.getElementById('sky') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  type S = { r: number; a: number; size: number; b: number; tw: number; ph: number; hue: number };
  let stars: S[] = [];
  let W = 0, H = 0, dpr = 1;
  function rand(seed: number) { let s = seed; return () => ((s = (s * 16807) % 2147483647) - 1) / 2147483646; }
  function resize() {
    dpr = Math.min(2, window.devicePixelRatio || 1);
    W = innerWidth; H = innerHeight;
    canvas.width = W * dpr; canvas.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const R = rand(42);
    const count = Math.round((W * H) / 2600);
    const maxR = Math.hypot(W, H * 2.2);
    stars = Array.from({ length: count }, () => {
      const size = R() < 0.92 ? 0.4 + R() * 0.8 : 1.2 + R() * 1.1;
      return { r: Math.sqrt(R()) * maxR, a: R() * Math.PI * 2, size, b: 0.25 + R() * 0.75, tw: 0.6 + R() * 2.2, ph: R() * 6.28, hue: R() };
    });
  }
  function poleScreen() {
    const pole = document.querySelector<SVGElement>(small.matches ? '.chart-tall .pole .core' : '.chart-wide .pole .core');
    if (!pole) return { x: W / 2, y: 60 };
    const r = pole.getBoundingClientRect();
    // Background moves at 60% of scroll speed: a little parallax.
    return { x: r.left + r.width / 2, y: r.top + r.height / 2 + window.scrollY * 0.4 };
  }
  let mx = 0, my = 0, tmx = 0, tmy = 0;
  addEventListener('pointermove', (e) => { tmx = (e.clientX / W - 0.5) * -14; tmy = (e.clientY / H - 0.5) * -10; }, { passive: true });
  function draw(t: number) {
    ctx.clearRect(0, 0, W, H);
    const p = poleScreen();
    mx += (tmx - mx) * 0.05; my += (tmy - my) * 0.05;
    const rot = reduce ? 0 : (t / 1000) * ((Math.PI * 2) / 900); // one turn every 15 minutes
    for (const s of stars) {
      const a = s.a + rot;
      const x = p.x + Math.cos(a) * s.r + mx * (s.size / 2);
      const y = p.y + Math.sin(a) * s.r + my * (s.size / 2);
      if (x < -4 || y < -4 || x > W + 4 || y > H + 4) continue;
      const tw = reduce ? 1 : 0.65 + 0.35 * Math.sin(t / 1000 * s.tw + s.ph);
      ctx.globalAlpha = s.b * tw;
      ctx.fillStyle = s.hue < 0.15 ? '#ffd9b0' : s.hue > 0.85 ? '#cfe0ff' : '#fffaf0';
      if (s.size < 1) ctx.fillRect(x, y, s.size * 1.4, s.size * 1.4);
      else { ctx.beginPath(); ctx.arc(x, y, s.size, 0, Math.PI * 2); ctx.fill(); }
    }
    ctx.globalAlpha = 1;
  }
  resize();
  addEventListener('resize', () => { resize(); if (reduce) draw(0); });
  if (reduce) { draw(0); addEventListener('scroll', () => draw(0), { passive: true }); }
  else { const loop = (t: number) => { draw(t); requestAnimationFrame(loop); }; requestAnimationFrame(loop); }

  /* ---------- hover a star: trace the constellation + star-chart callout ---------- */
  let selected: SVGAElement | null = null;
  function esc(s: string) { return s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!)); }
  function select(a: SVGAElement | null) {
    document.querySelectorAll('.const.on').forEach((g) => g.classList.remove('on'));
    document.querySelectorAll('.star.sel').forEach((g) => g.classList.remove('sel'));
    selected = a;
    if (!a) { callout.hidden = true; return; }
    const key = a.dataset.star!;
    const c = a.dataset.c!;
    a.closest('svg')!.querySelectorAll(`.const[data-c="${c}"]`).forEach((g) => {
      g.classList.remove('on'); void (g as SVGGElement).getBoundingClientRect(); g.classList.add('on');
    });
    a.classList.add('sel');
    const d = info[key];
    callout.querySelector('.c-desig')!.textContent = `${d.desig} · ${d.bayer} · mag ${d.mag}`;
    callout.querySelector('.c-name')!.textContent = d.name;
    callout.querySelector('.c-blurb')!.textContent = d.blurb.charAt(0).toUpperCase() + d.blurb.slice(1) + (d.blurb.endsWith('.') ? '' : '.');
    callout.querySelector('.c-coords')!.textContent = `${d.c} · ${d.coords}`;
    callout.querySelector('.c-link')!.innerHTML = d.links
      ? d.links.map((l: any) => `<a href="${esc(l.url)}">${esc(l.name)}</a>`).join('')
      : `<a href="${esc(d.url)}">${esc(d.host)} →</a>`;
    callout.hidden = false;
    if (!small.matches) {
      const wr = wrap.getBoundingClientRect();
      const core = a.querySelector('.core')!.getBoundingClientRect();
      const x = core.left + core.width / 2 - wr.left, y = core.top + core.height / 2 - wr.top;
      const cw = callout.offsetWidth, ch = callout.offsetHeight;
      // Sit beside the whole constellation, so the label never hides the lines being traced.
      const group = a.closest('.const') || a;
      const gb = group.getBoundingClientRect();
      const gl = gb.left - wr.left, gr = gb.right - wr.left;
      let left = gr + 24;
      if (left + cw > wr.width - 12) left = gl - 24 - cw;
      if (left < 12) left = x + 26 + cw < wr.width - 12 ? x + 26 : x - 26 - cw;
      let top = y - ch / 2;
      top = Math.max(12, Math.min(top, wr.height - ch - 12));
      callout.style.left = left + 'px';
      callout.style.top = top + 'px';
    }
  }
  let lastPointer = 'mouse';
  let lastDown = 0;
  document.querySelectorAll<SVGAElement>('.star').forEach((a) => {
    a.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') select(a); });
    a.addEventListener('focus', () => { if (Date.now() - lastDown > 600) select(a); });
    a.addEventListener('pointerdown', (e) => { lastPointer = e.pointerType; lastDown = Date.now(); });
    a.addEventListener('click', (e) => {
      // On touch, the first tap shows the chart label; the link inside it navigates.
      if (lastPointer !== 'mouse' && selected !== a) { e.preventDefault(); select(a); }
    });
  });
  callout.querySelector('.close')!.addEventListener('click', () => select(null));
  addEventListener('keydown', (e) => { if (e.key === 'Escape') select(null); });
  document.addEventListener('pointerdown', (e) => {
    const t = e.target as Element;
    if (!t.closest('.star') && !t.closest('.callout') && !t.closest('.shooting')) select(null);
  });

  /* ---------- the occasional shooting star (catch it for the email) ---------- */
  const shoot = document.getElementById('shooting') as HTMLButtonElement;
  const wish = document.getElementById('wish') as HTMLElement;
  let anim: Animation | null = null;
  function launch() {
    if (document.hidden) return schedule();
    const w = wrap.clientWidth, h = Math.min(wrap.clientHeight, innerHeight);
    const x0 = w * (0.35 + Math.random() * 0.6), y0 = h * (0.05 + Math.random() * 0.2);
    const ang = (150 + Math.random() * 25) * Math.PI / 180; // heading down-left
    const dist = Math.min(w, 900) * (0.45 + Math.random() * 0.2);
    const x1 = x0 + Math.cos(ang) * dist, y1 = y0 + Math.sin(ang) * dist;
    const deg = ang * 180 / Math.PI;
    shoot.hidden = false;
    // The button's right edge (the head) leads; offset so the head sits on the path.
    const ox = -shoot.offsetWidth, oy = -shoot.offsetHeight / 2;
    anim = shoot.animate(
      [
        { transform: `translate(${x0 + ox}px, ${y0 + oy}px) rotate(${deg}deg) scaleX(.2)`, opacity: 0 },
        { opacity: 1, offset: .15 },
        { opacity: 1, offset: .8 },
        { transform: `translate(${x1 + ox}px, ${y1 + oy}px) rotate(${deg}deg) scaleX(1)`, opacity: 0 },
      ],
      { duration: 2600, easing: 'cubic-bezier(.3,.1,.6,1)', fill: 'forwards' },
    );
    anim.onfinish = () => { shoot.hidden = true; schedule(); };
  }
  function schedule(ms = 6000 + Math.random() * 9000) { setTimeout(launch, ms); }
  shoot.addEventListener('click', () => {
    anim?.pause();
    shoot.animate([{ filter: 'brightness(1)' }, { filter: 'brightness(3) drop-shadow(0 0 12px #fff)' }, { opacity: 0 }], { duration: 500, fill: 'forwards' })
      .onfinish = () => { anim?.cancel(); shoot.hidden = true; schedule(12000); };
    wish.hidden = false;
    (wish.querySelector('a') as HTMLElement).focus({ preventScroll: true } as FocusOptions);
  });
  wish.querySelector('.close')!.addEventListener('click', () => { wish.hidden = true; });
  if (!reduce) schedule(2500);
</script>
