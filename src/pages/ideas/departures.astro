---
import { projects, now, email, socials, alsoWorkedOn, name } from '../../data/bio';

const p = Object.fromEntries(projects.map((x) => [x.slug, x]));
const W = { time: 5, flight: 5, dest: 16, gate: 2, status: 13 };
type Row = { time: string; flight: string; dest: string; gate: string; status: string; url?: string; blurb?: string; label?: string; tone?: string; now?: boolean };

const departures: Row[] = [
  { time: 'NOW', flight: 'BF100', dest: 'REPLICATE', gate: 'R1', status: 'NOW BOARDING', url: now.url, label: now.name, blurb: now.blurb, tone: 'now', now: true },
  { time: '17:45', flight: 'BF101', dest: 'COG', gate: 'C2', status: '→ REPLICATE', url: p.cog.url, label: p.cog.name, blurb: p.cog.blurb, tone: 'go' },
  { time: '16:30', flight: 'BF102', dest: 'CLI GUIDELINES', gate: 'C4', status: 'IN FLIGHT', url: p.clig.url, label: p.clig.name, blurb: p.clig.blurb, tone: 'go' },
  { time: '14:05', flight: 'BF201', dest: 'DOCKER COMPOSE', gate: 'D1', status: 'IN FLIGHT', url: p.compose.url, label: p.compose.name, blurb: `${p.compose.blurb} (née Fig)`, tone: 'go' },
  { time: '13:50', flight: 'BF202', dest: 'DOCKER MACHINE', gate: 'D2', status: 'LANDED', url: p.machine.url, label: p.machine.name, blurb: p.machine.blurb },
  { time: '13:15', flight: 'BF203', dest: 'WHALEBREW', gate: 'W8', status: 'DEPARTED', url: p.whalebrew.url, label: p.whalebrew.name, blurb: p.whalebrew.blurb },
  { time: '12:40', flight: 'BF204', dest: 'ARXIV VANITY', gate: 'A4', status: 'LANDED', url: p['arxiv-vanity'].url, label: p['arxiv-vanity'].name, blurb: p['arxiv-vanity'].blurb },
  { time: '09:10', flight: 'BF301', dest: 'DJANGO', gate: 'P3', status: 'DEPARTED', url: p.django.url, label: p.django.name, blurb: p.django.blurb },
  { time: '08:08', flight: 'BF302', dest: 'JSNES', gate: 'N8', status: 'DEPARTED', url: p.jsnes.url, label: p.jsnes.name, blurb: p.jsnes.blurb },
  { time: '06:00', flight: 'BF303', dest: 'UK HIGH ALTITUDE', gate: 'U1', status: 'EDGE OF SPACE', url: p.ukhas.url, label: p.ukhas.name, blurb: p.ukhas.blurb, tone: 'sky' },
  ...alsoWorkedOn.map((a, n): Row => ({
    time: ['11:00', '10:30', '10:05', '09:45', '09:30'][n],
    flight: `CS${401 + n}`,
    dest: ['GOV.UK', 'GUARDIAN IPAD', 'THIS IS MY JAM', 'LANYRD', 'SPACELOG'][n],
    gate: `S${n + 1}`,
    status: 'CODESHARE',
    url: a.url, label: a.name, blurb: 'worked on it, with lots of other people', tone: 'dim',
  })),
];

const xHandle = socials.find((s) => s.name === 'X');
const gh = socials.find((s) => s.name === 'GitHub');
const li = socials.find((s) => s.name === 'LinkedIn');
const arrivals: Row[] = [
  { time: 'ANY', flight: 'MAIL', dest: email.toUpperCase(), gate: 'E1', status: 'EXPECTED', url: `mailto:${email}`, label: `Email ${email}`, blurb: 'write any time', tone: 'now' },
  { time: 'ANY', flight: 'X', dest: `X ${xHandle!.handle.toUpperCase()}`, gate: 'X1', status: 'ON TIME', url: xHandle!.url, label: `X ${xHandle!.handle}`, blurb: 'follow along', tone: 'go' },
  { time: 'ANY', flight: 'GH', dest: `GITHUB ${gh!.handle.toUpperCase()}`, gate: 'G1', status: 'MERGING', url: gh!.url, label: `GitHub ${gh!.handle}`, blurb: 'pull requests welcome', tone: 'go' },
  { time: 'ANY', flight: 'LI', dest: `LINKEDIN ${li!.handle.toUpperCase()}`, gate: 'L1', status: 'CONNECTING', url: li!.url, label: `LinkedIn ${li!.handle}`, blurb: 'connecting flights available', tone: 'go' },
  { time: 'ANY', flight: 'PGP', dest: 'PGP KEY', gate: 'K1', status: 'ENCRYPTED', url: '/pgp.pub.txt', label: 'PGP public key', blurb: 'for the cautious traveller', tone: 'dim' },
];
while (arrivals.length < departures.length) arrivals.push({ time: '', flight: '', dest: '', gate: '', status: '' });

const pad = (s: string, n: number) => s.padEnd(n, ' ').slice(0, n);
const cols = ['time', 'flight', 'dest', 'gate', 'status'] as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ben Firshman — Departures</title>
    <meta name="description" content="Ben Firshman International: a split-flap departures board where every project is a flight. Replicate is now boarding." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Barlow:wght@500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main class="hall">
      <header class="top">
        <div class="sign">
          <svg class="plane" viewBox="0 0 48 48" aria-hidden="true"><path d="M4 38h40v3H4zM6.5 28.6l3-1.7 5.2 3 9.3-5.4L11 13.6l3.7-2.1 17.6 9 9-5.2c1.8-1 4-.5 4.9 1 .9 1.6.2 3.6-1.6 4.6L14.2 36.2z" fill="currentColor" /></svg>
          <div>
            <p class="airport"><span class="name">{name}</span> International</p>
            <div class="tabs" role="group" aria-label="Board">
              <button type="button" class="tab" data-board="dep" aria-pressed="true">Departures</button>
              <button type="button" class="tab" data-board="arr" aria-pressed="false">Arrivals</button>
            </div>
          </div>
        </div>
        <div class="clock" aria-label="Local time">
          <span class="clock-label">Local time</span>
          <span class="flaps" id="clock">{'--:--'.split('').map((ch) => <span class="c">{ch}</span>)}</span>
        </div>
      </header>

      <h1 class="sr">{name}: departures and arrivals</h1>

      {[{ id: 'dep', title: 'Departures', rows: departures, dest: 'Destination', status: 'Remarks' },
        { id: 'arr', title: 'Arrivals', rows: arrivals, dest: 'From', status: 'Remarks' }].map((b) => (
        <section class="board" id={`board-${b.id}`} data-board={b.id} aria-label={b.title}>
          <h2 class="nojs-title">{b.title}</h2>
          <div class="row head" aria-hidden="true">
            <span class="col time">Time</span>
            <span class="col flight">{b.id === 'dep' ? 'Flight' : 'Via'}</span>
            <span class="col dest">{b.dest}</span>
            <span class="col gate">Gate</span>
            <span class="col status">{b.status}</span>
          </div>
          <ol class="rows">
            {b.rows.map((r) => {
              const inner = cols.map((k) => (
                <span class={`col ${k}`}>{pad(r[k], W[k]).split('').map((ch) => <span class="c">{ch === ' ' ? ' ' : ch}</span>)}</span>
              ));
              return r.url ? (
                <li>
                  <a class:list={['row', r.tone && `tone-${r.tone}`, { now: r.now }]} href={r.url}
                    data-info={`${r.flight} · ${r.label}: ${r.blurb}`}
                    aria-label={`${r.flight}, ${r.label}, ${r.status.replace('→', 'diverted to').toLowerCase()}. ${r.blurb}.`}>
                    {inner}
                  </a>
                </li>
              ) : (
                <li aria-hidden="true"><div class="row blank">{inner}</div></li>
              );
            })}
          </ol>
        </section>
      ))}

      <p class="info" id="info" aria-live="polite">BF100 · Replicate is now boarding: {now.blurb}.</p>

      <footer class="foot">
        <a href="/ideas">← all ideas</a>
        <span class="notice">Please do not leave containers unattended.</span>
        <button type="button" class="sound" id="sound" aria-pressed="false" hidden>Sound: off</button>
      </footer>
    </main>

    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #0c0d10;
        --panel: #050506;
        --char: #f1eee4;
        --yellow: #ffd21f;
        --green: #79e08f;
        --sky: #7fd3ff;
        --cw: 26px;
        --gap: 2px;
        --colgap: 22px;
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0; min-height: 100vh; background: var(--bg); color: var(--char);
        background-image:
          radial-gradient(ellipse 80% 40% at 50% -5%, rgba(255, 240, 200, 0.12), transparent 70%),
          linear-gradient(180deg, #121318, #08080a 70%);
        font-family: 'Barlow', system-ui, sans-serif;
        overflow-x: hidden;
      }
      .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
      .hall { max-width: 1320px; margin: 0 auto; padding: 36px 32px 48px; display: grid; justify-items: center; }

      .top { width: 100%; display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: 20px; }
      .sign { display: flex; align-items: center; gap: 18px; color: var(--yellow); }
      .plane { width: 64px; height: 64px; flex: none; }
      .airport { margin: 0 0 4px; font: 500 14px/1.2 'Barlow', sans-serif; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(241, 238, 228, 0.6); }
      .airport .name { color: var(--char); }
      .tabs { display: flex; gap: 2px; }
      .tab {
        appearance: none; border: 0; background: none; color: rgba(255, 210, 31, 0.35); cursor: pointer; padding: 0 14px 0 0;
        font: 700 52px/1 'Barlow Condensed', sans-serif; letter-spacing: 0.01em; text-transform: uppercase;
      }
      .tab[aria-pressed="true"] { color: var(--yellow); }
      .tab:hover { color: var(--yellow); }
      .tab:focus-visible { outline: 2px solid var(--yellow); outline-offset: 4px; }
      .tab + .tab::before { content: "/"; color: rgba(255, 210, 31, 0.25); margin-right: 14px; }
      .clock { display: grid; justify-items: end; gap: 6px; }
      html:not(.js) .clock { display: none; }
      .clock-label { font: 500 12px 'Barlow', sans-serif; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(241, 238, 228, 0.5); }
      .clock .flaps { display: flex; gap: var(--gap); --cw: 34px; }
      .clock .c { --fs: 40px; }

      .board {
        width: max-content; max-width: 100%; background: var(--panel); border-radius: 10px; padding: 14px 16px 16px;
        box-shadow: 0 0 0 1px #1d1e22, 0 0 0 7px #17181c, 0 0 0 8px #26272c, 0 40px 80px -20px rgba(0, 0, 0, 0.8);
        margin-top: 8px;
      }
      .board + .board { margin-top: 40px; }
      .js .board[data-board="arr"] { display: none; }
      .js.show-arr .board[data-board="arr"] { display: block; }
      .js.show-arr .board[data-board="dep"] { display: none; }
      .nojs-title { margin: 0 0 8px; font: 700 28px 'Barlow Condensed', sans-serif; text-transform: uppercase; color: var(--yellow); }
      .js .nojs-title { display: none; }
      .js .board + .board { margin-top: 8px; }

      .rows { list-style: none; margin: 0; padding: 0; }
      .row {
        display: grid; grid-template-columns: auto auto auto auto auto; column-gap: var(--colgap);
        padding: 5px 10px; border-radius: 5px; color: var(--char); text-decoration: none; position: relative;
      }
      .rows li + li .row { margin-top: 2px; }
      .row.head {
        padding-bottom: 8px; font: 600 13px/1 'Barlow', sans-serif; letter-spacing: 0.16em; text-transform: uppercase;
        color: rgba(241, 238, 228, 0.55);
      }
      .col { display: flex; gap: var(--gap); }
      .head .col { display: block; }
      .col.time { width: calc(5 * (var(--cw) + var(--gap)) - var(--gap)); }
      .col.flight { width: calc(5 * (var(--cw) + var(--gap)) - var(--gap)); }
      .col.dest { width: calc(16 * (var(--cw) + var(--gap)) - var(--gap)); }
      .col.gate { width: calc(2 * (var(--cw) + var(--gap)) - var(--gap)); }
      .col.status { width: calc(13 * (var(--cw) + var(--gap)) - var(--gap)); }

      a.row:hover, a.row:focus-visible { background: rgba(255, 255, 255, 0.07); outline: none; }
      a.row:focus-visible { box-shadow: 0 0 0 2px var(--yellow); }
      .row.now { background: rgba(255, 210, 31, 0.09); box-shadow: inset 4px 0 0 var(--yellow); }
      .row.now:focus-visible { box-shadow: inset 4px 0 0 var(--yellow), 0 0 0 2px var(--yellow); }
      .row.now .status .c, .row.now .time .c { color: var(--yellow); }
      .row.tone-go .status .c { color: var(--green); }
      .row.tone-sky .status .c { color: var(--sky); }
      .row.tone-dim .status .c { color: rgba(241, 238, 228, 0.6); }
      .settled .row.now .status { animation: blink 1.6s steps(1) infinite; }
      @keyframes blink { 70% { opacity: 0.25; } }

      /* one split-flap cell */
      .c {
        --fs: calc(var(--cw) * 1.08);
        position: relative; display: block; flex: none; width: var(--cw); height: calc(var(--cw) * 1.46);
        border-radius: 3px; color: var(--char); text-align: center;
        font: 600 var(--fs)/calc(var(--cw) * 1.46) 'Barlow Condensed', sans-serif; text-transform: uppercase;
        background: linear-gradient(#2a2b2f, #1f2023 49.5%, #17181a 50.5%, #1d1e21);
        box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.7), 0 1px 0 rgba(255, 255, 255, 0.05);
        perspective: calc(var(--cw) * 8);
      }
      .clock .c { width: var(--cw); height: calc(var(--cw) * 1.46); line-height: calc(var(--cw) * 1.46); font-size: calc(var(--cw) * 1.1); }
      .c::after {
        content: ""; position: absolute; left: 0; right: 0; top: calc(50% - 0.5px); height: 1px; z-index: 3;
        background: #000; box-shadow: 0 1px 0 rgba(255, 255, 255, 0.04);
      }
      .c > span {
        position: absolute; inset: 0; border-radius: 3px; backface-visibility: hidden; -webkit-backface-visibility: hidden;
        background: inherit; color: inherit;
      }
      .c > .t, .c > .ft { clip-path: inset(0 0 50% 0); background: linear-gradient(#2a2b2f, #1f2023 50%); }
      .c > .b, .c > .fb { clip-path: inset(50% 0 0 0); background: linear-gradient(transparent 50%, #17181a 50%, #1d1e21); }
      .c > .ft, .c > .fb { z-index: 2; transform-origin: 50% 50%; }
      .c > .fb { transform: rotateX(90deg); }
      .c > .ft { background: linear-gradient(#303136, #1f2023 50%); }

      .info {
        width: 100%; max-width: 900px; margin: 22px 0 0; text-align: center; min-height: 1.4em;
        font: 600 18px/1.4 'Barlow Condensed', sans-serif; letter-spacing: 0.08em; text-transform: uppercase; color: var(--yellow);
      }
      .foot {
        width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-top: 28px;
        font: 500 13px 'Barlow', sans-serif; letter-spacing: 0.08em; color: rgba(241, 238, 228, 0.5); text-transform: uppercase;
      }
      .foot a { color: inherit; text-decoration: none; }
      .foot a:hover { color: var(--char); }
      .sound {
        appearance: none; background: none; color: inherit; border: 1px solid rgba(241, 238, 228, 0.25); border-radius: 999px;
        padding: 6px 12px; font: inherit; letter-spacing: inherit; text-transform: inherit; cursor: pointer;
      }
      .sound[aria-pressed="true"] { color: var(--yellow); border-color: var(--yellow); }
      .js .sound[hidden] { display: inline-block; }

      @media (max-width: 1320px) { :root { --cw: 22px; --colgap: 18px; } }
      @media (max-width: 1120px) { :root { --cw: 19px; --colgap: 14px; } .tab { font-size: 44px; } }

      /* phone: two lines per flight, fewer columns */
      @media (max-width: 960px) {
        :root { --colgap: 10px; --cw: min(26px, calc((100vw - 32px - 24px - 20px - 10px - 17 * var(--gap)) / 18)); }
        .hall { padding: 34px 16px 36px; }
        .top { flex-direction: column; align-items: stretch; gap: 14px; }
        .sign { gap: 12px; }
        .sign { align-items: flex-end; }
        .plane { width: 30px; height: 30px; margin-bottom: 2px; }
        .airport { font-size: 11px; letter-spacing: 0.12em; padding-right: 96px; margin-bottom: 6px; }
        .tab { font-size: 29px; padding-right: 6px; }
        .tab + .tab::before { margin-right: 6px; }
        .clock { position: absolute; top: 8px; right: 16px; gap: 3px; }
        .clock .flaps { --cw: 15px; }
        .clock-label { font-size: 9px; letter-spacing: 0.14em; }
        .board { width: 100%; padding: 10px 6px 12px; }
        .row { grid-template-columns: auto auto; grid-template-areas: "dest dest" "flight status"; row-gap: 3px; padding: 6px; }
        .rows li + li .row { margin-top: 4px; }
        .col.time, .col.gate { display: none; }
        .col.dest { grid-area: dest; }
        .col.flight { grid-area: flight; }
        .col.status { grid-area: status; }
        .row.head { grid-template-areas: "flight status"; font-size: 11px; }
        .row.head .col.dest { display: none; }
        .info { font-size: 15px; }
        .foot { flex-wrap: wrap; font-size: 11px; }
        .notice { order: 3; width: 100%; }
      }
      @media (prefers-reduced-motion: reduce) {
        .settled .row.now .status { animation: none; }
      }
    </style>

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <script>
      const CHARS = " 0123456789:.-/@→'&ABCDEFGHIJKLMNOPQRSTUVWXYZ";
      const STEP = 52; // ms per flap
      const reduce = matchMedia('(prefers-reduced-motion: reduce)');

      type Cell = { el: HTMLElement; s: HTMLElement[]; cur: string; queue: string[]; next: number; anims: Animation[] };

      function upgrade(el: HTMLElement): Cell {
        const ch = (el.textContent || ' ').replace(' ', ' ');
        el.textContent = '';
        const s = ['t', 'b', 'ft', 'fb'].map((k) => {
          const x = document.createElement('span');
          x.className = k; x.textContent = ch; el.appendChild(x); return x;
        });
        return { el, s, cur: ch, queue: [], next: 0, anims: [] };
      }
      function show(c: Cell, ch: string) {
        c.anims.forEach((a) => a.cancel());
        c.anims = [];
        c.s.forEach((x) => (x.textContent = ch));
        c.cur = ch;
      }
      function flap(c: Cell, ch: string) {
        const old = c.cur;
        const [t, b, ft, fb] = c.s;
        c.anims.forEach((a) => a.cancel());
        t.textContent = ch; b.textContent = old; ft.textContent = old; fb.textContent = ch;
        const half = STEP * 0.5;
        const a1 = ft.animate([{ transform: 'rotateX(0deg)' }, { transform: 'rotateX(-90deg)' }], { duration: half, easing: 'ease-in', fill: 'forwards' });
        const a2 = fb.animate([{ transform: 'rotateX(90deg)' }, { transform: 'rotateX(0deg)' }], { duration: half, delay: half, easing: 'ease-out', fill: 'both' });
        a2.onfinish = () => {
          // done: collapse back to static halves so finished cells cost nothing
          b.textContent = ch; ft.textContent = ch;
          a1.cancel(); a2.cancel();
          c.anims = [];
        };
        c.anims = [a1, a2];
        c.cur = ch;
        sound.tick();
      }
      // The path a real flap takes: forwards through the drum until it gets there.
      function path(from: string, to: string, max: number): string[] {
        let i = Math.max(0, CHARS.indexOf(from));
        const j = Math.max(0, CHARS.indexOf(to));
        const out: string[] = [];
        while (i !== j) { i = (i + 1) % CHARS.length; out.push(CHARS[i]); }
        return out.length > max ? out.slice(out.length - max) : out;
      }

      const active = new Set<Cell>();
      let raf = 0;
      function loop(now: number) {
        for (const c of active) {
          if (now < c.next) continue;
          // if frames are running late, skip the drum ahead rather than fall behind
          let ch = c.queue.shift();
          const behind = Math.floor((now - c.next) / STEP);
          for (let i = 0; i < behind && c.queue.length; i++) ch = c.queue.shift();
          if (ch === undefined) { active.delete(c); continue; }
          flap(c, ch);
          c.next = Math.max(c.next + STEP * (behind + 1), now) + Math.random() * 14;
        }
        raf = active.size ? requestAnimationFrame(loop) : 0;
        if (!active.size) onSettle.splice(0).forEach((f) => f());
      }
      const onSettle: (() => void)[] = [];
      function run(c: Cell, target: string, delay: number, max = 20) {
        if (reduce.matches) { show(c, target); return; }
        // every flap on a real board is a little out of step with its neighbours
        max = Math.max(3, Math.round(max * (0.35 + Math.random() * 0.65)));
        const q = path(c.cur, target, max);
        if (!q.length) return;
        if (q.length >= max) {
          // too far to flap all the way round: start partway, like a board that was mid-update
          const startAt = CHARS[(CHARS.indexOf(q[0]) - 1 + CHARS.length) % CHARS.length];
          show(c, c.cur === ' ' ? ' ' : startAt);
        }
        c.queue = q;
        c.next = performance.now() + delay;
        active.add(c);
        if (!raf) raf = requestAnimationFrame(loop);
      }

      // Boards
      const boards: Record<string, Cell[][]> = {};
      const targets: Record<string, string[][]> = {};
      document.querySelectorAll<HTMLElement>('.board').forEach((board) => {
        const id = board.dataset.board!;
        const rows = Array.from(board.querySelectorAll<HTMLElement>('.rows .row'));
        boards[id] = rows.map((r) => Array.from(r.querySelectorAll<HTMLElement>('.c')).map(upgrade));
        targets[id] = boards[id].map((row) => row.map((c) => c.cur));
      });

      function play(id: string, from?: string) {
        const cells = boards[id];
        const isMobile = matchMedia('(max-width: 960px)').matches;
        cells.forEach((row, r) => row.forEach((c, k) => {
          const start = from ? boards[from][r]?.[k]?.cur ?? ' ' : ' ';
          show(c, start);
          // on phones the destination sits on its own line, so stagger by visual position
          const delay = r * (isMobile ? 70 : 85) + k * (isMobile ? 9 : 14) + Math.random() * 120;
          run(c, targets[id][r][k], delay, from ? 12 : 16);
        }));
      }

      const html = document.documentElement;
      const settle = () => html.classList.add('settled');
      onSettle.push(settle);
      if (reduce.matches) settle();
      play('dep');

      // Departures ⇄ Arrivals
      let current = 'dep';
      const info = document.getElementById('info')!;
      const defaultInfo: Record<string, string> = {
        dep: info.textContent!,
        arr: 'Arrivals: messages to Ben land here. Write any time.',
      };
      document.querySelectorAll<HTMLButtonElement>('.tab').forEach((tab) => {
        tab.addEventListener('click', () => {
          const next = tab.dataset.board!;
          if (next === current) return;
          document.querySelectorAll('.tab').forEach((t) => t.setAttribute('aria-pressed', String(t === tab)));
          html.classList.toggle('show-arr', next === 'arr');
          html.classList.remove('settled');
          onSettle.push(settle);
          play(next, current);
          current = next;
          info.textContent = defaultInfo[next];
          if (reduce.matches) settle();
        });
      });

      // Hover a flight to read its blurb on the info line
      document.querySelectorAll<HTMLAnchorElement>('a.row').forEach((a) => {
        const set = () => { info.textContent = a.dataset.info!; };
        a.addEventListener('mouseenter', set);
        a.addEventListener('focus', set);
        a.addEventListener('mouseleave', () => { info.textContent = defaultInfo[current]; });
      });

      // Clock
      const clock = Array.from(document.querySelectorAll<HTMLElement>('#clock .c')).map(upgrade);
      function tickClock(first = false) {
        const d = new Date();
        const s = `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
        clock.forEach((c, i) => {
          if (c.cur !== s[i]) first ? (show(c, ' '), run(c, s[i], 300 + i * 90, 12)) : run(c, s[i], i * 60, 12);
        });
      }
      tickClock(true);
      setInterval(tickClock, 1000);

      // Sound: a soft clatter, off until asked.
      const sound = (() => {
        let ctx: AudioContext | null = null;
        let buf: AudioBuffer | null = null;
        let on = false;
        let last = 0;
        return {
          toggle() {
            on = !on;
            if (on && !ctx) {
              ctx = new AudioContext();
              buf = ctx.createBuffer(1, Math.floor(ctx.sampleRate * 0.012), ctx.sampleRate);
              const d = buf.getChannelData(0);
              for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / d.length, 4);
            }
            ctx?.resume();
            return on;
          },
          tick() {
            if (!on || !ctx || !buf) return;
            const t = ctx.currentTime;
            if (t - last < 0.012) return;
            last = t;
            const src = ctx.createBufferSource();
            const g = ctx.createGain();
            const f = ctx.createBiquadFilter();
            f.type = 'bandpass'; f.frequency.value = 1800 + Math.random() * 1400; f.Q.value = 1.2;
            g.gain.value = 0.18 + Math.random() * 0.12;
            src.buffer = buf; src.playbackRate.value = 0.8 + Math.random() * 0.5;
            src.connect(f).connect(g).connect(ctx.destination);
            src.start();
          },
        };
      })();
      const soundBtn = document.getElementById('sound')!;
      soundBtn.addEventListener('click', () => {
        const on = sound.toggle();
        soundBtn.setAttribute('aria-pressed', String(on));
        soundBtn.textContent = `Sound: ${on ? 'on' : 'off'}`;
        if (on) play(current, current === 'dep' ? 'arr' : 'dep');
      });
    </script>
  </body>
</html>
