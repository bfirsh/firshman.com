---
import { PALETTES } from '../../components/ideas/drift/palettes';
const palettes = PALETTES.map((p) => ({ sky: p.sky, haze: p.haze, ink: p.ink, muted: p.muted, dark: p.dark }));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ben Firshman</title>
    <meta name="description" content="Ben Firshman is working on Replicate. Before that: Cog, Command Line Interface Guidelines, Docker Compose, JSNES, arXiv Vanity, and more." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" rel="stylesheet" />
    <script is:inline define:vars={{ palettes }}>
      // pick this edition before first paint, so the text is born in the right colours
      var q = new URLSearchParams(location.search).get('seed');
      var seed = q && /^\d{1,9}$/.test(q) ? parseInt(q, 10) : 1 + Math.floor(Math.random() * 99999);
      var p = palettes[seed % palettes.length];
      var de = document.documentElement;
      de.dataset.seed = String(seed);
      de.dataset.palette = String(seed % palettes.length);
      de.classList.add('js');
      if (p.dark) de.classList.add('dark');
      de.style.setProperty('--sky', p.sky);
      de.style.setProperty('--haze', p.haze);
      de.style.setProperty('--ink', p.ink);
      de.style.setProperty('--muted', p.muted);
    </script>
  </head>
  <body>
    <main id="text">
      <h1>Ben Firshman</h1>

      <p>I’m working on <a href="https://replicate.com">Replicate</a>. Some other stuff I’ve done:</p>

      <ul>
        <li><a href="https://github.com/replicate/cog">Cog</a>, containers for machine learning.</li>
        <li><a href="https://clig.dev">Command Line Interface Guidelines</a>, a guide to help you write better command-line programs.</li>
        <li><a href="https://github.com/docker/compose">Docker Compose</a> and <a href="https://github.com/docker/machine">Docker Machine</a>.</li>
        <li><a href="https://github.com/bfirsh/jsnes">JSNES</a>, one of the first JavaScript emulators.</li>
        <li><a href="https://github.com/whalebrew/whalebrew">Whalebrew</a>, a Docker package manager.</li>
        <li><a href="https://www.arxiv-vanity.com/">arXiv Vanity</a>, which rendered papers from arXiv as responsive web pages.</li>
        <li>I worked on <a href="https://gov.uk">GOV.UK</a>, <a href="https://www.youtube.com/watch?v=53ZJdJNsBto">The Guardian’s iPad app</a>, <a href="https://www.thisismyjam.com">This Is My Jam</a>, <a href="https://en.wikipedia.org/wiki/Lanyrd">Lanyrd</a>, and <a href="https://spacelog.org">Spacelog</a>.</li>
        <li>I worked on many parts of <a href="https://www.djangoproject.com/">Django</a>, including class-based views, feeds, and search.</li>
        <li>I helped start the <a href="https://ukhas.org.uk/">UK High Altitude Society</a>, a group for amateur near-space exploration.</li>
      </ul>

      <p>Email me at <a href="mailto:ben@firshman.com">ben@firshman.com</a>.<br />
        I’m also on <a href="https://x.com/bfirsh">X</a>, <a href="https://github.com/bfirsh">GitHub</a>, and <a href="https://www.linkedin.com/in/bfirsh/">LinkedIn</a>.</p>
    </main>

    <canvas id="field" aria-hidden="true"></canvas>

    <div class="corner">
      <a class="ed" id="ed" href="?seed=" title="Copy a link to this edition"></a>
      <a class="ideas" href="/ideas">ideas</a>
    </div>

    <style is:global>
      :root {
        --sky: #e8e7e3;
        --haze: #d6d3cc;
        --ink: #1c2025;
        --muted: #5a6069;
        --serif: 'Newsreader', 'Iowan Old Style', 'Palatino Linotype', Georgia, serif;
        color-scheme: light;
      }
      :root.dark { color-scheme: dark; }
      html { background: var(--sky); }
      html, body { margin: 0; overflow-x: hidden; }
      body {
        min-height: 100vh;
        min-height: 100svh;
        background: linear-gradient(to bottom, var(--sky) 0%, var(--sky) 30%, var(--haze) 72%, var(--haze) 100%) fixed;
        color: var(--ink);
        font-family: var(--serif);
        font-optical-sizing: auto;
        font-size: 17px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      main {
        position: relative;
        z-index: 1;
        box-sizing: border-box;
        max-width: calc(37rem + 2 * clamp(24px, 6vw, 96px));
        padding: clamp(36px, 9vh, 96px) clamp(24px, 6vw, 96px) 40px;
      }
      h1 {
        font-weight: 500;
        font-size: 1.65rem;
        line-height: 1.2;
        letter-spacing: -0.005em;
        margin: 0 0 1.1rem;
      }
      p { margin: 0 0 0.9rem; }
      ul { list-style: none; margin: 0 0 1.1rem; padding: 0; }
      li { position: relative; margin: 0 0 0.28rem; }
      li::before {
        content: '–';
        position: absolute;
        left: -1.15em;
        color: var(--muted);
        opacity: 0.7;
      }
      a {
        color: inherit;
        text-decoration-line: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.18em;
        text-decoration-color: color-mix(in srgb, currentColor 32%, transparent);
        transition: text-decoration-color 0.2s;
      }
      a:hover, a:focus-visible { text-decoration-color: currentColor; }
      a:focus-visible { outline: 1px solid currentColor; outline-offset: 2px; border-radius: 1px; }
      ::selection { background: color-mix(in srgb, var(--ink) 16%, transparent); }

      #field {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
        z-index: 0;
        opacity: 0;
        transition: opacity 2.8s ease;
      }
      #field.on { opacity: 1; }
      /* no script or no WebGL: the text stands alone */
      html:not(.js) #field, #field.off { display: none; }

      .corner {
        position: fixed;
        z-index: 2;
        top: 14px;
        right: 18px;
        display: flex;
        gap: 14px;
        font-size: 12px;
        letter-spacing: 0.02em;
      }
      .corner a {
        color: var(--ink);
        opacity: 0.28;
        text-decoration: none;
        transition: opacity 0.3s;
      }
      .corner a:hover, .corner a:focus-visible { opacity: 0.85; }
      .ed { display: none; font-variant-numeric: tabular-nums; }
      .js .ed { display: inline; }

      @media (max-width: 720px) {
        body { font-size: 16px; background: var(--sky); }
        main { padding: 64px 22px 0 calc(22px + 1.05em); }
        h1 { font-size: 1.5rem; }
        li::before { left: -1.05em; }
        #field {
          position: relative;
          height: 58svh;
          min-height: 320px;
          margin-top: -2svh;
          -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 22%);
          mask-image: linear-gradient(to bottom, transparent 0%, #000 22%);
        }
        .corner { position: absolute; }
      }
      @media (min-width: 721px) and (max-height: 760px) {
        body { font-size: 15.5px; }
        main { padding-top: 40px; }
      }
      @media (prefers-reduced-motion: reduce) {
        #field { transition: none; }
      }
    </style>

    <script>
      import { PALETTES } from '../../components/ideas/drift/palettes';
      import { startDrift } from '../../components/ideas/drift/field';

      const de = document.documentElement;
      const seed = parseInt(de.dataset.seed || '1', 10);
      const palette = PALETTES[parseInt(de.dataset.palette || '0', 10)] || PALETTES[0];

      const ed = document.getElementById('ed') as HTMLAnchorElement;
      const label = `No. ${seed}`;
      ed.textContent = label;
      ed.href = `?seed=${seed}`;
      ed.addEventListener('click', async (e) => {
        e.preventDefault();
        const url = `${location.origin}${location.pathname}?seed=${seed}`;
        try { history.replaceState(null, '', `?seed=${seed}`); } catch {}
        try { await navigator.clipboard.writeText(url); ed.textContent = 'Copied'; }
        catch { ed.textContent = `?seed=${seed}`; }
        setTimeout(() => (ed.textContent = label), 1600);
      });

      startDrift({
        canvas: document.getElementById('field') as HTMLCanvasElement,
        text: document.getElementById('text') as HTMLElement,
        seed,
        palette,
        reduce: matchMedia('(prefers-reduced-motion: reduce)').matches,
      });
    </script>
  </body>
</html>
