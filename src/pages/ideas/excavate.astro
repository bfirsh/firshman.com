---
// Excavate: brush away a block of layered voxel stone to uncover the finds buried inside.
import { name, now, projects, alsoWorkedOn, email, socials } from '../../data/bio';
void projects; void alsoWorkedOn; void socials; void now;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Ben Firshman</title>
    <meta name="description" content="Ben Firshman works on Replicate. Before that: Cog, Command Line Interface Guidelines, Docker Compose, JSNES, and more. Brush away the stone to find them." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />
    <script is:inline>
      (function () {
        var d = document.documentElement, q = new URLSearchParams(location.search);
        var s = parseInt(q.get('seed') || '', 10);
        if (!(s > 0 && s < 100000)) s = 1 + Math.floor(Math.random() * 99999);
        d.dataset.seed = s;
        var c = document.createElement('canvas');
        var ok = false;
        try { ok = !!c.getContext('webgl2'); } catch (e) {}
        if (ok) d.classList.add('art');
      })();
    </script>
    <style is:global>
      :root {
        --bg: #120d0a; --ink: #f0e3cc; --soft: #b8a184; --gold: #e9bd66; --line: rgba(240, 227, 204, .3);
        --paper: #f4ecdd; --paper-ink: #2d2119; --paper-soft: #7a6450;
        color-scheme: dark;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; background: var(--bg); }
      body {
        color: var(--ink);
        font-family: 'EB Garamond', 'Iowan Old Style', 'Palatino Linotype', Georgia, serif;
        font-size: 17px; line-height: 1.45;
        -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
        font-variant-numeric: oldstyle-nums;
        overflow-x: hidden;
      }
      a { color: inherit; text-decoration: underline; text-decoration-color: var(--line); text-decoration-thickness: 1px; text-underline-offset: .18em; transition: text-decoration-color .2s, color .2s; }
      a:hover, a:focus-visible { text-decoration-color: currentColor; }
      :focus-visible { outline: 1px solid currentColor; outline-offset: 3px; border-radius: 2px; }
      button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }

      #dig { position: fixed; inset: 0; width: 100vw; height: 100vh; height: 100dvh; display: block; touch-action: none; outline: none; opacity: 0; transition: opacity 2.2s ease; }
      #dig.on { opacity: 1; }
      html:not(.art) #dig, html:not(.art) .ui:not(.corner), html:not(.art) .corner button { display: none !important; }

      .ui { position: fixed; z-index: 3; }
      .title {
        top: 18px; left: 20px; font-size: 13px; letter-spacing: .2em; text-transform: uppercase; font-weight: 500;
        color: var(--ink); opacity: 0; transition: opacity 2s ease 1s; pointer-events: none;
      }
      .title span { display: block; font-size: 13px; letter-spacing: .02em; text-transform: none; font-style: italic; font-weight: 400; color: var(--soft); margin-top: 2px; }
      .on-ready .title { opacity: .78; }

      #tally {
        top: 16px; right: 18px; font-size: 15px; color: var(--ink); opacity: .55; transition: opacity .3s;
        display: flex; gap: 7px; align-items: baseline; padding: 3px 2px;
      }
      #tally:hover, #tally:focus-visible, #tally.lit { opacity: 1; }
      #tally em { font-size: 12px; color: var(--soft); letter-spacing: .08em; }
      #tally b { font-weight: 500; color: var(--gold); transition: transform .5s cubic-bezier(.2, 1.6, .4, 1); display: inline-block; }
      #tally.pop b { transform: scale(1.35); }

      #notes {
        top: 46px; right: 16px; width: min(320px, calc(100vw - 32px)); max-height: calc(100vh - 120px); overflow: auto;
        background: rgba(20, 14, 10, .82); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
        border: 1px solid rgba(240, 227, 204, .12); border-radius: 3px; padding: 14px 18px 12px; font-size: 15px;
        opacity: 0; transform: translateY(-6px); transition: opacity .25s, transform .25s; pointer-events: none;
      }
      #notes.open { opacity: 1; transform: none; pointer-events: auto; }
      #notes h2 { margin: 0 0 8px; font-size: 12px; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; color: var(--soft); }
      #notes ol { list-style: none; margin: 0; padding: 0; }
      #notes li { padding: 3px 0; border-top: 1px solid rgba(240, 227, 204, .07); display: flex; gap: 10px; align-items: baseline; }
      #notes li .n { width: 1.4em; flex: none; color: var(--soft); font-size: 12px; text-align: right; }
      #notes li.unfound { color: rgba(240, 227, 204, .28); font-style: italic; }
      #notes li small { color: var(--soft); font-style: italic; font-size: 13px; }

      #hint {
        left: 0; right: 0; top: 15px; text-align: center; pointer-events: none; font-style: italic; font-size: 17px;
        color: var(--ink); opacity: 0; transition: opacity 1.6s ease; text-shadow: 0 1px 12px rgba(0, 0, 0, .6);
      }
      #hint.show { opacity: .7; }

      .corner { right: 16px; bottom: 12px; display: flex; gap: 14px; align-items: baseline; font-size: 13px; }
      .corner a, .corner button { color: var(--ink); opacity: .32; text-decoration: none; transition: opacity .3s; padding: 4px 0; }
      .corner a:hover, .corner a:focus-visible, .corner button:hover, .corner button:focus-visible { opacity: .85; }
      .corner button[aria-pressed='true'] { opacity: .8; }
      #ed { font-size: 12px; }

      #labels { position: fixed; inset: 0; z-index: 2; pointer-events: none; overflow: hidden; }
      .find {
        position: absolute; left: 0; top: 0; pointer-events: auto; white-space: nowrap; text-align: center;
        padding: 2px 6px 3px; will-change: transform, opacity;
        text-shadow: 0 1px 2px rgba(0, 0, 0, .9), 0 0 14px rgba(0, 0, 0, .75);
        font-size: 14px; line-height: 1.25;
      }
      .find { isolation: isolate; }
      .find::before { content: ''; position: absolute; inset: -10px -22px; z-index: -1; pointer-events: none; background: radial-gradient(closest-side, rgba(16, 10, 7, .62), rgba(16, 10, 7, .35) 60%, rgba(16, 10, 7, 0)); }
      .find.compact::before { inset: -6px -14px; }
      .find.compact { padding: 1px 5px; }
      .find.compact .k, .find.compact .b, .find.compact .soc { display: none; }
      .find.compact .nm { font-size: 14px; font-weight: 400; color: #ead8bb; }
      .find .k { display: block; font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--soft); }
      .find .nm { font-size: 17px; font-weight: 500; color: #fff2da; text-decoration-color: rgba(233, 189, 102, .55); }
      .find .nm:hover { color: var(--gold); }
      .find .b { display: block; font-style: italic; color: #dccab0; font-size: 14px; }
      .find .soc { display: block; font-size: 14px; color: var(--soft); }
      .find .soc a { color: #f0e3cc; }

      #coda {
        left: 0; right: 0; top: 13px; text-align: center; pointer-events: none; opacity: 0; transition: opacity 2.5s ease;
        text-shadow: 0 1px 16px rgba(0, 0, 0, .7);
      }
      #coda.show { opacity: 1; }
      #coda p { margin: 0 0 2px; font-style: italic; font-size: 18px; }
      #coda.show a { pointer-events: auto; }
      #coda a { font-size: 14px; letter-spacing: .14em; text-transform: uppercase; color: var(--soft); }

      /* the escape hatch: everything, plainly */
      #read { position: fixed; inset: 0; z-index: 10; display: none; align-items: flex-start; justify-content: center; overflow-y: auto; padding: 8vh 16px; background: rgba(10, 7, 5, .62); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
      .reading #read { display: flex; }
      .sheet {
        position: relative; width: min(34rem, 100%); background: var(--paper); color: var(--paper-ink); border-radius: 2px;
        padding: 44px 46px 34px; box-shadow: 0 30px 80px rgba(0, 0, 0, .5); font-size: 18px; line-height: 1.5;
      }
      .sheet h1 { font-weight: 500; font-size: 2rem; line-height: 1.1; margin: 0 0 1rem; letter-spacing: -.005em; }
      .sheet p, .sheet ul { margin: 0 0 1rem; }
      .sheet ul { padding: 0; list-style: none; }
      .sheet li { padding-left: 1.1rem; position: relative; margin-bottom: .4rem; }
      .sheet li::before { content: ''; position: absolute; left: .1rem; top: .74em; width: .4rem; height: 1px; background: var(--paper-soft); }
      .sheet a { --line: rgba(45, 33, 25, .3); }
      .sheet hr { border: 0; border-top: 1px solid rgba(45, 33, 25, .15); margin: 1.4rem 0 0; }
      .sheet .close { position: absolute; top: 14px; right: 18px; font-size: 14px; color: var(--paper-soft); }
      .sheet .close:hover { color: var(--paper-ink); }
      html:not(.art) #read { display: flex; position: static; background: none; backdrop-filter: none; -webkit-backdrop-filter: none; min-height: 100vh; }
      html:not(.art) .sheet .close { display: none; }
      html:not(.art) body { background: radial-gradient(ellipse at 50% 30%, #2b1f17, #120d0a 70%) fixed; }
      html:not(.art) .sheet::after { content: ''; display: block; margin-top: 18px; height: 6px; background: repeating-linear-gradient(90deg, #c9a774 0 18px, #bf8440 18px 30px, #ece2cc 30px 44px, #77685e 44px 60px, #d8b067 60px 80px); opacity: .8; border-radius: 1px; }

      @media (max-width: 600px) {
        .title { top: 14px; left: 16px; font-size: 12px; }
        #tally { top: 12px; right: 14px; }
        .sheet { padding: 36px 24px 28px; font-size: 17px; }
        .find { font-size: 13px; } .find .nm { font-size: 15px; } .find .b { font-size: 13px; }
        #hint { font-size: 16px; }
        #coda { top: 58px; } #coda p { font-size: 16px; }
      }
      @media (prefers-reduced-motion: reduce) {
        #dig, .title, #hint, #coda, .find { transition-duration: .01s !important; }
      }
    </style>
  </head>
  <body>
    <canvas id="dig" tabindex="0" aria-label="A block of layered stone on a plinth. Drag, or use the arrow keys and space, to brush it away and uncover what is buried inside."></canvas>
    <div id="labels" aria-live="polite"></div>

    <div class="ui title" aria-hidden="true">Ben Firshman<span>an excavation</span></div>
    <button class="ui" id="tally" type="button" aria-expanded="false" aria-controls="notes"><b id="count">0</b> / <span id="total">16</span> <em>finds</em></button>
    <section class="ui" id="notes" aria-label="Field notes">
      <h2>Field notes</h2>
      <ol id="notes-list"></ol>
    </section>
    <div class="ui" id="hint" aria-hidden="true">brush the stone away</div>
    <div class="ui" id="coda"><p>Everything is out of the ground.</p><a id="again" href="?">dig another site</a></div>

    <div class="ui corner">
      <button type="button" id="sound" aria-pressed="false">sound</button>
      <button type="button" id="readbtn" aria-controls="read">read</button>
      <a href="/ideas">ideas</a>
      <button type="button" id="ed" title="Copy a link to this site" hidden></button>
    </div>

    <div id="read" role="dialog" aria-modal="true" aria-label="Ben Firshman">
      <div class="sheet">
        <button type="button" class="close" id="close">close</button>
        <main>
          <h1>{name}</h1>

          <p>I'm working on <a href="https://replicate.com">Replicate</a>. Some other stuff I've done:</p>

          <ul>
            <li><a href="https://github.com/replicate/cog">Cog</a>, containers for machine learning.</li>
            <li><a href="https://clig.dev">Command Line Interface Guidelines</a>, a guide to help you write better command-line programs.</li>
            <li><a href="https://github.com/docker/compose">Docker Compose</a> and <a href="https://github.com/docker/machine">Docker Machine</a>.</li>
            <li><a href="https://github.com/bfirsh/jsnes">JSNES</a>, one of the first JavaScript emulators.</li>
            <li><a href="https://github.com/whalebrew/whalebrew">Whalebrew</a>, a Docker package manager.</li>
            <li><a href="https://www.arxiv-vanity.com/">arXiv Vanity</a>, which rendered papers from arXiv as responsive web pages.</li>
            <li>I worked on <a href="https://gov.uk">GOV.UK</a>, <a href="https://www.youtube.com/watch?v=53ZJdJNsBto">The Guardian's iPad app</a>, <a href="https://www.thisismyjam.com">This Is My Jam</a>, <a href="https://en.wikipedia.org/wiki/Lanyrd">Lanyrd</a>, and <a href="https://spacelog.org">Spacelog</a>.</li>
            <li>I worked on many parts of <a href="https://www.djangoproject.com/">Django</a>, including class-based views, feeds, and search.</li>
            <li>I helped start the <a href="https://ukhas.org.uk/">UK High Altitude Society</a>, a group for amateur near-space exploration.</li>
          </ul>

          <p>Email me at <a href={`mailto:${email}`}>{email}</a>.<br />
            I'm also on <a href="https://x.com/bfirsh">X</a>, <a href="https://github.com/bfirsh">GitHub</a>, and <a href="https://www.linkedin.com/in/bfirsh/">LinkedIn</a>.</p>

          <hr />
        </main>
      </div>
    </div>

    <script>
      import { startExcavate } from '../../components/ideas/excavate/scene';
      import { items, socials, email } from '../../components/ideas/excavate/content';
      import type { FindItem } from '../../components/ideas/excavate/content';

      const d = document.documentElement;
      const seed = parseInt(d.dataset.seed || '1', 10);
      const $ = (id: string) => document.getElementById(id)!;

      // edition number / share link
      const ed = $('ed') as HTMLButtonElement;
      const label = `No. ${seed}`;
      ed.textContent = label; ed.hidden = false;
      ed.addEventListener('click', async () => {
        const url = new URL(location.href);
        url.searchParams.set('seed', String(seed));
        history.replaceState(null, '', url);
        try { await navigator.clipboard.writeText(url.toString()); ed.textContent = 'link copied'; } catch { /* ignore */ }
        setTimeout(() => (ed.textContent = label), 1600);
      });

      // read panel
      const read = $('read'), readBtn = $('readbtn');
      let lastFocus: Element | null = null;
      const openRead = () => { lastFocus = document.activeElement; d.classList.add('reading'); ($('close') as HTMLElement).focus(); };
      const closeRead = () => { d.classList.remove('reading'); (lastFocus as HTMLElement | null)?.focus?.(); };
      readBtn.addEventListener('click', openRead);
      $('close').addEventListener('click', closeRead);
      read.addEventListener('click', (e) => { if (e.target === read) closeRead(); });
      addEventListener('keydown', (e) => {
        if (e.key === 'Escape') { if (d.classList.contains('reading')) closeRead(); else setNotes(false); }
      });

      // field notes
      const tally = $('tally'), notes = $('notes'), list = $('notes-list');
      $('total').textContent = String(items.length);
      const setNotes = (open: boolean) => { notes.classList.toggle('open', open); tally.setAttribute('aria-expanded', String(open)); };
      tally.addEventListener('click', () => setNotes(!notes.classList.contains('open')));
      const found = new Set<string>();
      const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
      function renderNotes() {
        list.innerHTML = items.map((it, i) => {
          const n = `<span class="n">${i + 1}</span>`;
          if (!found.has(it.key)) return `<li class="unfound">${n}<span>${it.type === 'geode' ? 'a geode, unopened' : 'a tablet, still buried'}</span></li>`;
          if (it.kind === 'contact') return `<li>${n}<span><a href="mailto:${email}">${email}</a> <small>·</small> ${socials.map((s) => `<a href="${s.url}">${s.name}</a>`).join(' <small>·</small> ')}</span></li>`;
          if (it.kind === 'greet') return `<li>${n}<span><small>greets to</small> <a href="${it.url}">${esc(it.title)}</a></span></li>`;
          return `<li>${n}<span><a href="${it.url}">${esc(it.title)}</a> <small>${esc(it.blurb || '')}</small></span></li>`;
        }).join('');
      }
      renderNotes();

      function makeLabel(it: FindItem) {
        const el = document.createElement('div');
        el.className = 'find';
        el.dataset.kind = it.kind;
        if (it.kind === 'contact') {
          el.innerHTML = `<span class="k">a golden geode</span><a class="nm" href="mailto:${email}">${email}</a><span class="soc">${socials.map((s) => `<a href="${s.url}">${s.name}</a>`).join(' · ')}</span>`;
        } else if (it.kind === 'greet') {
          el.innerHTML = `<span class="k">greets to</span><a class="nm" href="${it.url}">${esc(it.title)}</a>`;
        } else if (it.kind === 'now') {
          el.innerHTML = `<span class="k">working on now</span><a class="nm" href="${it.url}">${esc(it.title)}</a><span class="b">run AI models with a cloud API</span>`;
        } else {
          el.innerHTML = `<a class="nm" href="${it.url}">${esc(it.title)}</a><span class="b">${esc(it.blurb || '')}</span>`;
        }
        return el;
      }

      const hint = $('hint');
      const count = $('count');
      if (d.classList.contains('art')) {
        const canvas = $('dig') as HTMLCanvasElement;
        try {
          const game = startExcavate(canvas, {
            seed,
            reduced: matchMedia('(prefers-reduced-motion: reduce)').matches,
            items,
            hooks: {
              labels: $('labels'),
              makeLabel,
              onFound(it, n) {
                found.add(it.key); renderNotes();
                hint.classList.remove('show');
                count.textContent = String(n);
                tally.classList.add('pop', 'lit');
                setTimeout(() => tally.classList.remove('pop'), 500);
                setTimeout(() => tally.classList.remove('lit'), 2500);
              },
              onFirstDig() { hint.classList.remove('show'); },
              onFinale() {
                hint.classList.remove('show');
                setTimeout(() => $('coda').classList.add('show'), 8500);
              },
            },
          });
          requestAnimationFrame(() => { canvas.classList.add('on'); d.classList.add('on-ready'); });
          setTimeout(() => { if (game.found() === 0) hint.classList.add('show'); }, 1800);
          const again = $('again') as HTMLAnchorElement;
          again.href = `?seed=${1 + Math.floor(Math.random() * 99999)}`;
          const snd = $('sound');
          snd.addEventListener('click', () => {
            const on = snd.getAttribute('aria-pressed') !== 'true';
            const ok = game.setSound(on);
            snd.setAttribute('aria-pressed', String(on && ok !== false));
          });
        } catch (e) {
          console.error(e);
          d.classList.remove('art');
        }
      }
    </script>
  </body>
</html>
