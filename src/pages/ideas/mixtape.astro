---
import { projects, now, email, socials, alsoWorkedOn, name } from '../../data/bio';
import Cassette from '../../components/ideas/mixtape/Cassette.astro';

type Track = { side: 'A' | 'B'; title: string; mix?: string; url: string; blurb: string; dur: number; durLabel?: string };

// Fake durations. Some of them are in-jokes, none of them are measurements.
const extra: Record<string, { mix?: string; dur: number }> = {
  cog: { mix: 'Container Mix', dur: 221 },
  clig: { mix: '--help', dur: 244 },
  compose: { mix: 'Fig Mix', dur: 213 },
  machine: { mix: 'Provisioned Anywhere Dub', dur: 178 },
  whalebrew: { mix: 'Deep Sea Mix', dur: 312 },
  'arxiv-vanity': { mix: 'Responsive Edit', dur: 207 },
  jsnes: { mix: '8-bit Edit', dur: 488 },
  django: { mix: 'Class-Based Version', dur: 191 },
  ukhas: { mix: 'Stratospheric', dur: 402 },
};
const fmt = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;

const tracks: Track[] = [
  { side: 'A', title: now.name, mix: 'Live', url: now.url, blurb: `${now.blurb}. Still playing.`, dur: 297, durLabel: 'live' },
  ...projects.filter((p) => p.era !== 'early').map((p) => ({ side: 'A' as const, title: p.name, url: p.url, blurb: p.blurb, ...extra[p.slug] })),
  ...projects.filter((p) => p.era === 'early').map((p) => ({ side: 'B' as const, title: p.name, url: p.url, blurb: p.blurb, ...extra[p.slug] })),
  ...alsoWorkedOn.map((a, n) => ({
    side: 'B' as const, title: a.name, url: a.url,
    mix: a.name === 'This Is My Jam' ? 'obviously' : 'session',
    blurb: a.name === 'This Is My Jam' ? 'one song at a time. Where this mixtape got the idea.' : 'a bonus track, recorded with friends',
    dur: [158, 185, 196, 167, 193][n],
  })),
];
const sides = (['A', 'B'] as const).map((s) => ({ s, list: tracks.map((t, i) => ({ ...t, i })).filter((t) => t.side === s) }));
const data = tracks.map(({ side, title, mix, url, blurb, dur }) => ({ side, title, mix, url, blurb, dur }));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ben Firshman — Mixtape</title>
    <meta name="description" content="Ben's Career Mix vol. 1: every project Ben Firshman has worked on, as a cassette tape." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Permanent+Marker&family=Space+Mono:wght@400;700&family=Archivo:wght@500;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="back" href="/ideas">← all ideas</a>

    <main class="wrap">
      <section class="player" aria-label="Cassette player">
        <div class="stage">
          <div class="cassette" id="cassette">
            <div class="face front" data-side="A"><Cassette side="A" /></div>
            <div class="face back" data-side="B"><Cassette side="B" /></div>
          </div>
        </div>

        <div class="deck" id="deck" hidden>
          <div class="lcd" aria-live="polite">
            <div class="lcd-top">
              <span class="state" id="state">STOP</span>
              <span class="side-ind">SIDE <b id="side-ind">A</b></span>
              <span class="counter" id="counter">0:00</span>
            </div>
            <div class="np"><a id="np-title" href={now.url}>{now.name}</a> <span id="np-mix" class="np-mix">(Live)</span></div>
            <div class="np-blurb" id="np-blurb">{now.blurb}. Still playing.</div>
          </div>
          <div class="keys" role="group" aria-label="Transport">
            <button type="button" class="key" id="prev" aria-label="Previous track">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h2.5v14H6zM20 5v14L9.5 12z" /></svg>
            </button>
            <button type="button" class="key play" id="play" aria-label="Play">
              <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15L20 12z" /></svg>
              <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h4.5v14H6zM13.5 5H18v14h-4.5z" /></svg>
            </button>
            <button type="button" class="key" id="next" aria-label="Next track">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15.5 5H18v14h-2.5zM4 5v14l10.5-7z" /></svg>
            </button>
            <button type="button" class="key flip" id="flip" aria-label="Flip tape to side B">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9a8 8 0 0 1 14.3-3.2L20 4v6h-6l2.2-2.2A5.5 5.5 0 0 0 6.6 9zM20 15a8 8 0 0 1-14.3 3.2L4 20v-6h6l-2.2 2.2A5.5 5.5 0 0 0 17.4 15z" /></svg>
              <span>Flip</span>
            </button>
            <button type="button" class="key hiss" id="hiss" aria-pressed="false" aria-label="Tape hiss">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z" /><path class="waves" d="M16 9a4 4 0 0 1 0 6M18.5 6.5a7.5 7.5 0 0 1 0 11" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /><path class="mute" d="M16 9l5 6M21 9l-5 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
              <span>Hiss</span>
            </button>
          </div>
        </div>
      </section>

      <section class="jcard" aria-labelledby="artist">
        <div class="spine" aria-hidden="true"><span>BEN'S CAREER MIX vol.1</span><span>★ B.F.</span></div>
        <div class="panel">
          <header class="jhead">
            <h1 id="artist">{name}</h1>
            <p class="mixname">Career Mix <span>vol. 1</span></p>
          </header>

          <div class="sides">
            {sides.map(({ s, list }) => (
              <div class="side" data-side={s}>
                <h2>Side {s} <span>{s === 'A' ? 'recent' : 'early, plus sessions'}</span></h2>
                <ol>
                  {list.map((t, n) => (
                    <li class="track" data-i={t.i}>
                      <button type="button" class="cue" data-i={t.i} aria-label={`Play ${t.title}`} tabindex="-1">{s}{n + 1}</button>
                      <span class="num" aria-hidden="true">{s}{n + 1}</span>
                      <span class="ttl"><a href={t.url}>{t.title}</a>{t.mix && <span class="mix"> ({t.mix})</span>}</span>
                      <span class="dur">{t.durLabel ?? fmt(t.dur)}</span>
                    </li>
                  ))}
                </ol>
              </div>
            ))}
          </div>

          <div class="liner">
            <h2>Liner notes</h2>
            <p>Recorded over a few decades, mostly inside containers. Side A is the new stuff, starting with Replicate, where Ben is working now. Side B is from the vaults: Python, emulators, and a balloon or two.</p>
            <p class="bookings">For bookings: <a href={`mailto:${email}`}>{email}</a></p>
            <p class="fans">Fan club: {socials.map((s, n) => (<><a href={s.url}>{s.name} {s.handle}</a>{n < socials.length - 1 ? ' · ' : ''}</>))}</p>
            <p class="small">Please rewind before returning. Home taping is fine, actually.</p>
          </div>
        </div>
      </section>
    </main>

    <script type="application/json" id="tracks" set:html={JSON.stringify(data)} />

    <style is:global>
      :root { color-scheme: light; --bg: #f3c13a; --ink: #18181b; --pen: #1f2a6b; --red: #c8312b; }
      * { box-sizing: border-box; }
      body {
        margin: 0; min-height: 100vh; color: var(--ink); background: var(--bg);
        background-image: radial-gradient(circle at 20% 10%, rgba(255, 255, 255, 0.35), transparent 45%),
          radial-gradient(circle at 90% 100%, rgba(200, 80, 20, 0.18), transparent 50%);
        font-family: 'Archivo', system-ui, sans-serif;
        overflow-x: hidden;
      }
      a { color: inherit; }
      .marker { font-family: 'Permanent Marker', cursive; }
      .pen { font-family: 'Caveat', cursive; font-weight: 500; }
      .print { font-family: 'Archivo', system-ui, sans-serif; }
      .back {
        position: absolute; top: 14px; left: 16px; font-size: 13px; font-weight: 500; text-decoration: none;
        color: rgba(24, 24, 27, 0.6);
      }
      .back:hover { color: var(--ink); text-decoration: underline; }

      .wrap {
        max-width: 1240px; margin: 0 auto; padding: 72px 32px 80px;
        display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 56px; align-items: start;
      }
      .player { position: sticky; top: 40px; }

      .stage { perspective: 1800px; }
      .cassette {
        position: relative; transform-style: preserve-3d;
        transition: transform 1.1s cubic-bezier(0.55, -0.25, 0.3, 1.25);
      }
      .cassette.flipped { transform: rotateY(180deg); }
      .face { backface-visibility: hidden; -webkit-backface-visibility: hidden; }
      .face svg { display: block; width: 100%; height: auto; filter: drop-shadow(0 26px 30px rgba(80, 40, 0, 0.35)) drop-shadow(0 4px 6px rgba(0, 0, 0, 0.25)); }
      .face.back { position: absolute; inset: 0; transform: rotateY(180deg); }

      .deck {
        margin-top: 34px; background: #1b1b1f; color: #eee; border-radius: 16px; padding: 14px;
        display: grid; grid-template-columns: 1fr auto; gap: 14px; align-items: stretch;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 16px 30px -14px rgba(60, 30, 0, 0.6);
      }
      .js .deck[hidden] { display: grid; }
      .lcd {
        background: #9fb38a; color: #1e2a16; border-radius: 8px; padding: 10px 12px; min-width: 0;
        font-family: 'Space Mono', monospace; font-size: 12px;
        box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.35);
        background-image: linear-gradient(rgba(255, 255, 255, 0.12), transparent 60%);
      }
      .lcd-top { display: flex; justify-content: space-between; gap: 8px; letter-spacing: 0.08em; opacity: 0.85; }
      .state::before { content: "■ "; }
      .playing .state::before { content: "▶ "; }
      .counter { font-weight: 700; }
      .np { margin-top: 6px; font-size: 15px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .np a { text-decoration-thickness: 1px; text-underline-offset: 2px; }
      .np-mix { font-weight: 400; }
      .np-blurb { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; opacity: 0.8; }

      .keys { display: flex; gap: 6px; align-items: stretch; }
      .key {
        appearance: none; border: 0; cursor: pointer; color: #222; font: 700 11px/1 'Archivo', sans-serif;
        letter-spacing: 0.06em; text-transform: uppercase;
        width: 56px; border-radius: 6px 6px 10px 10px; display: grid; place-items: center; gap: 2px; padding: 10px 0 12px;
        background: linear-gradient(#f4f4f2, #c9c9c4);
        box-shadow: inset 0 -5px 0 rgba(0, 0, 0, 0.18), 0 2px 0 #000;
        transition: transform 0.06s, box-shadow 0.06s;
      }
      .key svg { width: 22px; height: 22px; fill: currentColor; }
      .key:active, .key[aria-pressed="true"], .playing .key.play {
        transform: translateY(3px); box-shadow: inset 0 -2px 0 rgba(0, 0, 0, 0.18), 0 0 0 #000;
        background: linear-gradient(#e2e2de, #bdbdb7);
      }
      .key:focus-visible { outline: 3px solid var(--bg); outline-offset: 2px; }
      .key.play { background: linear-gradient(#ff7a4d, #e24e1b); color: #fff; }
      .playing .key.play { background: linear-gradient(#e2531f, #c7410f); }
      .key .i-pause, .playing .key .i-play { display: none; }
      .playing .key .i-pause { display: block; }
      .key.flip.nudge { animation: nudge 1s ease-in-out infinite; }
      @keyframes nudge { 50% { transform: translateY(-4px) rotate(-4deg); } }
      .hiss .mute { display: block; } .hiss .waves { display: none; }
      .hiss[aria-pressed="true"] .mute { display: none; } .hiss[aria-pressed="true"] .waves { display: block; }

      /* the J-card */
      .jcard {
        display: grid; grid-template-columns: 40px 1fr; background: #fffdf6; color: var(--ink);
        box-shadow: 0 1px 0 rgba(0, 0, 0, 0.05), 0 24px 40px -18px rgba(80, 40, 0, 0.5);
        transform: rotate(1.2deg); border-radius: 2px; min-width: 0;
      }
      .spine {
        writing-mode: vertical-rl; transform: rotate(180deg); display: flex; justify-content: space-between;
        padding: 18px 0; font-family: 'Permanent Marker', cursive; font-size: 15px; color: #fff;
        background: linear-gradient(90deg, #f05a28 0 33%, #f9a03f 33% 66%, #2a9d8f 66%);
        text-align: center; align-items: center; letter-spacing: 0.04em;
      }
      .panel { padding: 26px 28px 28px; border-left: 1px dashed rgba(0, 0, 0, 0.25); min-width: 0; }
      .jhead { border-bottom: 3px solid var(--ink); padding-bottom: 10px; display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
      h1 { margin: 0; font-weight: 800; font-size: 30px; letter-spacing: -0.02em; line-height: 1; }
      .mixname { margin: 0; font-family: 'Permanent Marker', cursive; color: var(--pen); font-size: 22px; transform: rotate(-2deg); }
      .mixname span { color: var(--red); font-size: 0.8em; }

      .side { margin-top: 20px; }
      .side h2, .liner h2 {
        font-size: 12px; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; margin: 0 0 6px;
        display: flex; justify-content: space-between; gap: 8px;
      }
      .side h2 span { font-weight: 500; letter-spacing: 0.04em; text-transform: none; opacity: 0.6; }
      .side ol { list-style: none; margin: 0; padding: 0; }
      .track {
        position: relative; display: grid; grid-template-columns: 34px 1fr auto; gap: 8px; align-items: baseline;
        font-family: 'Caveat', cursive; font-size: 22px; line-height: 1.15; color: var(--pen);
        padding: 4px 0 3px; border-bottom: 1px solid rgba(31, 42, 107, 0.16);
      }
      .num, .cue { font-family: 'Archivo', sans-serif; font-size: 12px; font-weight: 800; color: var(--ink); opacity: 0.55; }
      .cue { display: none; }
      .js .cue {
        display: block; appearance: none; background: none; border: 0; padding: 0; cursor: pointer; text-align: left;
        grid-column: 1; grid-row: 1;
      }
      .js .num { display: none; }
      .cue:hover::before, .track.current .cue::before { content: "▶"; position: absolute; left: -16px; color: var(--red); opacity: 1; }
      .ttl a { text-decoration-thickness: 1px; text-underline-offset: 3px; text-decoration-color: rgba(31, 42, 107, 0.35); }
      .ttl a:hover { color: var(--red); }
      .mix { opacity: 0.7; font-size: 0.85em; }
      .dur { font-family: 'Space Mono', monospace; font-size: 12px; color: var(--ink); opacity: 0.6; }
      .track.current .ttl {
        background: linear-gradient(104deg, transparent 0.5%, rgba(255, 214, 0, 0.75) 2%, rgba(255, 214, 0, 0.55) 96%, transparent 98%);
        background-size: 100% 70%; background-position: 0 70%; background-repeat: no-repeat;
      }
      .track.current .cue { opacity: 1; color: var(--red); }

      .liner { margin-top: 24px; font-size: 14px; line-height: 1.5; }
      .liner p { margin: 0 0 8px; }
      .liner a { font-weight: 800; text-underline-offset: 3px; }
      .bookings { font-family: 'Permanent Marker', cursive; font-size: 18px; color: var(--red); margin-top: 12px !important; }
      .bookings a { color: var(--ink); font-family: 'Archivo', sans-serif; font-size: 16px; }
      .small { font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; opacity: 0.55; margin-top: 14px !important; }

      @media (max-width: 960px) {
        .wrap { grid-template-columns: 1fr; padding: 56px 16px 64px; gap: 40px; max-width: 640px; }
        .player { position: static; }
        .jcard { transform: rotate(0.6deg); }
      }
      @media (max-width: 520px) {
        .deck { grid-template-columns: 1fr; padding: 10px; }
        .keys { justify-content: space-between; }
        .key { flex: 1; width: auto; }
        .panel { padding: 20px 16px 20px; }
        .jcard { grid-template-columns: 30px 1fr; }
        .spine { font-size: 12px; }
        h1 { font-size: 26px; }
        .track { font-size: 21px; grid-template-columns: 28px 1fr auto; }
      }
      @media (prefers-reduced-motion: reduce) {
        .cassette { transition: none; }
        .key.flip.nudge { animation: none; outline: 3px solid var(--red); }
      }
    </style>

    <script>
      type T = { side: 'A' | 'B'; title: string; mix?: string; url: string; blurb: string; dur: number };
      const tracks: T[] = JSON.parse(document.getElementById('tracks')!.textContent!);
      document.documentElement.classList.add('js');

      const reduce = matchMedia('(prefers-reduced-motion: reduce)');
      const $ = (id: string) => document.getElementById(id)!;
      const cassette = $('cassette');
      const player = document.querySelector<HTMLElement>('.player')!;
      const flipBtn = $('flip');
      const SPEED = 24; // the tape runs at 24× (we haven't got all day)
      const HUB = 22, FULL = 62;

      const sideTracks = (s: 'A' | 'B') => tracks.map((t, i) => ({ ...t, i })).filter((t) => t.side === s);
      const total = (s: 'A' | 'B') => sideTracks(s).reduce((a, t) => a + t.dur, 0);
      const state = {
        side: 'A' as 'A' | 'B',
        pos: { A: 0, B: 0 } as Record<'A' | 'B', number>, // seconds into each side
        playing: false,
        angle: { A: [0, 0], B: [0, 0] } as Record<'A' | 'B', number[]>,
      };

      function locate(s: 'A' | 'B', pos: number) {
        let acc = 0;
        const list = sideTracks(s);
        for (const t of list) {
          if (pos < acc + t.dur) return { t, start: acc, elapsed: pos - acc };
          acc += t.dur;
        }
        const last = list[list.length - 1];
        return { t: last, start: acc - last.dur, elapsed: last.dur };
      }

      const faces = {
        A: document.querySelector<SVGElement>('.face[data-side=A]')!,
        B: document.querySelector<SVGElement>('.face[data-side=B]')!,
      };
      function radii(p: number) {
        // tape area is conserved: r² grows linearly with how much tape is on the reel
        const span = FULL * FULL - HUB * HUB;
        return [Math.sqrt(HUB * HUB + span * (1 - p)), Math.sqrt(HUB * HUB + span * p)];
      }
      function drawReels(s: 'A' | 'B') {
        const p = Math.min(1, state.pos[s] / total(s));
        const [l, r] = radii(p);
        const f = faces[s];
        f.querySelector('.pack-l')!.setAttribute('r', l.toFixed(2));
        f.querySelector('.pack-r')!.setAttribute('r', r.toFixed(2));
        f.querySelectorAll<SVGGElement>('.hub').forEach((h, n) => {
          h.setAttribute('transform', `rotate(${state.angle[s][n].toFixed(1)} ${h.dataset.cx} ${h.dataset.cy})`);
        });
      }

      let lastIdx = -1;
      function updateUI() {
        const s = state.side;
        const { t, elapsed } = locate(s, state.pos[s]);
        const secs = Math.floor(elapsed);
        $('counter').textContent = `${Math.floor(secs / 60)}:${String(secs % 60).padStart(2, '0')}`;
        $('side-ind').textContent = s;
        $('state').textContent = state.playing ? 'PLAY' : state.pos[s] >= total(s) ? 'END' : state.pos[s] > 0 ? 'PAUSE' : 'STOP';
        if (t.i !== lastIdx) {
          lastIdx = t.i;
          const a = $('np-title') as HTMLAnchorElement;
          a.textContent = t.title; a.href = t.url;
          $('np-mix').textContent = t.mix ? `(${t.mix})` : '';
          $('np-blurb').textContent = t.blurb.charAt(0).toUpperCase() + t.blurb.slice(1);
          document.querySelectorAll('.track').forEach((el) => el.classList.toggle('current', Number((el as HTMLElement).dataset.i) === t.i));
        }
        player.classList.toggle('playing', state.playing);
        $('play').setAttribute('aria-label', state.playing ? 'Pause' : 'Play');
        flipBtn.setAttribute('aria-label', `Flip tape to side ${s === 'A' ? 'B' : 'A'}`);
        flipBtn.classList.toggle('nudge', !state.playing && state.pos[s] >= total(s));
      }

      let last = 0;
      function tick(now: number) {
        if (!state.playing) return;
        const dt = Math.min(0.1, (now - last) / 1000);
        last = now;
        const s = state.side;
        state.pos[s] += dt * SPEED;
        if (state.pos[s] >= total(s)) {
          state.pos[s] = total(s);
          state.playing = false;
          sound.stop();
        }
        if (!reduce.matches) {
          // constant tape speed, so the emptier reel spins faster
          const p = Math.min(1, state.pos[s] / total(s));
          const [l, r] = radii(p);
          const v = 260 * dt;
          state.angle[s][0] += (v / l) * 57.3 * 0.6;
          state.angle[s][1] += (v / r) * 57.3 * 0.6;
        }
        drawReels(s);
        updateUI();
        if (state.playing) requestAnimationFrame(tick);
      }

      function play() {
        const s = state.side;
        if (state.pos[s] >= total(s)) state.pos[s] = 0; // auto-rewind, a luxury feature
        state.playing = true;
        last = performance.now();
        sound.start();
        updateUI();
        requestAnimationFrame(tick);
      }
      function pause() { state.playing = false; sound.stop(); updateUI(); }
      function cueTo(i: number, autoplay = true) {
        const t = tracks[i];
        if (t.side !== state.side) flip(false);
        const s = state.side;
        let acc = 0;
        for (const x of sideTracks(s)) { if (x.i === i) break; acc += x.dur; }
        state.pos[s] = acc + 0.01;
        drawReels(s);
        sound.click();
        if (autoplay && !state.playing) play(); else updateUI();
      }
      function skip(dir: 1 | -1) {
        const s = state.side;
        const { t, elapsed } = locate(s, state.pos[s]);
        const list = sideTracks(s);
        const k = list.findIndex((x) => x.i === t.i);
        if (dir === -1 && elapsed > 3) return cueTo(t.i, state.playing);
        const nk = k + dir;
        if (nk < 0) { state.pos[s] = 0; drawReels(s); updateUI(); return; }
        if (nk >= list.length) { state.pos[s] = total(s); pause(); drawReels(s); return; }
        cueTo(list[nk].i, state.playing);
      }
      function flip(resume = true) {
        const wasPlaying = state.playing;
        if (wasPlaying) pause();
        state.side = state.side === 'A' ? 'B' : 'A';
        cassette.classList.toggle('flipped', state.side === 'B');
        lastIdx = -1;
        drawReels(state.side);
        updateUI();
        if (resume && wasPlaying) setTimeout(play, reduce.matches ? 0 : 1100);
      }

      // Sound: a little tape hiss and a mechanical clunk. Muted until asked.
      const sound = (() => {
        let ctx: AudioContext | null = null;
        let hiss: AudioBufferSourceNode | null = null;
        let gain: GainNode | null = null;
        let on = false;
        function ensure() {
          if (ctx) return ctx;
          ctx = new AudioContext();
          gain = ctx.createGain();
          gain.gain.value = 0;
          const f = ctx.createBiquadFilter();
          f.type = 'highpass'; f.frequency.value = 3500;
          gain.connect(ctx.destination);
          f.connect(gain);
          const buf = ctx.createBuffer(1, ctx.sampleRate * 2, ctx.sampleRate);
          const d = buf.getChannelData(0);
          for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;
          hiss = ctx.createBufferSource();
          hiss.buffer = buf; hiss.loop = true; hiss.connect(f); hiss.start();
          return ctx;
        }
        function click() {
          if (!on || !ctx) return;
          const o = ctx.createOscillator(); const g = ctx.createGain();
          o.type = 'square'; o.frequency.value = 90;
          g.gain.setValueAtTime(0.08, ctx.currentTime);
          g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.07);
          o.connect(g).connect(ctx.destination); o.start(); o.stop(ctx.currentTime + 0.08);
        }
        return {
          toggle() { on = !on; if (on) { ensure(); ctx!.resume(); if (state.playing) this.start(); } else this.stop(true); return on; },
          start() { if (!on || !ctx) return; click(); gain!.gain.setTargetAtTime(0.035, ctx.currentTime, 0.05); },
          stop(silent = false) { if (!ctx || !gain) return; if (!silent) click(); gain.gain.setTargetAtTime(0, ctx.currentTime, 0.05); },
          click,
        };
      })();

      $('play').addEventListener('click', () => (state.playing ? pause() : play()));
      $('next').addEventListener('click', () => skip(1));
      $('prev').addEventListener('click', () => skip(-1));
      flipBtn.addEventListener('click', () => { sound.click(); flip(); });
      $('hiss').addEventListener('click', (e) => {
        const on = sound.toggle();
        (e.currentTarget as HTMLElement).setAttribute('aria-pressed', String(on));
      });
      document.querySelectorAll<HTMLButtonElement>('.cue').forEach((b) => {
        b.tabIndex = 0;
        b.addEventListener('click', () => cueTo(Number(b.dataset.i)));
      });
      document.addEventListener('keydown', (e) => {
        if (e.target instanceof HTMLElement && e.target.closest('a, button, input')) return;
        if (e.key === ' ') { e.preventDefault(); state.playing ? pause() : play(); }
        if (e.key === 'ArrowRight') skip(1);
        if (e.key === 'ArrowLeft') skip(-1);
        if (e.key.toLowerCase() === 'f') flip();
      });

      drawReels('A'); drawReels('B');
      updateUI();
    </script>
  </body>
</html>
