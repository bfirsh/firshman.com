---
import { name, email, now, projects, alsoWorkedOn, socials } from '../../data/bio';
import { palettes } from '../../components/ideas/mycelium/palettes';

const p = Object.fromEntries(projects.map((x) => [x.slug, x]));
const [gov, guardian, jam, lanyrd, spacelog] = alsoWorkedOn;
const x = socials.find((s) => s.name === 'X')!;
const gh = socials.find((s) => s.name === 'GitHub')!;
const li = socials.find((s) => s.name === 'LinkedIn')!;
const textColours = palettes.map((c) => [c.ramp[0], c.text, c.dim, c.light ? 1 : 0]);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ben Firshman</title>
    <meta name="description" content="Ben Firshman is working on Replicate. Previously Docker Compose, Cog, JSNES, arXiv Vanity and more." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <script is:inline define:vars={{ textColours }}>
      (function () {
        var q = new URLSearchParams(location.search);
        var seed = parseInt(q.get('seed') || '', 10);
        if (!(seed > 0)) seed = 1 + Math.floor(Math.random() * 99999);
        var a = seed;
        a |= 0; a = (a + 0x6d2b79f5) | 0;
        var t = Math.imul(a ^ (a >>> 15), 1 | a);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        var r = ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        var c = textColours[Math.floor(r * textColours.length)];
        var s = document.documentElement.style;
        s.setProperty('--bg', c[0]); s.setProperty('--ink', c[1]); s.setProperty('--dim', c[2]);
        document.documentElement.dataset.seed = String(seed);
        if (c[3]) document.documentElement.classList.add('light');
      })();
    </script>
  </head>
  <body>
    <canvas id="mould" aria-hidden="true"></canvas>
    <main id="text">
      <h1>{name}</h1>

      <p>I'm working on <a href={now.url}>{now.name}</a>. Some other stuff I've done:</p>

      <ul>
        <li><a href={p.cog.url}>{p.cog.name}</a>, {p.cog.blurb}.</li>
        <li><a href={p.clig.url}>{p.clig.name}</a>, {p.clig.blurb}.</li>
        <li><a href={p.compose.url}>{p.compose.name}</a> and <a href={p.machine.url}>{p.machine.name}</a>.</li>
        <li><a href={p.jsnes.url}>{p.jsnes.name}</a>, {p.jsnes.blurb}.</li>
        <li><a href={p.whalebrew.url}>{p.whalebrew.name}</a>, {p.whalebrew.blurb}.</li>
        <li><a href={p['arxiv-vanity'].url}>{p['arxiv-vanity'].name}</a>, which {p['arxiv-vanity'].blurb}.</li>
        <li>I worked on <a href={gov.url}>{gov.name}</a>, <a href={guardian.url}>{guardian.name}</a>, <a href={jam.url}>{jam.name}</a>, <a href={lanyrd.url}>{lanyrd.name}</a>, and <a href={spacelog.url}>{spacelog.name}</a>.</li>
        <li>I worked on many parts of <a href={p.django.url}>{p.django.name}</a>, including class-based views, feeds, and search.</li>
        <li>I helped start the <a href={p.ukhas.url}>{p.ukhas.name}</a>, a group for amateur near-space exploration.</li>
      </ul>

      <p>Email me at <a href={`mailto:${email}`}>{email}</a>.<br />
        I'm also on <a href={x.url}>{x.name}</a>, <a href={gh.url}>{gh.name}</a>, and <a href={li.url}>{li.name}</a>.</p>
    </main>
    <footer class="edition">
      <button type="button" id="edition" title="Copy a link to this edition" hidden></button>
      <a href="/ideas">ideas</a>
    </footer>

    <script>
      import { start } from '../../components/ideas/mycelium/sim';

      const seed = +(document.documentElement.dataset.seed || 1);
      const btn = document.getElementById('edition') as HTMLButtonElement;
      const label = `No. ${seed}`;
      btn.textContent = label;
      btn.hidden = false;
      btn.addEventListener('click', async () => {
        const url = `${location.origin}${location.pathname}?seed=${seed}`;
        try { await navigator.clipboard.writeText(url); btn.textContent = 'copied'; }
        catch { history.replaceState(null, '', `?seed=${seed}`); btn.textContent = 'link in address bar'; }
        setTimeout(() => (btn.textContent = label), 1400);
      });

      const canvas = document.getElementById('mould') as HTMLCanvasElement;
      const go = () => {
        try {
          if (start(canvas, document.getElementById('text')!, seed)) canvas.classList.add('on');
        } catch (e) {
          console.warn('mycelium: no WebGL2', e);
        }
      };
      const fonts = (document as any).fonts?.ready ?? Promise.resolve();
      Promise.race([fonts, new Promise((r) => setTimeout(r, 1200))]).then(() => requestAnimationFrame(go));
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #06070b;
    --ink: #f1e6cf;
    --dim: #b9a988;
    color-scheme: dark;
  }
  :root.light { color-scheme: light; }
  * { box-sizing: border-box; }
  html { background: var(--bg); }
  body {
    margin: 0;
    position: relative;
    min-height: 100vh;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Instrument Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    font-size: 17px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    overflow-x: hidden;
  }
  #mould {
    position: absolute;
    left: 0;
    top: 0;
    display: block;
    opacity: 0;
    transition: opacity 1.2s ease;
    pointer-events: none;
  }
  #mould.on { opacity: 1; }
  main {
    position: relative;
    max-width: 31rem;
    padding: clamp(56px, 13vh, 150px) 24px 96px clamp(24px, 8vw, 132px);
    box-sizing: content-box;
  }
  h1 {
    font-size: 2.05rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 1.6rem;
  }
  p { margin: 0 0 1.2rem; }
  ul { list-style: none; margin: 0 0 1.5rem; padding: 0; }
  li { margin: 0 0 0.7rem; }
  a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--ink) 38%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.2s;
  }
  a:hover, a:focus-visible { text-decoration-color: var(--ink); }
  li, main > p { color: color-mix(in srgb, var(--ink) 86%, var(--dim)); }
  .edition {
    position: fixed;
    right: 18px;
    bottom: 14px;
    display: flex;
    gap: 14px;
    align-items: baseline;
    font-size: 11px;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }
  .edition button, .edition a {
    font: inherit;
    color: var(--ink);
    background: none;
    border: 0;
    padding: 4px 0;
    cursor: pointer;
    text-decoration: none;
    opacity: 0.4;
    transition: opacity 0.3s;
  }
  .edition a { opacity: 0.14; }
  .edition button:hover, .edition button:focus-visible, .edition a:hover, .edition a:focus-visible { opacity: 0.9; }
  @media (max-width: 600px) {
    body { font-size: 16px; }
    main { padding: 56px 22px 88px; max-width: none; }
    h1 { font-size: 1.75rem; }
    .edition { position: absolute; bottom: 14px; right: 22px; }
  }
</style>
