---
import { projects, now, email, socials, alsoWorkedOn, name } from '../../data/bio';
const order = ['cog', 'clig', 'compose', 'machine', 'whalebrew', 'arxiv-vanity', 'django', 'jsnes', 'ukhas'];
const ordered = order.map((s) => projects.find((p) => p.slug === s)!).filter(Boolean);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Ben Firshman — Orrery</title>
    <meta name="description" content="Ben Firshman's projects as a brass clockwork orrery. Replicate is the sun; Cog, Docker Compose, JSNES and friends orbit it. Click a planet to fly to it." />
    <meta name="theme-color" content="#060504" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <canvas id="sky" aria-hidden="true"></canvas>
    <div id="labels" aria-label="Bodies in the orrery" role="group"></div>

    <header class="plate">
      <p class="eyebrow">An orrery of the works of</p>
      <h1>{name}</h1>
      <p class="sub">Currently orbiting <a href={now.url}>{now.name}</a>, which helps you {now.blurb}.</p>
    </header>

    <nav class="corner">
      <a href="/ideas" class="ghost">← all ideas</a>
      <button type="button" id="listBtn" class="ghost" aria-expanded="false" aria-controls="list">List view</button>
    </nav>

    <aside id="card" class="card" aria-live="polite" hidden></aside>

    <footer class="dock">
      <button type="button" id="pause" class="knob" aria-pressed="false" aria-label="Pause the orrery">
        <svg viewBox="0 0 20 20" aria-hidden="true"><g class="i-pause"><rect x="5" y="4" width="3.2" height="12" rx="1"/><rect x="11.8" y="4" width="3.2" height="12" rx="1"/></g><path class="i-play" d="M6 4l10 6-10 6z"/></svg>
      </button>
      <label class="clock" for="speed">
        <span class="clock-name">Clockwork</span>
        <input id="speed" type="range" min="0" max="100" value="40" step="1" aria-valuetext="1 times speed" />
        <output id="speedOut" for="speed">×1.0</output>
      </label>
      <p class="hint" id="hint"><span class="wide">Drag to look around · </span>tap a planet<span class="wide"> · catch the comet</span></p>
    </footer>

    <section id="list" class="list" aria-label="Everything, as a list">
      <div class="list-inner">
        <button type="button" class="ghost close" id="listClose">Back to the orrery</button>
        <h2>{name}</h2>
        <p>I'm working on <a href={now.url}>{now.name}</a>, to {now.blurb}. The planets:</p>
        <ul>
          {ordered.map((p) => <li><a href={p.url}>{p.name}</a>, {p.blurb}.</li>)}
        </ul>
        <p>The asteroid belt (I also worked on): {alsoWorkedOn.map((a, i) => <>{i > 0 && (i === alsoWorkedOn.length - 1 ? ', and ' : ', ')}<a href={a.url}>{a.name}</a></>)}.</p>
        <p>The comet: email <a href={`mailto:${email}`}>{email}</a>, or find me on {socials.map((s, i) => <>{i > 0 && (i === socials.length - 1 ? ', and ' : ', ')}<a href={s.url}>{s.name}</a></>)}.</p>
      </div>
    </section>

    <noscript><style>#sky, #labels, .dock, #listBtn, .close { display: none !important; } .list { position: static; opacity: 1; visibility: visible; background: none; }</style></noscript>

    <style is:global>
      :root {
        color-scheme: dark;
        --ink: #f3ead6;
        --dim: rgba(243, 234, 214, 0.62);
        --brass: #d4ad5e;
        --brass-hi: #f4dc9a;
        --brass-lo: #8b6a2f;
        --panel: rgba(12, 10, 7, 0.78);
        --bg: #060504;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; height: 100%; overflow: hidden; background: var(--bg); color: var(--ink); }
      body { font: 500 18px/1.4 'Cormorant Garamond', Georgia, serif; -webkit-font-smoothing: antialiased; touch-action: none; }
      a { color: var(--brass-hi); text-decoration-thickness: 1px; text-underline-offset: 3px; }
      a:hover { color: #fff3cf; }
      :focus-visible { outline: 2px solid var(--brass-hi); outline-offset: 3px; }
      #sky { position: fixed; inset: 0; width: 100%; height: 100%; display: block; cursor: grab; }
      #sky.hot { cursor: pointer; }
      #sky:active { cursor: grabbing; }

      .plate { position: fixed; top: 28px; left: 32px; max-width: 420px; pointer-events: none; z-index: 3; }
      .plate a { pointer-events: auto; }
      .eyebrow { margin: 0 0 6px; font: 600 11px/1 'Cinzel', serif; letter-spacing: 0.32em; text-transform: uppercase; color: var(--dim); }
      .plate h1 {
        margin: 0; font: 700 40px/1 'Cinzel', serif; letter-spacing: 0.08em; text-transform: uppercase;
        background: linear-gradient(180deg, #fff1c2 0%, #e2bd6c 45%, #9c7634 55%, #e9c97c 100%);
        -webkit-background-clip: text; background-clip: text; color: transparent;
        filter: drop-shadow(0 2px 0 rgba(0,0,0,0.6));
      }
      .sub { margin: 10px 0 0; font-style: italic; font-size: 19px; color: var(--dim); max-width: 340px; }

      .corner { position: fixed; top: 24px; right: 24px; display: flex; gap: 8px; z-index: 6; }
      .ghost {
        appearance: none; background: rgba(10, 8, 5, 0.55); color: var(--ink); border: 1px solid rgba(212, 173, 94, 0.45);
        border-radius: 999px; padding: 8px 14px; font: 600 11px/1 'Cinzel', serif; letter-spacing: 0.16em; text-transform: uppercase;
        text-decoration: none; cursor: pointer; white-space: nowrap; backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
      }
      .ghost:hover { border-color: var(--brass-hi); color: #fff; }

      #labels { position: fixed; inset: 0; pointer-events: none; z-index: 2; overflow: hidden; }
      .lbl {
        position: absolute; left: 0; top: 0; pointer-events: auto; appearance: none; background: none; border: 0; padding: 10px 8px;
        color: var(--brass-hi); font: 600 10.5px/1 'Cinzel', serif; letter-spacing: 0.2em; text-transform: uppercase; white-space: nowrap;
        cursor: pointer; text-shadow: 0 1px 6px #000, 0 0 2px #000; opacity: 0; visibility: hidden; transition: opacity 0.5s, visibility 0.5s; will-change: transform;
      }
      .lbl::before { content: ""; display: inline-block; width: 5px; height: 5px; border: 1px solid currentColor; transform: rotate(45deg) translateY(-1px); margin-right: 8px; }
      .lbl.on { opacity: 0.88; visibility: visible; }
      .lbl.on:hover, .lbl.on.hot, .lbl.on:focus-visible { opacity: 1; color: #fff; }
      .lbl.comet { color: #cfe6ff; }
      .lbl.sun { color: #ffe2a0; }

      .dock {
        position: fixed; left: 50%; bottom: max(22px, env(safe-area-inset-bottom)); transform: translateX(-50%); z-index: 4;
        display: flex; align-items: center; gap: 14px; padding: 8px 18px 8px 8px; border-radius: 999px;
        background: var(--panel); border: 1px solid rgba(212, 173, 94, 0.35); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
        box-shadow: 0 10px 40px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255, 230, 170, 0.08);
        transition: opacity 0.4s, transform 0.4s;
      }
      .knob {
        width: 38px; height: 38px; border-radius: 50%; border: 0; cursor: pointer; display: grid; place-items: center; flex: none;
        background: radial-gradient(circle at 35% 30%, #fbe7ad, #c99a45 45%, #7a5823 100%); color: #2a1d08;
        box-shadow: inset 0 -2px 3px rgba(0,0,0,0.35), 0 2px 6px rgba(0,0,0,0.5);
      }
      .knob svg { width: 16px; height: 16px; fill: currentColor; }
      .knob .i-play { display: none; }
      .knob[aria-pressed="true"] .i-play { display: block; }
      .knob[aria-pressed="true"] .i-pause { display: none; }
      .clock { display: flex; align-items: center; gap: 12px; }
      .clock-name { font: 600 10.5px/1 'Cinzel', serif; letter-spacing: 0.22em; text-transform: uppercase; color: var(--dim); }
      .clock output { font: 600 12px/1 'Cinzel', serif; letter-spacing: 0.08em; color: var(--brass-hi); min-width: 42px; font-variant-numeric: tabular-nums; }
      input[type=range] { -webkit-appearance: none; appearance: none; width: 170px; height: 24px; background: none; margin: 0; cursor: pointer; }
      input[type=range]::-webkit-slider-runnable-track {
        height: 4px; border-radius: 4px;
        background: repeating-linear-gradient(90deg, rgba(244, 220, 154, 0.55) 0 1px, transparent 1px 10px), linear-gradient(90deg, #5d4519, #c49a4a);
      }
      input[type=range]::-moz-range-track { height: 4px; border-radius: 4px; background: linear-gradient(90deg, #5d4519, #c49a4a); }
      input[type=range]::-webkit-slider-thumb {
        -webkit-appearance: none; width: 18px; height: 18px; margin-top: -7px; border-radius: 50%;
        background: radial-gradient(circle at 35% 30%, #fff1c4, #d4a54d 50%, #7a5823); box-shadow: 0 1px 4px rgba(0,0,0,0.7);
      }
      input[type=range]::-moz-range-thumb { width: 18px; height: 18px; border: 0; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #fff1c4, #d4a54d 50%, #7a5823); }
      .hint { margin: 0; font-style: italic; font-size: 16px; color: var(--dim); white-space: nowrap; }

      .card {
        position: fixed; z-index: 5; right: 40px; top: 50%; width: 360px; transform: translateY(-50%);
        padding: 26px 28px 24px; border-radius: 4px; background: var(--panel);
        border: 1px solid rgba(212, 173, 94, 0.55); box-shadow: inset 0 0 0 4px rgba(10, 8, 5, 0.6), inset 0 0 0 5px rgba(212, 173, 94, 0.25), 0 30px 80px rgba(0,0,0,0.6);
        backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
        animation: cardIn 0.6s cubic-bezier(.2,.8,.2,1) both;
      }
      @keyframes cardIn { from { opacity: 0; transform: translateY(-50%) translateX(24px); } }
      .card .k { margin: 0 0 10px; font: 600 10.5px/1 'Cinzel', serif; letter-spacing: 0.3em; text-transform: uppercase; color: var(--brass); }
      .card h2 { margin: 0; font: 600 34px/1.02 'Cormorant Garamond', serif; color: var(--ink); }
      .card .b { margin: 10px 0 18px; font-style: italic; font-size: 20px; line-height: 1.3; color: var(--dim); }
      .card dl { margin: 0 0 20px; padding: 12px 0 0; border-top: 1px solid rgba(212, 173, 94, 0.25); display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; }
      .card dt { font: 600 10px/1.7 'Cinzel', serif; letter-spacing: 0.2em; text-transform: uppercase; color: var(--brass); white-space: nowrap; }
      .card dd { margin: 0; font-size: 17px; line-height: 1.3; }
      .card ul { margin: 0 0 20px; padding: 0; list-style: none; display: grid; gap: 6px; }
      .card ul a { font-size: 20px; }
      .card .go {
        display: inline-flex; align-items: center; gap: 8px; padding: 11px 16px; border-radius: 2px; text-decoration: none;
        font: 600 11px/1 'Cinzel', serif; letter-spacing: 0.18em; text-transform: uppercase; color: #20160a;
        background: linear-gradient(180deg, #f6dfa0, #c8994a); box-shadow: inset 0 -1px 0 rgba(0,0,0,0.25), 0 3px 10px rgba(0,0,0,0.4);
      }
      .card .go:hover { color: #000; filter: brightness(1.08); }
      .card .back { position: absolute; top: 14px; right: 14px; padding: 7px 10px; font-size: 10px; }
      .card .host { display: block; margin-top: 10px; font-size: 15px; color: var(--dim); word-break: break-all; }

      .list {
        position: fixed; inset: 0; z-index: 8; overflow-y: auto; background: rgba(6, 5, 4, 0.94);
        opacity: 0; visibility: hidden; transition: opacity 0.3s, visibility 0.3s;
      }
      html:not(.js) .list, .list.open { opacity: 1; visibility: visible; }
      .list-inner { max-width: 640px; margin: 0 auto; padding: 80px 24px 60px; font-size: 21px; line-height: 1.45; }
      .list h2 { font: 700 30px/1 'Cinzel', serif; letter-spacing: 0.08em; text-transform: uppercase; color: var(--brass-hi); margin: 0 0 18px; }
      .list ul { padding-left: 1.1em; }
      .list li { margin: 6px 0; }
      .close { position: absolute; top: 24px; left: 24px; }

      .fallback .dock, .fallback #listBtn, .fallback .close { display: none; }

      @media (max-width: 720px) {
        .plate { top: 18px; left: 18px; right: 18px; max-width: none; }
        .plate h1 { font-size: 27px; }
        .eyebrow { font-size: 9.5px; letter-spacing: 0.26em; }
        .sub { font-size: 16px; max-width: 250px; }
        .corner { top: auto; bottom: calc(max(18px, env(safe-area-inset-bottom)) + 64px); right: 50%; transform: translateX(50%); }
        .dock { bottom: max(16px, env(safe-area-inset-bottom)); padding-right: 14px; gap: 10px; max-width: calc(100vw - 24px); }
        input[type=range] { width: 120px; }
        .hint { display: none; }
        .card {
          left: 12px; right: 12px; top: auto; bottom: 12px; width: auto; transform: none; padding: 20px 20px 18px;
          max-height: 52vh; overflow-y: auto; animation-name: sheetIn;
        }
        @keyframes sheetIn { from { opacity: 0; transform: translateY(30px); } }
        .card h2 { font-size: 28px; padding-right: 70px; }
        .card .b { font-size: 18px; margin-bottom: 12px; }
        .focus .dock, .focus .corner { opacity: 0; pointer-events: none; }
        .focus .plate { opacity: 0; }
      }
      .plate { transition: opacity 0.4s; }
      @media (max-width: 720px) and (max-height: 700px) { .sub { display: none; } }
      .wide { display: inline; }
      @media (max-width: 1000px) { .wide { display: none; } }
      @media (prefers-reduced-motion: reduce) {
        .card { animation: none; }
        .lbl, .list, .dock { transition: none; }
      }
    </style>

    <script>
      import '../../components/ideas/solar/orrery.ts';
    </script>
  </body>
</html>
