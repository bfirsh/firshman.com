---
import { projects, now, email, socials, alsoWorkedOn, name } from '../../data/bio';

const host = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const data = { projects, now, email, socials, alsoWorkedOn, name };
const PS1 = 'ben@firshman.com:~$';
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ben Firshman — Shell</title>
    <meta name="description" content="Ben Firshman's homepage as an interactive shell. Type help, or just tap the commands." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
      try { if (localStorage.getItem('shell:nocolor') === '1') document.documentElement.classList.add('no-color'); } catch (e) {}
    </script>
  </head>
  <body>
    <div class="term" id="term">
      <header class="bar">
        <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="title">ben@firshman.com: ~<span class="title-x"> — sh — 80×24-ish</span></span>
        <a class="back" href="/ideas">← all ideas</a>
      </header>

      <div class="screen" id="screen">
        <div class="out" id="out" role="log" aria-live="polite" aria-relevant="additions">
          <div class="block boot">
            <p class="dim" style="--i:0">firshman.com shell 1.0 (tty1)</p>
            <p class="dim" style="--i:1">Last login: just now, from somewhere on the internet</p>
            <p style="--i:2">&nbsp;</p>
            <p style="--i:3">Welcome. Type <code class="c-cmd">help</code> to see what's here, or tap a command at the bottom.</p>
            <p class="dim" style="--i:4">Tab completes. ↑ remembers. Nothing here can hurt you.</p>
          </div>

          <div class="block" style="--i:5">
            <p class="cmdline"><span class="ps1">{PS1}</span> whoami</p>
            <p><strong class="c-hi">{name}</strong></p>
            <p>I'm working on <a href={now.url}>{now.name}</a>, {now.blurb}.</p>
          </div>

          <div class="block" style="--i:6">
            <p class="cmdline"><span class="ps1">{PS1}</span> ls projects</p>
            <ul class="ls">
              {projects.map((p) => (
                <li>
                  <a class="slug" href={p.url}>{p.slug}</a>
                  <span class="blurb">{p.name.toLowerCase() !== p.slug && <><b>{p.name}</b>, </>}{p.blurb}</span>
                </li>
              ))}
            </ul>
            <p class="dim hint">Also worked on: {alsoWorkedOn.map((a, i) => (<>{i > 0 && ', '}<a href={a.url}>{a.name}</a></>))}.</p>
          </div>

          <div class="block" style="--i:7">
            <p class="cmdline"><span class="ps1">{PS1}</span> contact</p>
            <p>email&nbsp;&nbsp;&nbsp; <a href={`mailto:${email}`}>{email}</a></p>
            {socials.map((s) => (
              <p>{s.name.toLowerCase().padEnd(9, ' ')}<a href={s.url}>{s.handle}</a></p>
            ))}
          </div>
        </div>

        <form class="prompt" id="prompt" autocomplete="off">
          <label for="cmd" class="ps1" id="ps1">{PS1}</label>
          <input id="cmd" name="cmd" type="text" spellcheck="false" autocapitalize="off" autocorrect="off" enterkeyhint="go" aria-label="Command" />
        </form>
      </div>

      <nav class="chips" aria-label="Suggested commands">
        <span class="chips-label">try →</span>
        <button type="button" data-cmd="help">help</button>
        <button type="button" data-cmd="cat cog">cat cog</button>
        <button type="button" data-cmd="man ben">man ben</button>
        <button type="button" data-cmd="ls also">ls also</button>
        <button type="button" data-cmd="open replicate">open replicate</button>
        <button type="button" data-cmd="contact">contact</button>
        <button type="button" data-cmd="history">history</button>
        <button type="button" data-cmd="color off" id="chip-color">color off</button>
        <button type="button" data-cmd="sudo make me a sandwich">sudo make me a sandwich</button>
        <button type="button" data-cmd="rm -rf /" class="danger">rm -rf /</button>
        <button type="button" data-cmd="clear">clear</button>
      </nav>
    </div>

    <script type="application/json" id="shell-data" set:html={JSON.stringify(data)}></script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0e0f0c;
    --bg2: #161813;
    --fg: #e9e6da;
    --dim: #8a877c;
    --hi: #ffffff;
    --green: #9be36a;
    --cyan: #6fd6e8;
    --yellow: #f5c84b;
    --red: #ff6b5e;
    --magenta: #d59bff;
    --sel: #3b4a2a;
    color-scheme: dark;
  }
  html.no-color {
    --green: var(--fg);
    --cyan: var(--fg);
    --yellow: var(--fg);
    --red: var(--fg);
    --magenta: var(--fg);
    --hi: var(--fg);
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; height: 100%; background: var(--bg); }
  body {
    color: var(--fg);
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 15px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  ::selection { background: var(--sel); color: var(--hi); }
  a { color: var(--cyan); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  a:hover { color: var(--hi); background: color-mix(in srgb, var(--cyan) 25%, transparent); }
  html.no-color a { text-decoration-style: dotted; }
  p { margin: 0; }
  code { font: inherit; }
  b, strong { font-weight: 700; }

  .term {
    height: 100vh;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    max-width: 100%;
  }
  .bar {
    display: flex; align-items: center; gap: 14px;
    padding: 8px 16px;
    background: var(--bg2);
    border-bottom: 1px solid #23261e;
    font-size: 12px;
    color: var(--dim);
    flex: none;
  }
  .lights { display: flex; gap: 7px; }
  .lights i { width: 11px; height: 11px; border-radius: 50%; background: #34372e; display: block; }
  .title { flex: 1; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .back { color: var(--dim); text-decoration: none; white-space: nowrap; }
  .back:hover { color: var(--fg); background: none; }

  .screen {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 20px 24px 12px;
    cursor: text;
    scrollbar-color: #34372e transparent;
  }
  .out { max-width: 92ch; }
  .block { margin-bottom: 1.1em; }
  .block > * + * { margin-top: 0; }
  .cmdline { color: var(--fg); }
  .ps1 { color: var(--green); font-weight: 700; white-space: nowrap; }
  .dim { color: var(--dim); }
  .c-hi { color: var(--hi); }
  .c-cmd { color: var(--yellow); }
  .c-err { color: var(--red); }
  .c-ok { color: var(--green); }
  .c-warn { color: var(--yellow); }
  .c-mag { color: var(--magenta); }
  .c-cyan { color: var(--cyan); }
  .hint { margin-top: .6em; }

  .ls { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: max-content 1fr; column-gap: 2.5ch; }
  .ls li { display: contents; }
  .ls .slug { color: var(--cyan); font-weight: 700; }
  .ls .blurb { color: var(--fg); }
  .ls .blurb b { color: var(--hi); font-weight: 400; }

  .pre { white-space: pre-wrap; overflow-wrap: anywhere; }
  .grid2 { display: grid; grid-template-columns: max-content 1fr; column-gap: 3ch; }
  .man h4 { margin: 1em 0 0; font-weight: 700; color: var(--hi); font-size: inherit; }
  .man h4:first-child { margin-top: 0; }
  .man .ind { padding-left: 4ch; max-width: 72ch; }
  .card { border-left: 2px solid var(--green); padding: 2px 0 2px 2ch; margin: 2px 0; }
  .card .name { color: var(--hi); font-weight: 700; }
  .tag { color: var(--magenta); }
  .run {
    font: inherit; color: var(--yellow); background: none; border: 0; padding: 0; cursor: pointer;
    text-decoration: underline dotted; text-underline-offset: 3px;
  }
  .run:hover { color: var(--hi); background: color-mix(in srgb, var(--yellow) 22%, transparent); }
  .run:focus-visible, .chips button:focus-visible, a:focus-visible { outline: 2px solid var(--yellow); outline-offset: 2px; }

  .prompt { display: flex; gap: 1ch; align-items: baseline; margin-bottom: 8px; }
  .prompt input {
    flex: 1; min-width: 0;
    font: inherit; color: var(--hi);
    background: transparent; border: 0; outline: 0; padding: 0;
    caret-color: var(--green);
    caret-shape: block;
  }
  .prompt.confirm .ps1 { color: var(--red); }
  .no-js .prompt, .no-js .chips { display: none; }

  .chips {
    flex: none;
    display: flex; gap: 8px; align-items: center;
    padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
    border-top: 1px solid #23261e;
    background: var(--bg2);
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .chips::-webkit-scrollbar { display: none; }
  .chips-label { color: var(--dim); font-size: 12px; white-space: nowrap; }
  .chips button {
    font: inherit; font-size: 13px;
    white-space: nowrap;
    color: var(--fg);
    background: transparent;
    border: 1px solid #3a3d33;
    border-radius: 999px;
    padding: 4px 12px;
    cursor: pointer;
    transition: border-color .15s, color .15s, background .15s;
  }
  .chips button::before { content: "$ "; color: var(--green); }
  .chips button:hover { border-color: var(--green); color: var(--hi); }
  .chips button.danger:hover { border-color: var(--red); }

  /* boot-in */
  .js .boot p, .js .out > .block:not(.boot) { animation: appear .01s steps(1) backwards; animation-delay: calc(var(--i) * 90ms); }
  @keyframes appear { from { visibility: hidden; } }

  /* rm -rf / */
  .term.melt .out { animation: melt 1.1s ease-in forwards; transform-origin: top; }
  @keyframes melt {
    0% { transform: none; filter: none; opacity: 1; }
    30% { transform: skewX(-4deg); filter: blur(.4px); }
    100% { transform: translateY(40vh) skewY(6deg) scaleY(.2); filter: blur(3px); opacity: 0; }
  }
  .term.shake { animation: shake .35s; }
  @keyframes shake { 25% { transform: translateX(-4px); } 50% { transform: translateX(4px); } 75% { transform: translateX(-2px); } }

  @media (prefers-reduced-motion: reduce) {
    .js .boot p, .js .out > .block:not(.boot) { animation: none; }
    .term.melt .out { animation: none; opacity: 0; }
    .term.shake { animation: none; }
  }

  @media (max-width: 600px) {
    body { font-size: 13px; }
    .screen { padding: 14px 16px 10px; }
    .bar { padding: 8px 16px; }
    .title { text-align: left; }
    .lights, .title-x { display: none; }
    .ls { grid-template-columns: 1fr; }
    .ls .blurb { margin-bottom: .35em; padding-left: 2ch; color: var(--dim); }
    .ls .blurb b { color: var(--fg); }
    .grid2 { grid-template-columns: 1fr; }
    .grid2 > :nth-child(2n) { padding-left: 2ch; margin-bottom: .3em; }
    .man .ind { padding-left: 2ch; }
  }
  /* no-js: let the document breathe instead of a fixed screen */
  .no-js .term { height: auto; min-height: 100vh; }
</style>

<script>
  type Project = { slug: string; name: string; url: string; blurb: string; era: string; tags: string[] };
  type Data = {
    projects: Project[];
    now: { name: string; url: string; blurb: string };
    email: string;
    socials: { name: string; handle: string; url: string }[];
    alsoWorkedOn: { name: string; url: string }[];
    name: string;
  };
  const D: Data = JSON.parse(document.getElementById('shell-data')!.textContent!);
  const PS1 = 'ben@firshman.com:~$';
  const term = document.getElementById('term')!;
  const screen = document.getElementById('screen')!;
  const out = document.getElementById('out')!;
  const form = document.getElementById('prompt') as HTMLFormElement;
  const input = document.getElementById('cmd') as HTMLInputElement;
  const ps1El = document.getElementById('ps1')!;
  const chipColor = document.getElementById('chip-color')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const coarse = matchMedia('(pointer: coarse)').matches;

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  const host = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
  const link = (url: string, text = host(url)) => `<a href="${esc(url)}" target="_blank" rel="noopener">${esc(text)}</a>`;
  const run = (cmd: string, text = cmd) => `<button type="button" class="run" data-cmd="${esc(cmd)}">${esc(text)}</button>`;

  // ---------- filesystem-ish ----------
  const targets: Record<string, { name: string; url: string; blurb: string; tags?: string[]; era?: string }> = {};
  D.projects.forEach((p) => (targets[p.slug] = p));
  targets['replicate'] = { name: D.now.name, url: D.now.url, blurb: D.now.blurb, tags: ['now'], era: 'now' };
  const alsoSlug = (n: string) => n.toLowerCase().replace(/['’]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  D.alsoWorkedOn.forEach((a) => (targets[alsoSlug(a.name)] = { name: a.name, url: a.url, blurb: 'also worked on this', tags: ['also'] }));
  D.socials.forEach((s) => (targets[s.name.toLowerCase()] = { name: `${s.name} (${s.handle})`, url: s.url, blurb: 'social', tags: ['social'] }));
  const targetNames = Object.keys(targets);

  // ---------- helpers ----------
  function lev(a: string, b: string) {
    const m = a.length, n = b.length;
    const d = Array.from({ length: m + 1 }, (_, i) => [i, ...Array(n).fill(0)]);
    for (let j = 1; j <= n; j++) d[0][j] = j;
    for (let i = 1; i <= m; i++)
      for (let j = 1; j <= n; j++)
        d[i][j] = Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));
    return d[m][n];
  }
  function closest(word: string, pool: string[]) {
    let best = '', score = Infinity;
    for (const c of pool) {
      const s = c.startsWith(word) && word.length >= 2 ? 0.5 : lev(word, c);
      if (s < score) { score = s; best = c; }
    }
    return score <= Math.max(2, Math.floor(word.length / 3)) ? best : '';
  }
  function print(html: string, cls = '') {
    const div = document.createElement('div');
    div.className = 'block ' + cls;
    div.innerHTML = html;
    out.appendChild(div);
    return div;
  }
  function scrollDown() {
    screen.scrollTo({ top: screen.scrollHeight, behavior: reduced ? 'auto' : 'smooth' });
  }

  // ---------- commands ----------
  type Cmd = {
    usage: string;
    desc: string;
    help?: string;
    args?: () => string[];
    hidden?: boolean;
    run: (args: string[], raw: string) => string | void | Promise<string | void>;
  };

  const history: string[] = [];
  let pending: ((line: string) => void) | null = null;

  const cmds: Record<string, Cmd> = {
    help: {
      usage: 'help [command]',
      desc: 'list commands, or explain one',
      args: () => Object.keys(cmds).filter((k) => !cmds[k].hidden),
      run(args) {
        if (args[0]) return dispatch(`${args[0]} --help`, true);
        const rows = Object.entries(cmds)
          .filter(([, c]) => !c.hidden)
          .map(([k, c]) => `<span>${run(c.usage.startsWith(k + ' [') || c.usage === k ? k : exampleFor(k), c.usage)}</span><span class="dim">${esc(c.desc)}</span>`)
          .join('');
        return `<p>Commands (tap one, or type it):</p><div class="grid2" style="margin:.5em 0">${rows}</div>
          <p class="dim">Every command takes <span class="c-cmd">--help</span>. Tab completes. ↑/↓ for history. Ctrl+L clears.</p>`;
      },
    },
    whoami: {
      usage: 'whoami',
      desc: 'who is this, anyway',
      run: () => `<p><strong class="c-hi">${esc(D.name)}</strong></p><p>I'm working on ${link(D.now.url, D.now.name)}, ${esc(D.now.blurb)}.</p><p class="dim">More: ${run('man ben')} · ${run('ls projects')}</p>`,
    },
    ls: {
      usage: 'ls [projects|also|socials]',
      desc: 'list things Ben has made',
      help: 'With no argument, lists the top-level directories. -a shows hidden files.',
      args: () => ['projects', 'also', 'socials', '-a'],
      run(args) {
        const showAll = args.some((a) => /^-\w*a/.test(a));
        const what = args.filter((a) => !a.startsWith('-'))[0]?.replace(/\/$/, '');
        if (!what) {
          const items = [
            run('ls projects', 'projects/'),
            run('ls also', 'also/'),
            run('ls socials', 'socials/'),
            `<span class="c-cyan">replicate@</span> <span class="dim">→ ${link(D.now.url)}</span>`,
          ];
          if (showAll) items.unshift(run('cat .plan', '.plan'), '<span class="dim">.</span>', '<span class="dim">..</span>');
          return `<p style="display:flex;flex-wrap:wrap;gap:.2em 3ch">${items.map((i) => `<span>${i}</span>`).join('')}</p>`;
        }
        if (what === 'projects' || what === 'project') {
          return `<ul class="ls">${D.projects
            .map((p) => `<li><a class="slug" href="${esc(p.url)}" target="_blank" rel="noopener">${esc(p.slug)}</a><span class="blurb">${p.name.toLowerCase() !== p.slug ? `<b>${esc(p.name)}</b>, ` : ''}${esc(p.blurb)}</span></li>`)
            .join('')}</ul><p class="dim hint">Try ${run('cat ' + D.projects[0].slug)} or ${run('open ' + D.projects[4].slug)}.</p>`;
        }
        if (what === 'also') {
          return `<ul class="ls">${D.alsoWorkedOn
            .map((a) => `<li><a class="slug" href="${esc(a.url)}" target="_blank" rel="noopener">${esc(alsoSlug(a.name))}</a><span class="blurb">${esc(a.name)}</span></li>`)
            .join('')}</ul>`;
        }
        if (what === 'socials' || what === 'social') return cmds.contact.run([], '') as string;
        const s = closest(what, ['projects', 'also', 'socials']);
        throw new Error(`ls: cannot access '${what}': No such directory.${s ? ` Did you mean ${run('ls ' + s, s)}?` : ''}`);
      },
    },
    cat: {
      usage: 'cat <project>',
      desc: 'read about a project',
      args: () => targetNames,
      run(args) {
        const t = args[0];
        if (!t) throw new Error(`cat: missing project name. Try ${run('cat cog')}, or ${run('ls projects')} to see them all.`);
        if (t === '.plan') return `<p class="pre">Keep making tools that make other people's tools nicer.\nWrite the guidelines. Then, awkwardly, follow them.</p>`;
        if (t === '/etc/passwd') return `<p class="pre">ben:x:1000:1000:Ben Firshman:/home/ben:/bin/sh\n<span class="dim">(passwords sold separately)</span></p>`;
        const p = targets[t.replace(/\/$/, '')];
        if (!p) {
          const s = closest(t, targetNames);
          throw new Error(`cat: ${esc(t)}: No such project.${s ? ` Did you mean ${run('cat ' + s, s)}?` : ` See ${run('ls projects')}.`}`);
        }
        return `<div class="card"><p class="name">${esc(p.name)}</p><p>${esc(p.blurb[0].toUpperCase() + p.blurb.slice(1))}.</p>
          <p>${link(p.url)}</p>
          ${p.tags?.length ? `<p class="dim">tags: ${p.tags.map((x) => `<span class="tag">#${esc(x)}</span>`).join(' ')}${p.era ? ` · era: ${esc(p.era)}` : ''}</p>` : ''}</div>
          <p class="dim" style="margin-top:.3em">→ ${run('open ' + t)}</p>`;
      },
    },
    open: {
      usage: 'open <project>',
      desc: 'open a project in a new tab',
      args: () => targetNames,
      run(args) {
        const t = args[0];
        if (!t) throw new Error(`open: what should I open? Try ${run('open replicate')}.`);
        const p = targets[t];
        if (!p) {
          const s = closest(t, targetNames);
          throw new Error(`open: ${esc(t)}: No such project.${s ? ` Did you mean ${run('open ' + s, s)}?` : ''}`);
        }
        const w = window.open(p.url, '_blank', 'noopener');
        return `<p>Opening ${link(p.url)}…${w === null ? ' <span class="dim">(if nothing happened, your popup blocker won. Click the link.)</span>' : ''}</p>`;
      },
    },
    man: {
      usage: 'man <page>',
      desc: 'the manual (try: man ben)',
      args: () => ['ben', ...Object.keys(cmds)],
      run(args) {
        const page = args[0];
        if (!page) throw new Error(`What manual page do you want? Try ${run('man ben')}.`);
        if (page !== 'ben' && cmds[page]) return dispatch(`${page} --help`, true);
        if (page !== 'ben') throw new Error(`No manual entry for ${esc(page)}. ${run('man ben')} is the only one worth reading.`);
        const socials = D.socials.map((s) => link(s.url, `${s.name.toLowerCase()}(1)`)).join(', ');
        return `<div class="man">
          <p class="dim">BEN(1)${' '.repeat(6)}General Commands Manual${' '.repeat(6)}BEN(1)</p>
          <h4>NAME</h4><p class="ind">ben — ${esc(D.name)}, makes tools for developers</p>
          <h4>SYNOPSIS</h4><p class="ind">ben [--working-on <a href="${esc(D.now.url)}" target="_blank" rel="noopener">replicate</a>] [--previously <span class="c-cmd">PROJECT</span>…]</p>
          <h4>DESCRIPTION</h4>
          <p class="ind">Currently working on ${link(D.now.url, D.now.name)}, which lets you ${esc(D.now.blurb)}.</p>
          <p class="ind" style="margin-top:.6em">Previously responsible for ${D.projects.map((p) => link(p.url, p.name)).join(', ')}. Also worked on ${D.alsoWorkedOn.map((a) => link(a.url, a.name)).join(', ')}.</p>
          <h4>OPTIONS</h4>
          <div class="ind grid2"><span class="c-cmd">--email</span><span>${link('mailto:' + D.email, D.email)}</span>${D.socials.map((s) => `<span class="c-cmd">--${esc(s.name.toLowerCase())}</span><span>${link(s.url, s.handle)}</span>`).join('')}</div>
          <h4>BUGS</h4><p class="ind">Wrote a guide to command-line interfaces, and so must now get every one of these right. Report bugs to ${link('mailto:' + D.email, D.email)}.</p>
          <h4>SEE ALSO</h4><p class="ind">${link('https://clig.dev', 'clig(7)')}, ${socials}</p>
        </div>`;
      },
    },
    contact: {
      usage: 'contact',
      desc: 'email and socials',
      run: () =>
        `<div class="grid2"><span class="dim">email</span><span>${link('mailto:' + D.email, D.email)}</span>${D.socials
          .map((s) => `<span class="dim">${esc(s.name.toLowerCase())}</span><span>${link(s.url, s.handle)}</span>`)
          .join('')}</div>`,
    },
    history: {
      usage: 'history [-c]',
      desc: "what you've typed so far",
      args: () => ['-c'],
      run(args) {
        if (args[0] === '-c') { history.length = 0; return '<p class="dim">History cleared. It never happened.</p>'; }
        const h = history.slice(0, -1);
        if (!h.length) return '<p class="dim">Nothing yet. You just got here.</p>';
        return `<div class="grid2">${h.map((c, i) => `<span class="dim">${String(i + 1).padStart(4, ' ')}</span><span>${run(c)}</span>`).join('')}</div>`;
      },
    },
    color: {
      usage: 'color [on|off]',
      desc: 'toggle colour (we honour NO_COLOR)',
      help: 'clig.dev says: disable colour if NO_COLOR is set. Browsers have no environment variables, so this is the next best thing. `export NO_COLOR=1` works too.',
      args: () => ['on', 'off'],
      run(args) {
        const v = args[0];
        if (v && v !== 'on' && v !== 'off') throw new Error(`color: expected 'on' or 'off', got '${esc(v)}'. Try ${run('color off')}.`);
        const off = v ? v === 'off' : !document.documentElement.classList.contains('no-color');
        setColor(!off);
        return off ? '<p>Colour off. Calm, isn’t it.</p>' : '<p class="c-ok">Colour <span class="c-warn">back</span> <span class="c-mag">on</span><span class="c-cyan">.</span></p>';
      },
    },
    clear: { usage: 'clear', desc: 'clear the screen (or Ctrl+L)', run: () => { out.innerHTML = ''; } },
    echo: { usage: 'echo [text…]', desc: 'say something back', hidden: true, run: (_a, raw) => {
      const t = raw.replace(/^echo\s*/, '');
      if (/\$NO_COLOR/.test(t)) return `<p>${document.documentElement.classList.contains('no-color') ? '1' : ''}</p>`;
      if (/\$USER/.test(t)) return '<p>you</p>';
      return `<p>${esc(t)}</p>`;
    } },
    export: { usage: 'export NAME=value', desc: 'set an environment variable', hidden: true, run(args) {
      const a = args[0] || '';
      if (/^NO_COLOR=/.test(a)) { const on = a.split('=')[1] === ''; setColor(on); return on ? '<p class="dim">NO_COLOR unset.</p>' : '<p class="dim">NO_COLOR is set. Colour off, as the spec intends.</p>'; }
      if (!a.includes('=')) throw new Error(`export: usage: export NAME=value (try ${run('export NO_COLOR=1')})`);
      return '<p class="dim">Noted. (This shell forgets everything except NO_COLOR.)</p>';
    } },
    sudo: { usage: 'sudo <command>', desc: 'try it', hidden: true, run(args) {
      if (args.join(' ') === 'make me a sandwich') return '<p class="c-ok">Okay.</p><p class="dim">(with apologies to xkcd #149)</p>';
      if (!args.length) throw new Error('usage: sudo &lt;command&gt;');
      shake();
      return `<p>[sudo] password for you: <span class="dim">********</span></p><p class="c-err">you are not in the sudoers file. This incident will be reported.</p><p class="dim">(To nobody. We respect your privacy.)</p>`;
    } },
    rm: { usage: 'rm [-rf] <path>', desc: 'remove files', hidden: true, run(args) {
      const path = args.filter((a) => !a.startsWith('-'))[0];
      if (!path) throw new Error('rm: missing operand');
      if (path === '/' || path === '/*' || path === '~') {
        ask(`<p class="c-warn">⚠ This will delete firshman.com, ${D.projects.length} projects and a perfectly good afternoon.</p><p>clig.dev says to confirm before doing anything dangerous. Type <span class="c-hi">firshman.com</span> to confirm, anything else to abort:</p>`, (answer) => {
          if (answer.trim() !== 'firshman.com') { print('<p class="c-ok">Aborted. Nothing was deleted. Good instinct.</p>'); return; }
          rmrf();
        });
        return;
      }
      const s = closest(path, targetNames);
      throw new Error(`rm: cannot remove '${esc(path)}': Read-only file system.${s ? ` (${esc(s)} is load-bearing.)` : ''}`);
    } },
    cd: { usage: 'cd <dir>', desc: 'change directory', hidden: true, run(args) {
      if (['projects', 'also', 'socials'].includes((args[0] || '').replace(/\/$/, ''))) return `<p class="dim">It's a flat filesystem. Here's ${run('ls ' + args[0].replace(/\/$/, ''))} instead.</p>`;
      return '<p class="dim">There is only ~, and you are already in it.</p>';
    } },
    pwd: { usage: 'pwd', desc: 'print working directory', hidden: true, run: () => '<p>/home/ben</p>' },
    date: { usage: 'date', desc: 'print the date', hidden: true, run: () => `<p>${esc(new Date().toString())}</p>` },
    exit: { usage: 'exit', desc: 'leave', hidden: true, run: () => `<p>logout</p><p class="dim">There's no escape. Well, there's <a href="/ideas">← all ideas</a>.</p>` },
    docker: { usage: 'docker <command>', desc: 'containers', hidden: true, run: (args) => {
      if (args[0] === 'compose' || args[0] === 'run') return `<p>Wrong idea. You want <a href="/ideas/compose">/ideas/compose</a>.</p>`;
      return `<p class="dim">Cannot connect to the Docker daemon. Is the docker daemon running? (It's a web page.)</p>`;
    } },
    vim: { usage: 'vim', desc: 'editor', hidden: true, run: () => '<p class="dim">You would never get out. Saved you the trouble.</p>' },
    make: { usage: 'make <target>', desc: 'make things', hidden: true, run: (args) => {
      if (args.join(' ') === 'me a sandwich') throw new Error('What? Make it yourself.');
      throw new Error(`make: *** No rule to make target '${esc(args.join(' ') || 'all')}'.  Stop.`);
    } },
  };
  cmds.emacs = cmds.nano = cmds.vi = cmds.vim;
  cmds.logout = cmds.exit;
  cmds.mail = { ...cmds.contact, hidden: true };
  cmds.compose = { ...cmds.docker, hidden: true, run: () => cmds.docker.run(['compose'], '') };

  function exampleFor(k: string) {
    return ({ cat: 'cat cog', open: 'open jsnes', man: 'man ben', ls: 'ls projects', color: 'color', help: 'help' } as Record<string, string>)[k] || k;
  }

  function setColor(on: boolean) {
    document.documentElement.classList.toggle('no-color', !on);
    chipColor.dataset.cmd = on ? 'color off' : 'color on';
    chipColor.textContent = chipColor.dataset.cmd;
    try { localStorage.setItem('shell:nocolor', on ? '0' : '1'); } catch (e) {}
  }
  if (document.documentElement.classList.contains('no-color')) setColor(false);

  function shake() {
    term.classList.remove('shake'); void term.offsetWidth; term.classList.add('shake');
  }

  function ask(html: string, cb: (line: string) => void) {
    print(html);
    pending = cb;
    form.classList.add('confirm');
    ps1El.textContent = 'confirm>';
  }

  function rmrf() {
    const victims = [...D.projects.map((p) => `/projects/${p.slug}`), '/usr/share/opinions', '/home/ben/.plan', '/etc/hostname', '/'];
    const div = print('');
    let i = 0;
    input.disabled = true;
    const step = () => {
      if (i < victims.length) {
        div.insertAdjacentHTML('beforeend', `<p class="dim">removed '<span class="c-err">${esc(victims[i])}</span>'</p>`);
        i++; scrollDown();
        setTimeout(step, reduced ? 0 : 70);
        return;
      }
      term.classList.add('melt');
      setTimeout(() => {
        term.classList.remove('melt');
        out.innerHTML = '';
        print(`<p class="dim">firshman.com shell 1.0 (tty1)</p><p>&nbsp;</p><p>Good news: it's a static site. Everything has been restored from the CDN.</p><p class="dim">Type ${run('ls projects')} to check. They're all fine.</p>`);
        input.disabled = false; input.focus();
      }, reduced ? 0 : 1300);
    };
    step();
  }

  function tokenize(line: string) {
    return line.match(/"[^"]*"|'[^']*'|\S+/g)?.map((t) => t.replace(/^["']|["']$/g, '')) || [];
  }

  function dispatch(line: string, nested = false): string | void {
    const [name, ...args] = tokenize(line);
    if (!name) return;
    const c = cmds[name.toLowerCase()];
    if (!c) {
      if (targets[name]) return `<p class="c-err">sh: ${esc(name)}: command not found</p><p>That's a project, not a command. Did you mean ${run('cat ' + name)} or ${run('open ' + name)}?</p>`;
      const s = closest(name.toLowerCase(), Object.keys(cmds).filter((k) => !cmds[k].hidden || k === 'sudo'));
      throw new Error(`sh: ${esc(name)}: command not found.${s ? ` Did you mean ${run([s, ...args].join(' '), s)}?` : ` Try ${run('help')}.`}`);
    }
    if (args.includes('--help') || args.includes('-h')) {
      return `<p><span class="c-hi">Usage:</span> ${esc(c.usage)}</p><p>${esc(c.desc[0].toUpperCase() + c.desc.slice(1))}.</p>${c.help ? `<p class="dim" style="margin-top:.4em">${esc(c.help)}</p>` : ''}${
        c.args ? `<p class="dim" style="margin-top:.4em">Example: ${run(exampleFor(name))}</p>` : ''}`;
    }
    const bad = args.find((a) => a.startsWith('--'));
    if (bad && name !== 'echo') throw new Error(`${esc(name)}: unknown option '${esc(bad)}'. See ${run(name + ' --help')}.`);
    const r = c.run(args, line);
    return r as string | void;
  }

  function exec(line: string, echo = true) {
    if (pending) {
      const cb = pending; pending = null;
      form.classList.remove('confirm');
      ps1El.textContent = PS1;
      print(`<p class="cmdline"><span class="ps1">confirm&gt;</span> ${esc(line)}</p>`);
      cb(line);
      scrollDown();
      return;
    }
    if (echo) print(`<p class="cmdline"><span class="ps1">${PS1}</span> ${esc(line)}</p>`).style.marginBottom = '0';
    const trimmed = line.trim();
    if (trimmed) history.push(trimmed);
    try {
      const html = dispatch(trimmed);
      if (html) print(html);
      else if (echo) out.lastElementChild && ((out.lastElementChild as HTMLElement).style.marginBottom = '');
    } catch (e) {
      print(`<p class="c-err">${(e as Error).message}</p>`);
    }
    scrollDown();
  }

  // ---------- input ----------
  let hIndex = -1;
  let draft = '';
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const v = input.value;
    input.value = '';
    hIndex = -1;
    exec(v);
  });

  input.addEventListener('keydown', (e) => {
    if (e.key === 'Tab') {
      e.preventDefault();
      complete();
    } else if (e.key === 'ArrowUp') {
      if (!history.length) return;
      e.preventDefault();
      if (hIndex === -1) { draft = input.value; hIndex = history.length; }
      hIndex = Math.max(0, hIndex - 1);
      input.value = history[hIndex];
      requestAnimationFrame(() => input.setSelectionRange(input.value.length, input.value.length));
    } else if (e.key === 'ArrowDown') {
      if (hIndex === -1) return;
      e.preventDefault();
      hIndex++;
      if (hIndex >= history.length) { hIndex = -1; input.value = draft; } else input.value = history[hIndex];
    } else if (e.key === 'l' && e.ctrlKey) {
      e.preventDefault();
      out.innerHTML = '';
    } else if (e.key === 'c' && e.ctrlKey && !window.getSelection()?.toString()) {
      e.preventDefault();
      print(`<p class="cmdline"><span class="ps1">${esc(ps1El.textContent || PS1)}</span> ${esc(input.value)}^C</p>`);
      input.value = '';
      if (pending) { pending = null; form.classList.remove('confirm'); ps1El.textContent = PS1; print('<p class="c-ok">Aborted.</p>'); }
      scrollDown();
    }
  });

  function commonPrefix(xs: string[]) {
    let p = xs[0] || '';
    for (const x of xs) while (!x.startsWith(p)) p = p.slice(0, -1);
    return p;
  }

  function complete() {
    const v = input.value;
    const parts = v.split(/\s+/);
    let pool: string[];
    const word = parts[parts.length - 1];
    if (parts.length <= 1) pool = Object.keys(cmds).filter((k) => !cmds[k].hidden);
    else {
      const c = cmds[parts[0]];
      pool = c?.args ? c.args() : [];
    }
    const matches = pool.filter((x) => x.startsWith(word));
    if (!matches.length) { shake(); return; }
    const before = parts.slice(0, -1).join(' ');
    const fill = (w: string, done: boolean) => (input.value = (before ? before + ' ' : '') + w + (done ? ' ' : ''));
    if (matches.length === 1) fill(matches[0], true);
    else {
      const cp = commonPrefix(matches);
      if (cp.length > word.length) fill(cp, false);
      else {
        print(`<p class="cmdline"><span class="ps1">${PS1}</span> ${esc(v)}</p><p style="display:flex;flex-wrap:wrap;gap:0 3ch">${matches
          .map((m) => `<span>${run((before ? before + ' ' : '') + m, m)}</span>`)
          .join('')}</p>`);
        scrollDown();
      }
    }
  }

  // clickable commands anywhere
  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest('[data-cmd]') as HTMLElement | null;
    if (t) {
      e.preventDefault();
      const cmd = t.dataset.cmd!;
      if (pending && cmd !== 'clear') { pending = null; form.classList.remove('confirm'); ps1El.textContent = PS1; print('<p class="c-ok">Aborted.</p>'); }
      exec(cmd);
      if (!coarse) input.focus({ preventScroll: true });
      return;
    }
  });
  screen.addEventListener('mouseup', (e) => {
    if ((e.target as HTMLElement).closest('a,button')) return;
    if (window.getSelection()?.toString()) return;
    input.focus({ preventScroll: true });
  });

  if (!coarse) input.focus({ preventScroll: true });
</script>
