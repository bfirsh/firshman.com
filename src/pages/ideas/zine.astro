  /* ---------------- page 5 ---------------- */
  .p5 { display: flex; flex-direction: column; gap: 5%; }
  .also { background: #fff; padding: 1.2em 1.4em 1.4em; margin: 0 14% 0 3%; rotate: 1.5deg; }
  .also h2 { margin: 0 0 .4em; font: 400 1.8em/1 "Anton", sans-serif; text-transform: uppercase; }
  .also ul { margin: 0; padding: 0; list-style: none; font: 400 1.2em/1.5 "Special Elite", monospace; }
  .also li::before { content: "✗ "; color: var(--spot); }
  .also a { text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .also a:hover { background: var(--spot); }
  .tape.t4 { right: 8%; top: 8%; width: 24%; height: 4%; rotate: 28deg; }
  .letter-box {
    position: relative; padding: 1.4em 1.4em 1.2em; border: 3px dashed #111; background: #fff; rotate: -1deg;
  }
  .cut { position: absolute; left: 0; right: 0; top: -1.6em; margin: 0; font: 700 .75em/1 "Courier Prime", monospace; text-align: center; white-space: nowrap; overflow: hidden; }
  .letter-box h2 { margin: 0 0 .6em; padding-right: 3.6em; }
  .field { margin: .5em 0 0; font: 400 1.15em/1.35 "Special Elite", monospace; }
  .field span { font: 700 .75em/1 "Courier Prime", monospace; text-transform: uppercase; letter-spacing: .1em; margin-right: .4em; }
  .field a { font-weight: 700; text-decoration-color: var(--spot); text-decoration-thickness: 3px; text-underline-offset: 3px; overflow-wrap: anywhere; }
  .field a:hover { background: var(--spot); }
  .field.lines { height: 3.4em; background: repeating-linear-gradient(transparent 0 1.6em, #111 1.6em calc(1.6em + 1px)); }
  .stamp {
    position: absolute; right: 1em; top: 1em; width: 3.6em; height: 4.2em; display: grid; place-items: center; text-align: center;
    font: 400 .8em/1.1 "Anton", sans-serif; text-transform: uppercase; color: #111; background: var(--spot);
    outline: 3px dotted var(--spot); outline-offset: 2px; rotate: 6deg;
  }
  .colophon { margin: auto 0 0; font: 400 .85em/1.4 "Courier Prime", monospace; text-align: center; opacity: .8; }

  /* ---------------- phone: one page at a time ---------------- */
  @media (max-width: 900px) {
    .zine { gap: 36px; padding-top: 56px; }
    .spread { grid-template-columns: minmax(0, 1fr); gap: 36px; filter: none; width: 100%; max-width: 560px; }
    .page { aspect-ratio: auto; min-height: 0; padding: 32px 22px 44px; font-size: 15px; box-shadow: 0 14px 24px rgba(0,0,0,.45) !important; }
    .spread .page:nth-child(odd) { rotate: -.6deg; }
    .spread .page:nth-child(even) { rotate: .7deg; }
    .cover .ransom { font-size: clamp(36px, 10.6vw, 84px); }
    .ransom.small { font-size: 60px; }
    .ransom.tiny { font-size: 30px; }
    .cover { gap: 0; }
    .photo { width: 66%; margin-top: 28px; }
    .inside { margin-top: 40px; }
    .this-guy { font-size: 28px; }
    .arrow-guy { width: 24%; }
    .circle-now { display: none; }
    .go-look { position: relative; right: auto; top: auto; align-self: flex-end; margin: -8px 4px 0 0; }
    .p2 { gap: 22px; }
    .now-clip { margin: 0 2% 0 4%; }
    .now-name { font-size: 3.6em; }
    .ransom.tiny { font-size: 26px; }
    .fact { margin: 8px 12% 0 0; }
    .tape.t3 { display: none; }
    .clips { grid-template-columns: 1fr; gap: 18px; }
    .p3 .clipping:nth-child(n), .p4 .clipping:nth-child(n) { grid-column: auto; margin: 0; }
    .clipping:nth-child(odd) { margin-right: 8% !important; }
    .clipping:nth-child(even) { margin-left: 8% !important; }
    .star-doodle { width: 56px; bottom: 10px; }
    .up { position: relative; right: auto; bottom: auto; margin: 18px 0 6px; text-align: right; }
    .p5 { gap: 40px; }
    .also { margin: 0 6% 0 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .js .doodle path { transition: none; stroke-dashoffset: 0; }
    .clipping { transition: none; }
  }
</style>

<script>
  /* Halftone the cover photo: sample brightness on a grid, draw dots. */
  function halftone() {
    const fig = document.querySelector('.photo') as HTMLElement;
    const img = fig.querySelector('img') as HTMLImageElement;
    const cv = fig.querySelector('canvas') as HTMLCanvasElement;
    const run = () => {
      const size = (fig.querySelector('.photo-inner') as HTMLElement).getBoundingClientRect().width;
      if (!size) return;
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      cv.width = cv.height = Math.round(size * dpr);
      const ctx = cv.getContext('2d')!;
      const cell = Math.max(4, size / 64) * dpr;
      const n = Math.ceil(cv.width / cell) + 2;
      const sample = document.createElement('canvas');
      sample.width = sample.height = n;
      const sctx = sample.getContext('2d', { willReadFrequently: true })!;
      sctx.drawImage(img, 0, 0, n, n);
      let data: Uint8ClampedArray;
      try { data = sctx.getImageData(0, 0, n, n).data; } catch { return; }
      ctx.fillStyle = '#fff';
      ctx.fillRect(0, 0, cv.width, cv.height);
      ctx.fillStyle = '#111';
      // rotate the screen 45° like a real halftone
      ctx.save();
      ctx.translate(cv.width / 2, cv.height / 2);
      ctx.rotate(Math.PI / 4);
      const span = cv.width * 0.75;
      for (let gy = -span; gy <= span; gy += cell) {
        for (let gx = -span; gx <= span; gx += cell) {
          // map back to image space
          const ix = (gx - gy) * Math.SQRT1_2 + cv.width / 2;
          const iy = (gx + gy) * Math.SQRT1_2 + cv.height / 2;
          if (ix < 0 || iy < 0 || ix >= cv.width || iy >= cv.height) continue;
          const sx = Math.min(n - 1, Math.floor((ix / cv.width) * n));
          const sy = Math.min(n - 1, Math.floor((iy / cv.height) * n));
          const k = (sy * n + sx) * 4;
          let lum = (0.299 * data[k] + 0.587 * data[k + 1] + 0.114 * data[k + 2]) / 255;
          lum = Math.min(1, Math.max(0, (lum - 0.5) * 1.6 + 0.58));
          const r = (cell / 2) * Math.sqrt(1 - lum) * 1.35;
          if (r < 0.35) continue;
          ctx.beginPath();
          ctx.arc(gx, gy, r, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      ctx.restore();
      document.documentElement.classList.add('has-halftone');
    };
    if (img.complete && img.naturalWidth) run(); else img.addEventListener('load', run, { once: true });
    let t: number | undefined;
    addEventListener('resize', () => { clearTimeout(t); t = window.setTimeout(run, 150); });
  }
  halftone();

  /* Scrawls draw themselves in when they come into view. */
  const doodles = document.querySelectorAll('.doodle');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('drawn'); io.unobserve(e.target); } });
    }, { threshold: 0.4 });
    doodles.forEach((d) => io.observe(d));
  } else doodles.forEach((d) => d.classList.add('drawn'));
</script>
